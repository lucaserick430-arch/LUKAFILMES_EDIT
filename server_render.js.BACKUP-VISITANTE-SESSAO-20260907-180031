        const novaValidade =
            new Date(
                inicio +
                dias *
                24 *
                60 *
                60 *
                1000
            ).toISOString();

        usuarios[indice].validade = novaValidade;
        usuarios[indice].status = "ativo";

        await salvarUsuarios(usuarios);

        return res.json({
            sucesso: true,
            mensagem: "Usuário renovado com sucesso.",
            validade: novaValidade
        });

