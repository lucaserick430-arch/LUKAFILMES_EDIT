        const indice =
            usuarios.findIndex(
                u =>
                    Number(u.id) === id &&
                    Number(u.revendedor_id) === revendedorId
            );

        if (indice === -1) {
            return res.status(404).json({
                sucesso: false,
                mensagem: "Cliente não encontrado."
            });
