class NetlifyBlobSessionStore extends session.Store {

    constructor() {
        super();

        this.store = getStore({
            name: "lukafilmes-sessoes",
            siteID: process.env.NETLIFY_SITE_ID,
            token: process.env.NETLIFY_AUTH_TOKEN
        });
    }

    async get(sid, callback) {

        try {

            const dados = await this.store.get(
                `sess_${sid}`,
                {
                    type: "json"
                }
            );

            if (!dados) {
                return callback(null, null);
            }

            if (
                dados.cookie &&
                dados.cookie.expires &&
                new Date(dados.cookie.expires) < new Date()
            ) {

                await this.store.delete(`sess_${sid}`);

                return callback(null, null);
            }

            callback(null, dados);

        } catch (erro) {

            callback(erro);

        }

    }

    async set(sid, sess, callback) {

        try {

            await this.store.setJSON(
                `sess_${sid}`,
                sess
            );

            callback(null);

        } catch (erro) {

            callback(erro);

        }

    }

    async destroy(sid, callback) {

        try {

            await this.store.delete(`sess_${sid}`);

            callback(null);

        } catch (erro) {

            callback(erro);

        }

    }

    async touch(sid, sess, callback) {

        try {

            await this.store.setJSON(
                `sess_${sid}`,
                sess
            );

            callback(null);

        } catch (erro) {

            callback(erro);

        }

    }

}

