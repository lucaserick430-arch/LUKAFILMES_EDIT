        const usuario = usuarios[indice];

        let inicio = Date.now();

        if (usuario.validade) {

            const validadeAtual =
                new Date(usuario.validade).getTime();

            if (
                Number.isFinite(validadeAtual) &&
                validadeAtual > Date.now()
            ) {
                inicio = validadeAtual;
            }
