        ) {
            return res.status(403).json({
                sucesso: false,
                mensagem: "Acesso negado."
            });
        }

        const revendedorId =
            Number(req.session.usuario.id);

        const id =
            Number(req.body.id);

        const dias =
            Number(req.body.dias);

        if (
            !Number.isInteger(id) ||
            id < 1 ||
            !Number.isInteger(dias) ||
            dias < 1
        ) {
            return res.status(400).json({
                sucesso: false,
                mensagem: "Informe uma quantidade válida de dias."
            });
        }

        const usuarios =
            await carregarUsuarios();

        const indice =
            usuarios.findIndex(
                u =>
                    Number(u.id) === id &&
                    Number(u.revendedor_id) === revendedorId
            );

        if (indice === -1) {
            return res.status(404).json({
                sucesso: false,
                mensagem: "Cliente não encontrado."
            });
        }

        const atual =
            usuarios[indice].validade
                ? new Date(usuarios[indice].validade)
                : new Date();

        const agora = new Date();

        const inicio =
            atual > agora
                ? atual
                : agora;

        usuarios[indice].validade =
            new Date(
                inicio.getTime() +
                dias * 24 * 60 * 60 * 1000
            ).toISOString();

        usuarios[indice].status = "ativo";

        await salvarUsuarios(usuarios);

        console.log(
            "[REVENDEDOR] Cliente renovado:",
            usuarios[indice].usuario,
            dias,
            "dias"
        );

