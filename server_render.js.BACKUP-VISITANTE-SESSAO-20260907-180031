            String(req.body.senha || "");

        if (!Number.isInteger(id) || id < 1) {
            return res.status(400).json({
                sucesso: false,
                mensagem: "ID inválido."
            });
        }

        if (!usuario) {
            return res.status(400).json({
                sucesso: false,
                mensagem: "Informe o usuário."
            });
