      <button class="btn secondary" onclick="fecharClienteModal()">✕</button>
    </div>

    <form id="formClienteRevendedor">
      <input type="hidden" id="clienteRevendedorId">

      <div class="field">
        <label>Usuário</label>
        <input id="clienteRevendedorUsuario" required autocomplete="off">
      </div>

      <div class="field">
        <label>Senha</label>
        <input id="clienteRevendedorSenha" type="text" autocomplete="off">
      </div>

      <div class="field" id="campoDiasCliente">
        <label>Validade em dias</label>
        <input id="clienteRevendedorDias" type="number" min="1" value="30">
      </div>

      <button class="btn primary" style="width:100%">
        SALVAR CLIENTE
      </button>

      <div id="msgClienteRevendedor" class="msg"></div>
    </form>
  </div>
