<script>
/* ===== LUKA-REVENDEDOR-CLIENTES-V1 ===== */

let clientesRevendedor = [];
let modoCliente = "criar";

async function apiRevendedor(url, options = {}) {
  const resposta = await fetch(url, {
    credentials: "include",
    headers: {
      "Content-Type": "application/json",
      ...(options.headers || {})
    },
    ...options
  });

  let dados = {};
  try { dados = await resposta.json(); } catch (_) {}

  if (!resposta.ok) {
    throw new Error(dados.mensagem || ("Erro HTTP " + resposta.status));
  }

  if (dados.sucesso === false) {
    throw new Error(dados.mensagem || "Operação não realizada.");
  }

  return dados;
}

function mostrarPainelRevendedor() {
  const painel = document.getElementById("painelRevendedorClientes");
  if (painel) painel.style.display = "";
}

async function carregarPainelRevendedor() {
  try {
    mostrarPainelRevendedor();

    const [eu, dados] = await Promise.all([
      apiRevendedor("/api/revendedor/eu"),
      apiRevendedor("/api/revendedor/clientes")
    ]);

    const usuario = eu.usuario || {};
    clientesRevendedor = Array.isArray(dados.clientes)
      ? dados.clientes
      : [];

    const limite = Number(dados.limite || usuario.limite_conexoes || 0);
    const total = clientesRevendedor.length;
    const ativos = clientesRevendedor.filter(
      c => String(c.status).toLowerCase() === "ativo"
    ).length;
    const online = clientesRevendedor.filter(c => c.online).length;

    const set = (id, valor) => {
      const el = document.getElementById(id);
      if (el) el.textContent = valor;
    };

    set("revClientesTotal", total);
    set("revClientesAtivos", ativos);
    set("revClientesOnline", online);
    set("revClientesLimite", total + "/" + limite);

    const info = document.getElementById("revInfo");
    if (info) {
      info.textContent =
        "Revendedor: " + (usuario.usuario || "—") +
        " • Limite: " + limite;
    }

    renderizarClientesRevendedor();

  } catch (erro) {
    console.error("[REVENDEDOR]", erro);
    const lista = document.getElementById("listaClientesRevendedor");
    if (lista) {
      lista.innerHTML =
        '<tr><td colspan="5" class="empty" style="color:#f87171">' +
        escapeHtml(erro.message) +
        "</td></tr>";
    }
  }
}

function renderizarClientesRevendedor() {
  const tbody = document.getElementById("listaClientesRevendedor");
  if (!tbody) return;

  if (!clientesRevendedor.length) {
    tbody.innerHTML =
      '<tr><td colspan="5" class="empty">Nenhum cliente cadastrado.</td></tr>';
    return;
  }

  tbody.innerHTML = clientesRevendedor.map(c => {
    const ativo = String(c.status).toLowerCase() === "ativo";

    return `
      <tr>
        <td>
          <strong>${escapeHtml(c.usuario || "—")}</strong>
        </td>

        <td>
          <span class="badge ${ativo ? "b-ativo" : "b-suspenso"}">
            ${ativo ? "Ativo" : "Suspenso"}
          </span>
        </td>

        <td>
          <span class="${c.online ? "online-dot" : "offline-dot"}">
            ${c.online ? "● Online" : "● Offline"}
          </span>
        </td>

        <td>${formatarData(c.validade)}</td>

        <td>
          <div class="actions">
            <button class="btn secondary"
              onclick="editarClienteRevendedor(${Number(c.id)})">
              Editar
            </button>

            <button class="btn secondary"
              onclick="alternarClienteRevendedor(${Number(c.id)})">
              ${ativo ? "Suspender" : "Ativar"}
            </button>

            <button class="btn secondary"
              onclick="renovarClienteRevendedor(${Number(c.id)})">
              Renovar
            </button>

            <button class="btn secondary"
              onclick="excluirClienteRevendedor(${Number(c.id)})">
              Excluir
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join("");
}

function abrirCriarCliente() {
  modoCliente = "criar";

  document.getElementById("tituloClienteRevendedor").textContent =
    "Novo cliente";

  document.getElementById("clienteRevendedorId").value = "";
  document.getElementById("clienteRevendedorUsuario").value = "";
  document.getElementById("clienteRevendedorSenha").value = "";
  document.getElementById("clienteRevendedorDias").value = "30";

  const campo = document.getElementById("campoDiasCliente");
  if (campo) campo.style.display = "";

  const modal = document.getElementById("modalClienteRevendedor");
  if (modal) modal.style.display = "flex";
}

function fecharClienteModal() {
  const modal = document.getElementById("modalClienteRevendedor");
  if (modal) modal.style.display = "none";
}

function editarClienteRevendedor(id) {
  const cliente = clientesRevendedor.find(
    c => Number(c.id) === Number(id)
  );

  if (!cliente) {
    alert("Cliente não encontrado.");
    return;
  }

  modoCliente = "editar";

  document.getElementById("tituloClienteRevendedor").textContent =
    "Editar cliente";

  document.getElementById("clienteRevendedorId").value = cliente.id;
  document.getElementById("clienteRevendedorUsuario").value =
    cliente.usuario || "";
  document.getElementById("clienteRevendedorSenha").value = "";

  const campo = document.getElementById("campoDiasCliente");
  if (campo) campo.style.display = "none";

  const modal = document.getElementById("modalClienteRevendedor");
  if (modal) modal.style.display = "flex";
}

document.getElementById("formClienteRevendedor")
  ?.addEventListener("submit", async function(event) {
    event.preventDefault();

    const usuario =
      document.getElementById("clienteRevendedorUsuario").value.trim();

    const senha =
      document.getElementById("clienteRevendedorSenha").value;

    const id =
      Number(document.getElementById("clienteRevendedorId").value);

    try {
      let resposta;

      if (modoCliente === "editar") {
        resposta = await apiRevendedor(
          "/api/revendedor/clientes/editar",
          {
            method: "POST",
            body: JSON.stringify({
              id,
              usuario,
              senha
            })
          }
        );
      } else {
        const dias =
          Number(document.getElementById("clienteRevendedorDias").value);

        resposta = await apiRevendedor(
          "/api/revendedor/clientes",
          {
            method: "POST",
            body: JSON.stringify({
              usuario,
              senha,
              dias
            })
          }
        );
      }

      alert(resposta.mensagem || "Operação realizada.");
      fecharClienteModal();
      await carregarPainelRevendedor();

    } catch (erro) {
      alert(erro.message);
    }
  });

async function alternarClienteRevendedor(id) {
  const cliente = clientesRevendedor.find(
    c => Number(c.id) === Number(id)
  );

  if (!cliente) return;

  const atual =
    String(cliente.status).toLowerCase() === "ativo";

  if (!confirm(
    (atual ? "Suspender " : "Ativar ") +
    cliente.usuario +
    "?"
  )) return;

  try {
    const resposta = await apiRevendedor(
      "/api/revendedor/clientes/status",
      {
        method: "POST",
        body: JSON.stringify({
          id: Number(id),
          status: atual ? "suspenso" : "ativo"
        })
      }
    );

    alert(resposta.mensagem || "Status atualizado.");
    await carregarPainelRevendedor();

  } catch (erro) {
    alert(erro.message);
  }
}

async function renovarClienteRevendedor(id) {
  const dias = prompt(
    "Quantos dias deseja adicionar?",
    "30"
  );

  if (dias === null) return;

  const numero = Number(dias);

  if (!Number.isInteger(numero) || numero < 1) {
    alert("Informe uma quantidade válida.");
    return;
  }

  try {
    const resposta = await apiRevendedor(
      "/api/revendedor/clientes/renovar",
      {
        method: "POST",
        body: JSON.stringify({
          id: Number(id),
          dias: numero
        })
      }
    );

    alert(resposta.mensagem || "Cliente renovado.");
    await carregarPainelRevendedor();

  } catch (erro) {
    alert(erro.message);
  }
}

async function excluirClienteRevendedor(id) {
  const cliente = clientesRevendedor.find(
    c => Number(c.id) === Number(id)
  );

  if (!cliente) return;

  if (!confirm(
    'Excluir definitivamente "' +
    cliente.usuario +
    '"?'
  )) return;

  try {
    const resposta = await apiRevendedor(
      "/api/revendedor/clientes/excluir",
      {
        method: "POST",
        body: JSON.stringify({
          id: Number(id)
        })
      }
    );

    alert(resposta.mensagem || "Cliente excluído.");
    await carregarPainelRevendedor();

  } catch (erro) {
    alert(erro.message);
  }
}
</script>

