<style>
*{box-sizing:border-box}
:root{
 --bg:#07070d;--panel:#101018;--panel2:#151521;
 --border:rgba(255,255,255,.08);--text:#f7f7fb;
 --muted:#858594;--red:#ff3158;--purple:#8b5cf6;
 --green:#22c55e;--blue:#38bdf8;--yellow:#facc15
}
body{
 margin:0;background:
 radial-gradient(circle at 15% 0%,#28102a 0,transparent 32%),
 radial-gradient(circle at 90% 10%,#101d3b 0,transparent 30%),var(--bg);
 color:var(--text);font-family:Inter,Arial,sans-serif
}
button{font:inherit;cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{
 width:250px;position:fixed;inset:0 auto 0 0;padding:22px 15px;
 background:rgba(10,10,17,.82);backdrop-filter:blur(24px);
 border-right:1px solid var(--border);z-index:20
}
.brand{font-size:22px;font-weight:900;padding:10px 12px 28px}
.brand b{color:var(--red)}
.nav{display:grid;gap:7px}
.nav button{
 border:0;background:transparent;color:#a7a7b5;text-align:left;
 padding:13px 14px;border-radius:12px;font-weight:700
}
.nav button:hover,.nav .active{background:rgba(255,49,88,.12);color:white}
.main{margin-left:250px;width:calc(100% - 250px);padding:25px}
.topbar{
 display:flex;justify-content:space-between;align-items:center;
 gap:15px;margin-bottom:25px
}
.title h1{margin:0;font-size:28px}
.title p{margin:6px 0 0;color:var(--muted)}
.live{
 display:flex;align-items:center;gap:8px;padding:9px 13px;
 border:1px solid rgba(34,197,94,.2);border-radius:999px;
 color:#86efac;background:rgba(34,197,94,.07);font-size:13px
}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.card{
 padding:20px;border:1px solid var(--border);border-radius:18px;
 background:linear-gradient(145deg,rgba(25,25,37,.92),rgba(12,12,19,.88));
 box-shadow:0 20px 50px rgba(0,0,0,.2)
}
.label{font-size:12px;color:var(--muted);font-weight:800;text-transform:uppercase}
.value{font-size:30px;font-weight:900;margin-top:9px}
.icon{
 width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
 margin-bottom:16px;background:rgba(139,92,246,.15);color:#c4b5fd
}
.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:18px;margin-top:18px}
.panel{
 border:1px solid var(--border);border-radius:20px;
 background:rgba(15,15,23,.88);padding:20px
}
.panel h2{font-size:17px;margin:0 0 18px}
.chart{
 height:240px;border-radius:14px;
 background:linear-gradient(180deg,rgba(139,92,246,.10),transparent);
 display:flex;align-items:flex-end;gap:10px;padding:20px
}
.bar{flex:1;border-radius:8px 8px 2px 2px;background:linear-gradient(#ff3158,#8b5cf6);min-height:30px}
.quick{display:grid;gap:10px}
.quick button{
 border:1px solid var(--border);background:#181823;color:white;
 padding:14px;border-radius:12px;text-align:left;font-weight:800
}
.quick button:hover{border-color:rgba(255,49,88,.4);transform:translateY(-1px)}
@media(max-width:900px){
 .sidebar{width:75px;padding:15px 9px}
 .brand{font-size:0;text-align:center}
 .brand b{font-size:20px}
 .nav button{font-size:0;text-align:center}
 .nav button:first-letter{font-size:20px}
 .main{margin-left:75px;width:calc(100% - 75px)}
 .cards{grid-template-columns:repeat(2,1fr)}
 .grid{grid-template-columns:1fr}
}
@media(max-width:560px){
 .main{padding:15px}
 .topbar{align-items:flex-start}
 .title h1{font-size:22px}
 .cards{gap:10px}
 .card{padding:15px}
 .value{font-size:24px}
}

