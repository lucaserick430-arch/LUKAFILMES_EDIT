<script>
function abrirRevendedor() {
    const m = document.getElementById("modalRevendedor");
    if (m) m.style.display = "flex";
}

function fecharRevendedor() {
    const m = document.getElementById("modalRevendedor");
    if (m) m.style.display = "none";
}

async function criarRevendedor(event) {
    event.preventDefault();

    const msg = document.getElementById("revMsg");

    const dados = {
        usuario: document.getElementById("revUsuario").value.trim(),
        senha: document.getElementById("revSenha").value,
        dias: Number(document.getElementById("revDias").value),
        limite_conexoes: Number(document.getElementById("revLimite").value)
    };

    try {
        const resposta = await fetch("/api/admin/revendedores", {
            method: "POST",
            credentials: "include",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(dados)
        });

        const resultado = await resposta.json();

        if (!resposta.ok || resultado.sucesso === false) {
            throw new Error(
                resultado.mensagem || "Não foi possível criar o revendedor."
            );
        }

        if (msg) {
            msg.className = "msg ok";
            msg.textContent =
                resultado.mensagem || "Revendedor criado com sucesso.";
        }

        document.getElementById("formRevendedor").reset();

        setTimeout(() => {
            fecharRevendedor();
            carregarRevendedoresAdmin();
            carregarDashboard();
        }, 800);

    } catch (erro) {
        if (msg) {
            msg.className = "msg err";
            msg.textContent = erro.message;
        }
    }
}

document.addEventListener("DOMContentLoaded", () => {
    const botao = document.getElementById("btnNovoRevendedor");
    if (botao) botao.onclick = abrirRevendedor;

    const form = document.getElementById("formRevendedor");
    if (form) form.onsubmit = criarRevendedor;
});
</script>


