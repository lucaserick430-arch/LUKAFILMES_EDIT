<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>LUKA FILMES • Administração</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
 --bg:#070a12;
 --card:#0f1420;
 --card2:#151b29;
 --line:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --green:#a855f7;
 --blue:#7c3aed;
 --purple:#9333ea;
 --red:#e11d48;
 --orange:#c026d3;
}
body{
 font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;
 background:radial-gradient(circle at top,#24102b 0,#0a080d 42%,#050507 100%);
 color:var(--text);
 min-height:100vh;
}
header{
 position:sticky;
 top:0;
 z-index:20;
 background:rgba(7,10,18,.86);
 backdrop-filter:blur(18px);
 border-bottom:1px solid var(--line);
 padding:15px;
}
.top{
 max-width:1250px;
 margin:auto;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
}
.logo{margin-bottom:2px;
 font-size:20px;
 font-weight:900;
 letter-spacing:.5px;
}
.logo span{color:#8b5cf6}
@keyframes lukaPulse{
 0%,100%{
   opacity:1;
   transform:scale(1);
   background:#e11d48;
   box-shadow:0 0 7px #e11d48,0 0 14px rgba(225,29,72,.45);
 }
 50%{
   opacity:.25;
   transform:scale(.85);
   background:#9333ea;
   box-shadow:0 0 5px #9333ea;
 }
}
.sub{font-size:11px;color:var(--muted);margin-top:8px;line-height:16px}
@keyframes pulseDot{
  0%,100%{transform:scale(1);opacity:1;box-shadow:0 0 7px #e11d48}
  50%{transform:scale(1.55);opacity:.55;box-shadow:0 0 20px #e11d48}
}
.logo-btn{
  display:inline-block;
  color:white;
  text-decoration:none;
  cursor:pointer;
  transition:.2s;
}
.logo-btn:hover{
  transform:scale(1.03);
  text-shadow:0 0 18px rgba(168,85,247,.7);
}
.dot{
 width:9px;
 height:9px;
 border-radius:50%;
 display:inline-block;
 margin-right:6px;
 background:#e11d48;
 box-shadow:0 0 8px #e11d48;
 animation:lukaPulse 1.6s ease-in-out infinite;
}
 width:9px;height:9px;border-radius:50%;
 background:#e11d48;
 display:inline-block;
 box-shadow:0 0 12px var(--green);
 margin-right:6px;
}
.container{max-width:1250px;margin:auto;padding:18px 14px 40px}
.grid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
}
.card{
 background:linear-gradient(145deg,rgba(21,27,41,.96),rgba(11,15,25,.96));
 border:1px solid var(--line);
 border-radius:18px;
 padding:17px;
 box-shadow:0 15px 45px rgba(0,0,0,.2);
}
.stat-label{font-size:12px;color:var(--muted)}
.stat-value{font-size:29px;font-weight:900;margin-top:7px}
.stat-green{color:#4ade80}
.stat-blue{color:#60a5fa}
.stat-purple{color:#a78bfa}
.stat-orange{color:#fbbf24}

.actions{
 margin-top:15px;
 display:flex;
 gap:9px;
 flex-wrap:wrap;
}
button{
 border:0;
 border-radius:11px;
 padding:11px 14px;
 color:white;
 font-weight:800;
 cursor:pointer;
 background:linear-gradient(135deg,#7e22ce,#e11d48);
}
button:hover{filter:brightness(1.12)}
.btn-blue{background:var(--blue)}
.btn-green{background:#16a34a}
.btn-red{background:var(--red)}
.btn-dark{background:#202938}
.btn-orange{background:#d97706}

.panel{
 margin-top:15px;
 padding:15px;
 background:rgba(15,20,32,.9);
 border:1px solid var(--line);
 border-radius:18px;
}
.panel-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 margin-bottom:14px;
}
.panel-title h2{font-size:17px}
.search{
 width:100%;
 max-width:380px;
 background:#080c15;
 color:white;
 border:1px solid var(--line);
 border-radius:11px;
 padding:11px 13px;
 outline:none;
}
.filters{
 display:flex;
 gap:7px;
 overflow:auto;
 padding-bottom:4px;
 margin-bottom:13px;
}
.filters button{white-space:nowrap}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{
 padding:13px 10px;
 border-bottom:1px solid var(--line);
 text-align:left;
 font-size:13px;
}
th{color:var(--muted);font-size:11px;text-transform:uppercase}
.badge{
 display:inline-flex;
 padding:5px 8px;
 border-radius:8px;
 font-size:10px;
 font-weight:900;
 background:#263044;
}
.online{color:#d946ef;font-weight:900}
.offline{color:#64748b}
.status-ativo{color:#4ade80}
.status-suspenso{color:#f87171}
.row-actions{display:flex;gap:5px;flex-wrap:wrap}
.row-actions button{padding:7px 9px;font-size:10px}

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.72);
 backdrop-filter:blur(8px);
 display:none;
 align-items:center;
 justify-content:center;
 z-index:100;
 padding:15px;
}
.modal.show{display:flex}
.modal-box{
 width:100%;
 max-width:480px;
 background:#101624;
 border:1px solid var(--line);
 border-radius:20px;
 padding:20px;
 box-shadow:0 30px 90px rgba(0,0,0,.5);
}
.modal-box h2{margin-bottom:15px}
label{
 display:block;
 color:var(--muted);
 font-size:12px;
 font-weight:700;
 margin:11px 0 5px;
}
input,select{
 width:100%;
 padding:12px;
 border-radius:11px;
 border:1px solid var(--line);
 background:#080c15;
 color:white;
 outline:none;
}
.modal-actions{
 display:flex;
 gap:8px;
 margin-top:17px;
}
.modal-actions button{flex:1}
.toast{
 position:fixed;
 right:15px;
 bottom:15px;
 z-index:200;
 background:#101827;
 border:1px solid rgba(139,92,246,.45);
 border-radius:13px;
 padding:13px 15px;
 display:none;
 box-shadow:0 15px 40px rgba(0,0,0,.4);
}
.toast.show{display:block}
.empty{
 text-align:center;
 padding:35px 10px;
 color:var(--muted);
}
@media(max-width:850px){
 .grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
 .grid{grid-template-columns:repeat(2,1fr);gap:8px}
 .card{padding:13px;border-radius:15px}
 .stat-value{font-size:23px}
 .top{align-items:flex-start}
 .actions button{flex:1}
 .panel-title{align-items:stretch;flex-direction:column}
}
</style>
</head>

<body>

<header>
 <div class="top">
  <div>
   <a href="/" class="logo logo-btn">LUKA <span>FILMES</span></a>
   <div class="sub"><span class="dot"></span>Painel Administrativo</div>
  </div>
  <button class="btn-dark" onclick="carregar()">↻ Atualizar</button>
 </div>
</header>

<main class="container">

 <section class="grid">
  <div class="card">
   <div class="stat-label">TOTAL</div>
   <div id="total" class="stat-value">0</div>
  </div>
  <div class="card">
   <div class="stat-label">ONLINE</div>
   <div id="online" class="stat-value stat-green">0</div>
  </div>
  <div class="card">
   <div class="stat-label">TESTES</div>
   <div id="testes" class="stat-value stat-blue">0</div>
  </div>
  <div class="card">
   <div class="stat-label">REVENDEDORES</div>
   <div id="revendedores" class="stat-value stat-purple">0</div>
  </div>
 </section>

 <div class="actions">
  <button onclick="abrirCriar('usuario')">＋ Criar usuário</button>
  <button class="btn-blue" onclick="abrirCriar('teste')">🧪 Criar teste</button>
  <button class="btn-orange" onclick="abrirCriar('revendedor')">🤝 Criar revendedor</button>
 </div>

 <section class="panel">
  <div class="panel-title">
   <h2>Gerenciamento de acessos</h2>
   <input id="busca" class="search" placeholder="🔎 Pesquisar usuário..." oninput="render()">
  </div>

  <div class="filters">
   <button class="btn-dark" onclick="filtro='todos';render()">Todos</button>
   <button class="btn-blue" onclick="filtro='usuario';render()">Usuários</button>
   <button class="btn-dark" onclick="filtro='teste';render()">Testes</button>
   <button class="btn-orange" onclick="filtro='revendedor';render()">Revendedores</button>
   <button class="btn-green" onclick="filtro='online';render()">Online</button>
  </div>

  <div class="table-wrap">
   <table>
    <thead>
     <tr>
      <th>Usuário</th>
      <th>Tipo</th>
      <th>Status</th>
      <th>Validade</th>
      <th>Conexão</th>
      <th>Ações</th>
     </tr>
    </thead>
    <tbody id="lista"></tbody>
   </table>
  </div>
 </section>

</main>

<div id="modal" class="modal">
 <div class="modal-box">
  <h2 id="modalTitulo">Criar usuário</h2>

  <input type="hidden" id="editId">

  <label>Usuário</label>
  <input id="usuario" autocomplete="off">

  <label>Senha</label>
  <input id="senha" type="password" autocomplete="new-password">

  <label>Tipo</label>
  <select id="tipo">
   <option value="usuario">Usuário</option>
   <option value="teste">Teste</option>
   <option value="revendedor">Revendedor</option>
  </select>

  <label>Dias de acesso</label>
  <input id="dias" type="number" min="1" value="30">

  <label>Limite de conexões (revendedor)</label>
  <input id="limite" type="number" min="1" value="1">

  <div class="modal-actions">
   <button class="btn-dark" onclick="fecharModal()">Cancelar</button>
   <button onclick="salvar()">Salvar</button>
  </div>
 </div>
</div>

<div id="toast" class="toast"></div>

<script>
let usuarios=[];
let filtro="todos";

function toast(msg){
 const t=document.getElementById("toast");
 t.textContent=msg;
 t.classList.add("show");
 setTimeout(()=>t.classList.remove("show"),2800);
}

async function api(url,options={}){
 const r=await fetch(url,{
  credentials:"same-origin",
  headers:{"Content-Type":"application/json",...(options.headers||{})},
  ...options
 });
 let data={};
 try{data=await r.json()}catch(e){}
 if(!r.ok) throw new Error(data.mensagem||"Erro na operação");
 return data;
}

async function carregar(){
 try{
  const data=await api("/api/admin/usuarios");
  usuarios=Array.isArray(data.usuarios)?data.usuarios:[];
  atualizarResumo();
  render();
 }catch(e){
  toast("❌ "+e.message);
 }
}

function atualizarResumo(){
 document.getElementById("total").textContent=usuarios.length;
 document.getElementById("online").textContent=usuarios.filter(x=>x.online).length;
 document.getElementById("testes").textContent=usuarios.filter(x=>x.tipo==="teste").length;
 document.getElementById("revendedores").textContent=usuarios.filter(x=>x.tipo==="revendedor").length;
}

function render(){
 const busca=(document.getElementById("busca").value||"").toLowerCase();

 let lista=usuarios.filter(u=>{
  if(filtro==="online"&&!u.online)return false;
  if(filtro!=="todos"&&filtro!=="online"&&u.tipo!==filtro)return false;
  return String(u.usuario||"").toLowerCase().includes(busca);
 });

 const tbody=document.getElementById("lista");

 if(!lista.length){
  tbody.innerHTML='<tr><td colspan="6" class="empty">Nenhum usuário encontrado.</td></tr>';
  return;
 }

 tbody.innerHTML=lista.map(u=>{
  const validade=u.validade
   ? new Date(u.validade).toLocaleDateString("pt-BR")
   : "—";

  const tipo=u.tipo||"usuario";
  const online=u.online
   ? '<span class="online">● ONLINE</span>'
   : '<span class="offline">● OFFLINE</span>';

  const status=u.status==="suspenso"
   ? '<span class="status-suspenso">SUSPENSO</span>'
   : '<span class="status-ativo">ATIVO</span>';

  return `
   <tr>
    <td><strong>${esc(u.usuario)}</strong></td>
    <td><span class="badge">${esc(tipo)}</span></td>
    <td>${status}</td>
    <td>${validade}</td>
    <td>${online}</td>
    <td>
     <div class="row-actions">
      <button class="btn-blue" onclick="editar(${u.id})">Editar</button>
      <button class="btn-green" onclick="renovar(${u.id})">Renovar</button>
      <button class="${u.status==='suspenso'?'btn-green':'btn-orange'}" onclick="status(${u.id},'${u.status==='suspenso'?'ativo':'suspenso'}')">
       ${u.status==='suspenso'?'Ativar':'Suspender'}
      </button>
      <button class="btn-red" onclick="excluir(${u.id})">Excluir</button>
     </div>
    </td>
   </tr>
  `;
 }).join("");
}

function esc(v){
 return String(v??"")
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");
}

function abrirCriar(tipo){
 document.getElementById("editId").value="";
 document.getElementById("usuario").value="";
 document.getElementById("senha").value="";
 document.getElementById("tipo").value=tipo;
 document.getElementById("dias").value=tipo==="teste"?1:30;
 document.getElementById("limite").value=5;
 document.getElementById("modalTitulo").textContent=
  tipo==="revendedor"?"Criar revendedor":
  tipo==="teste"?"Criar teste":"Criar usuário";
 document.getElementById("modal").classList.add("show");
}

function fecharModal(){
 document.getElementById("modal").classList.remove("show");
}

function editar(id){
 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!u)return;

 document.getElementById("editId").value=u.id;
 document.getElementById("usuario").value=u.usuario||"";
 document.getElementById("senha").value="";
 document.getElementById("tipo").value=u.tipo||"usuario";
 document.getElementById("dias").value=30;
 document.getElementById("modalTitulo").textContent="Editar usuário";
 document.getElementById("modal").classList.add("show");
}

async function salvar(){
 const id=document.getElementById("editId").value;
 const usuario=document.getElementById("usuario").value.trim();
 const senha=document.getElementById("senha").value;
 const tipo=document.getElementById("tipo").value;
 const dias=Number(document.getElementById("dias").value);
 const limite=Number(document.getElementById("limite").value);

 if(!usuario)return toast("Informe o usuário.");

 try{
  if(id){
   const data=await api("/api/admin/usuarios/editar",{
    method:"POST",
    body:JSON.stringify({id:Number(id),usuario,senha,tipo:tipo==="teste"?"usuario":tipo})
   });
   toast("✅ "+(data.mensagem||"Usuário atualizado."));
  }else if(tipo==="revendedor"){
   const data=await api("/api/admin/revendedores",{
    method:"POST",
    body:JSON.stringify({
     usuario,
     senha,
     dias,
     limite_conexoes:limite
    })
   });
   toast("✅ "+(data.mensagem||"Revendedor criado."));
  }else{
   const data=await api("/api/admin/usuarios",{
    method:"POST",
    body:JSON.stringify({
     usuario,
     senha,
     tipo,
     dias
    })
   });
   toast("✅ "+(data.mensagem||"Usuário criado."));
  }

  fecharModal();
  await carregar();

 }catch(e){
  toast("❌ "+e.message);
 }
}

async function status(id,status){
 try{
  const data=await api("/api/admin/usuarios/status",{
   method:"POST",
   body:JSON.stringify({id:Number(id),status})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

async function renovar(id){
 const dias=prompt("Quantos dias deseja adicionar?", "30");
 if(dias===null)return;

 const n=Number(dias);
 if(!Number.isInteger(n)||n<1){
  toast("Quantidade de dias inválida.");
  return;
 }

 try{
  const data=await api("/api/admin/usuarios/renovar",{
   method:"POST",
   body:JSON.stringify({id:Number(id),dias:n})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

async function excluir(id){
 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!confirm("Excluir o usuário "+(u?.usuario||"")+"?"))return;

 try{
  const data=await api("/api/admin/usuarios/excluir",{
   method:"POST",
   body:JSON.stringify({id:Number(id)})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

setInterval(async()=>{
 try{
  await api("/api/admin/presenca",{
   method:"POST",
   body:"{}"
  });
  await carregar();
 }catch(e){}
},30000);

carregar();
</script>

</body>
</html>
