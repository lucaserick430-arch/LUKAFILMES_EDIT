<script id="lukafilmes-revendedor-upgrade-js">
(function(){

 const $=id=>document.getElementById(id);

 window.lfNovoUsuario=function(){
   const el=$("clienteUsuario");
   if(el){
     el.scrollIntoView({behavior:"smooth",block:"center"});
     setTimeout(()=>el.focus(),350);
   }
 };

 window.lfAbrirUsuarios=function(){
   const alvo=document.querySelector("table") ||
               document.querySelector("#listaClientes") ||
               document.querySelector("#clientes");
   if(alvo) alvo.scrollIntoView({behavior:"smooth",block:"start"});
   else window.scrollTo({top:500,behavior:"smooth"});
 };

 window.lfAtualizar=function(){
   try{
     if(typeof carregarClientes==="function") carregarClientes();
   }catch(e){}
   try{
     if(typeof carregar==="function") carregar();
   }catch(e){}
   setTimeout(lfAtualizarCards,500);
 };

 function lfAtualizarCards(){

   let total=0;
   let online=0;
   let ativos=0;
   let expirando=0;

   const rows=[...document.querySelectorAll("table tbody tr")];

   rows.forEach(row=>{
     const txt=(row.innerText||"").toLowerCase();

     if(!txt.includes("nenhum")) total++;

     if(
       txt.includes("online") ||
       txt.includes("conectado")
     ) online++;

     if(
       txt.includes("ativo") ||
       txt.includes("ativa")
     ) ativos++;

     if(
       txt.includes("expir") ||
       txt.includes("vence hoje")
     ) expirando++;
   });

   if($("lfTotalUsuarios")) $("lfTotalUsuarios").textContent=total;
   if($("lfTotalOnline")) $("lfTotalOnline").textContent=online;
   if($("lfTotalAtivos")) $("lfTotalAtivos").textContent=ativos;
   if($("lfTotalExpirando")) $("lfTotalExpirando").textContent=expirando;
 }

 window.lfAbrirFoto=function(){
   const modal=$("lfPhotoModal");
   if(modal) modal.classList.add("show");
 };

 window.lfFecharFoto=function(){
   const modal=$("lfPhotoModal");
   if(modal) modal.classList.remove("show");
 };

 window.lfSalvarFoto=function(){

   const input=$("lfPhotoInput");
   if(!input || !input.files || !input.files[0]){
     alert("Escolha uma foto primeiro.");
     return;
   }

   const file=input.files[0];

   if(!file.type.startsWith("image/")){
     alert("Escolha uma imagem válida.");
     return;
   }

   if(file.size>5*1024*1024){
     alert("A foto deve ter no máximo 5 MB.");
     return;
   }

   const reader=new FileReader();

   reader.onload=function(){
     try{
       localStorage.setItem("lukafilmes_revendedor_foto",reader.result);
     }catch(e){
       alert("Não foi possível salvar essa foto no navegador.");
       return;
     }

     lfAplicarFoto(reader.result);
     lfFecharFoto();
   };

   reader.readAsDataURL(file);
 };

 function lfAplicarFoto(src){

   const imgs=[
     $("lfAvatarImg"),
     $("lfBrandLogoImg"),
     $("lfPhotoPreviewImg")
   ];

   imgs.forEach(img=>{
     if(img){
       img.src=src;
       img.style.display="block";
     }
   });

   ["lfAvatarLetter","lfBrandLetter","lfPhotoPreviewLetter"].forEach(id=>{
     const el=$(id);
     if(el) el.style.display="none";
   });
 }

 function lfCarregarFoto(){
   try{
     const src=localStorage.getItem("lukafilmes_revendedor_foto");
     if(src) lfAplicarFoto(src);
   }catch(e){}
 }

 function lfNome(){
   const fontes=[
     $("nomeRevendedor"),
     $("revendedorNome"),
     $("usuarioNome"),
     $("nomeUsuario")
   ];

   for(const el of fontes){
     if(el && el.textContent.trim()){
       return el.textContent.trim();
     }
   }

   return "Revendedor";
 }

 function lfAplicarNome(){
   const nome=lfNome();

   if($("lfNomeRevendedor")) $("lfNomeRevendedor").textContent=nome;
   if($("lfSaudacaoNome")) $("lfSaudacaoNome").textContent=nome;

   const letra=(nome[0]||"R").toUpperCase();

   if($("lfAvatarLetter")) $("lfAvatarLetter").textContent=letra;
   if($("lfBrandLetter")) $("lfBrandLetter").textContent=letra;
   if($("lfPhotoPreviewLetter")) $("lfPhotoPreviewLetter").textContent=letra;
 }

 document.addEventListener("DOMContentLoaded",function(){

   lfCarregarFoto();
   lfAplicarNome();

   setTimeout(lfAtualizarCards,700);

   setInterval(lfAtualizarCards,3000);

   document.addEventListener("click",function(e){
     if(e.target===$("lfPhotoModal")){
       lfFecharFoto();
     }
   });

 });

})();
</script>

