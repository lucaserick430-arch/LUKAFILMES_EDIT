<script id="luka-mobile-capas-cards-js">
(function(){

    if(window.innerWidth > 600) return;

    function iniciarCapasMobile(){

        if(document.getElementById("luka-mobile-capas")) return;

        var area = document.createElement("div");
        area.id = "luka-mobile-capas";

        var linha1 = document.createElement("div");
        linha1.id = "luka-mobile-capas-linha1";
        linha1.className = "luka-mobile-capas-linha";

        var linha2 = document.createElement("div");
        linha2.id = "luka-mobile-capas-linha2";
        linha2.className = "luka-mobile-capas-linha";

        area.appendChild(linha1);
        area.appendChild(linha2);
        document.body.appendChild(area);

        fetch("/api/catalogo-filmes")
            .then(function(res){
                if(!res.ok) throw new Error("catalogo");
                return res.json();
            })
            .then(function(dados){

                var filmes = [];

                if(Array.isArray(dados)){
                    filmes = dados;
                }else if(Array.isArray(dados.filmes)){
                    filmes = dados.filmes;
                }else if(Array.isArray(dados.resultados)){
                    filmes = dados.resultados;
                }else if(Array.isArray(dados.results)){
                    filmes = dados.results;
                }

                var mapa = {};

                filmes.forEach(function(filme){

                    var caminho =
                        filme.poster_path ||
                        filme.poster ||
                        filme.capa ||
                        filme.imagem ||
                        filme.posterPath ||
                        "";

                    if(!caminho) return;

                    var url = caminho;

                    if(caminho.indexOf("http") === 0){
                        url = caminho;
                    }else if(caminho.indexOf("//") === 0){
                        url = "https:" + caminho;
                    }else if(caminho.indexOf("/t/p/") === 0){
                        url = "https://image.tmdb.org/t/p/w342" +
                              caminho.replace("/t/p/","");
                    }else if(caminho.indexOf("/") === 0){
                        url = "https://image.tmdb.org/t/p/w342" + caminho;
                    }

                    mapa[url] = url;
                });

                var capas = Object.keys(mapa);

                // Embaralha o catalogo inteiro
                for(var i = capas.length - 1; i > 0; i--){
                    var j = Math.floor(Math.random() * (i + 1));
                    var temp = capas[i];
                    capas[i] = capas[j];
                    capas[j] = temp;
                }

                /*
                 * 24 capas únicas:
                 * 12 para a primeira linha
                 * 12 diferentes para a segunda.
                 */
                var total = Math.min(24, capas.length);

                if(total < 8){
                    area.remove();
                    return;
                }

                var primeira = capas.slice(0, Math.ceil(total / 2));
                var segunda = capas.slice(Math.ceil(total / 2), total);

                function adicionar(linha, lista){

                    // Duplica somente a própria linha
                    // para criar o loop contínuo.
                    var repetida = lista.concat(lista);

                    repetida.forEach(function(url){

                        var img = document.createElement("img");

                        img.src = url;
                        img.alt = "";
                        img.draggable = false;
                        img.setAttribute("aria-hidden","true");

                        /*
                         * Card puramente visual.
                         * Nenhum clique abre filme.
                         */
                        img.onclick = function(e){
                            e.preventDefault();
                            e.stopPropagation();
                            return false;
                        };

                        linha.appendChild(img);
                    });
                }

                adicionar(linha1, primeira);
                adicionar(linha2, segunda);

            })
            .catch(function(){
                area.remove();
            });
    }

    if(document.readyState === "loading"){
        document.addEventListener("DOMContentLoaded", iniciarCapasMobile);
    }else{
        iniciarCapasMobile();
    }

})();
</script>


