<script id="luka-mobile-capas-linha3-js">
(function(){
    if(window.innerWidth > 600) return;

    function adicionarTerceiraLinha(){

        var area = document.getElementById("luka-mobile-capas");

        if(!area){
            setTimeout(adicionarTerceiraLinha, 300);
            return;
        }

        var linhas = area.querySelectorAll(".luka-mobile-capas-linha");

        if(linhas.length < 2){
            setTimeout(adicionarTerceiraLinha, 300);
            return;
        }

        var primeira = linhas[0];

        if(!primeira || !primeira.children.length){
            setTimeout(adicionarTerceiraLinha, 300);
            return;
        }

        /* Evita criar a terceira linha mais de uma vez */
        var existente = document.getElementById("luka-mobile-capas-linha3");

        if(existente){
            existente.remove();
        }

        var linha3 = document.createElement("div");
        linha3.id = "luka-mobile-capas-linha3";
        linha3.className = "luka-mobile-capas-linha";

        area.appendChild(linha3);

        var imagens = primeira.querySelectorAll("img");
        var urls = [];

        imagens.forEach(function(img){
            if(img.src && urls.indexOf(img.src) === -1){
                urls.push(img.src);
            }
        });

        if(!urls.length){
            linha3.remove();
            setTimeout(adicionarTerceiraLinha, 300);
            return;
        }

        var quantidade = Math.min(12, urls.length);

        for(var i = 0; i < quantidade; i++){

            var img = document.createElement("img");

            img.src = urls[i];
            img.alt = "";
            img.draggable = false;
            img.setAttribute("aria-hidden","true");

            img.onclick = function(e){
                e.preventDefault();
                e.stopPropagation();
                return false;
            };

            linha3.appendChild(img);
        }

        for(var j = 0; j < quantidade; j++){

            var clone = document.createElement("img");

            clone.src = urls[j];
            clone.alt = "";
            clone.draggable = false;
            clone.setAttribute("aria-hidden","true");

            clone.onclick = function(e){
                e.preventDefault();
                e.stopPropagation();
                return false;
            };

            linha3.appendChild(clone);
        }

        console.log("LUKAFILMES: terceira fileira criada:", linha3.children.length, "cards");
    }

    if(document.readyState === "loading"){
        document.addEventListener("DOMContentLoaded", adicionarTerceiraLinha);
    }else{
        adicionarTerceiraLinha();
    }

})();
</script>

