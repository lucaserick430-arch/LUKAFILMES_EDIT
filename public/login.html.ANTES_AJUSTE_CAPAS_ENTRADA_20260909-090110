<script>
(function(){

    function iniciarBotoesLuka(){

        var visitante = document.getElementById("luka-btn-visitante");
        var cliente = document.getElementById("luka-btn-cliente");
        var formulario = document.getElementById("luka-formulario-cliente");
        var usuario = document.getElementById("luka-cliente-usuario");
        var senha = document.getElementById("luka-cliente-senha");
        var entrar = document.getElementById("luka-cliente-entrar");
        var mensagem = document.getElementById("luka-formulario-mensagem");

        if(visitante){
            visitante.onclick = function(){
                window.location.href = "/entrar-visitante";
            };
        }

        if(cliente){
            cliente.onclick = function(){

                if(!formulario) return;

                var estaAberto =
                    formulario.getAttribute("data-aberto") === "1";

                if(estaAberto){

                    formulario.setAttribute("data-aberto", "0");
                    formulario.classList.remove("aberto");
                    formulario.style.display = "none";

                }else{

                    formulario.setAttribute("data-aberto", "1");
                    formulario.classList.add("aberto");
                    formulario.style.display = "block";

                    setTimeout(function(){
                        if(usuario) usuario.focus();
                    },100);
                }
            };
        }

        if(entrar){

            entrar.onclick = async function(){

                var u = usuario ? usuario.value.trim() : "";
                var s = senha ? senha.value : "";

                if(!u || !s){

                    if(mensagem){
                        mensagem.textContent = "Digite usuário e senha.";
                    }

                    return;
                }

                entrar.disabled = true;
                entrar.textContent = "ENTRANDO...";

                try{

                    var resposta = await fetch("/login", {
                        method:"POST",
                        headers:{
                            "Content-Type":"application/json"
                        },
                        body:JSON.stringify({
                            usuario:u,
                            senha:s
                        })
                    });

                    var dados = await resposta.json();

                    if(dados.sucesso){

                        window.location.href = dados.destino || "/";

                    }else{

                        if(mensagem){
                            mensagem.textContent =
                                dados.mensagem ||
                                "Usuário ou senha incorretos.";
                        }

                        entrar.disabled = false;
                        entrar.textContent = "ENTRAR";
                    }

                }catch(erro){

                    if(mensagem){
                        mensagem.textContent =
                            "Não foi possível entrar. Tente novamente.";
                    }

                    entrar.disabled = false;
                    entrar.textContent = "ENTRAR";
                }
            };
        }
    }

    if(document.readyState === "loading"){
        document.addEventListener("DOMContentLoaded", iniciarBotoesLuka);
    }else{
        iniciarBotoesLuka();
    }

})();
</script>
