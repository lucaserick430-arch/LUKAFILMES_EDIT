        pointer-events: none;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        min-height: 100vh;
        overflow: hidden;
        position: relative;
        background: #000;
        color: white;
        font-family: Arial, sans-serif;

        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: #080808;
        color: white;
        font-family: Arial, sans-serif;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login {
        position: relative;
        z-index: 5;
        width: 90%;
        max-width: 400px;
        background: rgba(10, 10, 10, 0.82);
