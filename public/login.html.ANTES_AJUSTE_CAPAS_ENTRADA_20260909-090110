         * Assim eles ficam realmente sobre o trailer,
         * independentemente dos containers da tela de login.
         */
        if(opcoes.parentElement !== document.body){
            document.body.appendChild(opcoes);
        }
    }

    if(document.readyState === "loading"){
        document.addEventListener("DOMContentLoaded", posicionarBotoes);
    }else{
        posicionarBotoes();
