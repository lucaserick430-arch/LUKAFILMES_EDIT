    }

    .logo span {
        color: #e50914;
    }

    .boas-vindas {
        text-align: center;
    }

    .premium-entrada {
        width: 100%;
        text-align: center;
        position: relative;
        animation: premiumEntrada .9s cubic-bezier(.22,1,.36,1) both;
    }

    .premium-logo {
        font-size: 38px;
        font-weight: 900;
        letter-spacing: -2.5px;
        line-height: 1;
        margin-bottom: 20px;
        text-transform: uppercase;
        text-shadow: 0 4px 25px rgba(0,0,0,.45);
    }

    .premium-logo span {
        color: #fff;
    }

    .premium-logo b {
        color: #e50914;
        font-weight: 900;
    }

    .premium-linha {
        width: 54px;
        height: 2px;
        margin: 0 auto 27px;
        background: #e50914;
        box-shadow:
            0 0 8px rgba(229,9,20,.7),
            0 0 22px rgba(229,9,20,.3);
    }

    .premium-kicker {
        color: #a6a6a6;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 3.2px;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .premium-entrada h1 {
        color: #fff;
        font-size: 30px;
        line-height: 1.12;
        letter-spacing: -.9px;
        margin: 0 0 17px;
        font-weight: 400;
        text-shadow: 0 3px 20px rgba(0,0,0,.5);
    }

    .premium-entrada h1 strong {
        font-weight: 900;
    }

    .premium-subtitulo {
        color: #d0d0d0;
        font-size: 15px;
        line-height: 1.55;
        margin: 0 0 23px;
        text-shadow: 0 2px 12px rgba(0,0,0,.5);
    }

    .premium-tags {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #8e8e8e;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.6px;
        margin-bottom: 29px;
        white-space: nowrap;
    }

    .premium-tags i {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #e50914;
        display: inline-block;
        box-shadow: 0 0 7px rgba(229,9,20,.8);
    }

    #botaoEntrar {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        width: 100%;
        min-height: 58px;
        padding: 16px 22px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 7px;
        background: linear-gradient(135deg,#e50914,#b20710);
        box-shadow:
            0 12px 35px rgba(229,9,20,.25),
            inset 0 1px 0 rgba(255,255,255,.12);
        color: #fff;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 1.2px;
        transition:
            transform .2s ease,
            box-shadow .2s ease,
            filter .2s ease;
    }

    #botaoEntrar::before {
        content: "";
        position: absolute;
        top: 0;
        left: -120%;
        width: 70%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.16),
            transparent
        );
        transform: skewX(-20deg);
        transition: left .7s ease;
    }

    #botaoEntrar:hover::before {
        left: 150%;
    }

    #botaoEntrar:hover {
        transform: translateY(-2px);
        filter: brightness(1.08);
        box-shadow:
            0 16px 45px rgba(229,9,20,.34),
            inset 0 1px 0 rgba(255,255,255,.15);
    }

    #botaoEntrar:active {
        transform: scale(.985);
    }

    #botaoEntrar:disabled {
        cursor: wait;
        opacity: .9;
        transform: none;
    }

    .icone-play {
        width: 25px;
        height: 25px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
        font-size: 10px;
        line-height: 1;
    }

    .premium-mensagem {
        color: #707070;
        font-size: 10px;
        line-height: 1.5;
        margin-top: 18px;
        letter-spacing: .15px;
    }

    @keyframes premiumEntrada {
        from {
            opacity: 0;
            transform: translateY(18px) scale(.985);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media(max-width:600px) {

        .premium-logo {
            font-size: 32px;
            letter-spacing: -2px;
        }

        .premium-linha {
            margin-bottom: 23px;
