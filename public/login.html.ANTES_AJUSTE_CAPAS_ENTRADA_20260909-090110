<script id="lukafilmes-login-funcional">
document
        .getElementById("loginForm")
        .addEventListener("submit", async function(event) {

            event.preventDefault();

            const usuario =
                document.getElementById("usuario").value.trim();

            const senha =
                document.getElementById("senha").value;

            const mensagem =
                document.getElementById("mensagem");

            const botao =
                document.getElementById("botaoEntrar");

            mensagem.textContent = "";
            botao.disabled = true;
            botao.textContent = "ENTRANDO...";

            try {

                const resposta = await fetch(
                    "/login",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            usuario,
                            senha
                        })
                    }
                );

                const dados = await resposta.json();

                if (dados.sucesso) {

                    window.location.href = dados.destino || "/";

                } else {

                    mensagem.textContent =
                        dados.mensagem ||
                        "Usuário ou senha incorretos.";

                }

            } catch (erro) {

                console.error(
                    "Erro no login:",
                    erro
                );

                mensagem.textContent =
                    "Não foi possível conectar ao servidor.";

            } finally {

                botao.disabled = false;
                botao.textContent = "ENTRAR";

            }

        });
</script>

<script id="lukafilmes-login-loader-js">
(function(){

    var loader = document.getElementById("lukafilmesLoginLoader");
    var form = document.getElementById("loginForm");

    function mostrarLoginLoader(){
        if(!loader)return;
        loader.classList.add("ativo");
        loader.setAttribute("aria-hidden","false");
    }

    function esconderLoginLoader(){
        if(!loader)return;
        loader.classList.remove("ativo");
        loader.setAttribute("aria-hidden","true");
    }

    window.lukafilmesMostrarLoginLoader = mostrarLoginLoader;
    window.lukafilmesEsconderLoginLoader = esconderLoginLoader;

    if(form){
        form.addEventListener("submit",function(){
            mostrarLoginLoader();
        },true);
    }

    window.addEventListener("pageshow",function(){
        esconderLoginLoader();
    });

})();
</script>





