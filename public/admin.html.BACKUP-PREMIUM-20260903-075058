<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LUKAFILMES — Central Admin</title>
</head>
<body>
<!-- =========================================================
     LUKAFILMES — CENTRAL ADMINISTRATIVA PREMIUM
     ========================================================= -->
<style>
#LUKA-CENTRAL{
position:fixed;inset:0;z-index:2147483000;
background:linear-gradient(135deg,#05070d,#0b1020 45%,#05070d);
color:#fff;font-family:Inter,system-ui,sans-serif;
overflow:auto;padding:24px;
}
#LUKA-CENTRAL *{box-sizing:border-box}
.lc-top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:25px}
.lc-brand{font-size:28px;font-weight:900;letter-spacing:.5px}
.lc-brand span{opacity:.45}
.lc-actions{display:flex;gap:10px;flex-wrap:wrap}
.lc-btn{
border:1px solid rgba(255,255,255,.12);border-radius:14px;
padding:12px 18px;background:rgba(255,255,255,.07);color:#fff;
font-weight:800;cursor:pointer;transition:.2s;
}
.lc-btn:hover{transform:translateY(-2px);background:rgba(255,255,255,.13)}
.lc-primary{background:linear-gradient(135deg,#e50914,#ff3150);border:0}
.lc-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:15px;margin-bottom:25px}
.lc-card{
padding:20px;border-radius:20px;
background:rgba(255,255,255,.055);
border:1px solid rgba(255,255,255,.09);
box-shadow:0 15px 50px rgba(0,0,0,.25);
}
.lc-card small{opacity:.55;font-weight:700}
.lc-number{font-size:32px;font-weight:900;margin-top:7px}
.lc-live{display:flex;align-items:center;gap:7px}
.lc-dot{width:9px;height:9px;border-radius:50%;background:#39ff88;box-shadow:0 0 15px #39ff88}
.lc-panel{
background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);
border-radius:22px;padding:20px;
}
.lc-toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.lc-input,.lc-select{
background:#080c16;color:#fff;border:1px solid rgba(255,255,255,.12);
border-radius:12px;padding:12px 14px;outline:none;
}
.lc-input{flex:1;min-width:220px}
.lc-table{width:100%;border-collapse:collapse}
.lc-table th,.lc-table td{padding:13px 10px;border-bottom:1px solid rgba(255,255,255,.07);text-align:left}
.lc-table th{opacity:.55;font-size:12px;text-transform:uppercase}
.lc-badge{padding:5px 9px;border-radius:999px;font-size:11px;font-weight:900;background:rgba(255,255,255,.08)}
.lc-online{color:#45ff91}
.lc-modal{
position:fixed;inset:0;background:rgba(0,0,0,.72);
display:none;align-items:center;justify-content:center;padding:20px;
backdrop-filter:blur(12px);z-index:2147483001;
}
.lc-box{
width:min(620px,100%);background:#0c111d;border:1px solid rgba(255,255,255,.1);
border-radius:25px;padding:25px;box-shadow:0 30px 100px #000;
}
.lc-box h2{margin-top:0}
.lc-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.lc-fields input,.lc-fields select{
width:100%;padding:13px;border-radius:12px;background:#050811;
color:#fff;border:1px solid rgba(255,255,255,.12)
}
.lc-full{grid-column:1/-1}
.lc-hours{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.lc-hour{padding:10px 15px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:#101625;color:#fff;cursor:pointer;font-weight:800}
.lc-close{float:right;border:0;background:none;color:#fff;font-size:25px;cursor:pointer}
.lc-footer{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}
@media(max-width:900px){
.lc-grid{grid-template-columns:repeat(2,1fr)}
.lc-table{min-width:900px}
.lc-panel{overflow:auto}
}
@media(max-width:520px){
#LUKA-CENTRAL{padding:14px}
.lc-grid{grid-template-columns:1fr 1fr}
.lc-fields{grid-template-columns:1fr}
.lc-full{grid-column:auto}
}
</style>

<div id="LUKA-CENTRAL">
<div class="lc-top">
<div class="lc-brand">LUKAFILMES <span>• CENTRAL ADMIN</span></div>
<div class="lc-actions">
<button class="lc-btn lc-primary" onclick="LC.openUser()">＋ Novo Usuário</button>
<button class="lc-btn" onclick="LC.openTest()">⚡ Criar Teste</button>
<button class="lc-btn" onclick="LC.load()">↻ Atualizar</button>
</div>
</div>

<div class="lc-grid">
<div class="lc-card"><small>USUÁRIOS</small><div class="lc-number" id="lc-total">0</div></div>
<div class="lc-card"><small>ATIVOS</small><div class="lc-number" id="lc-active">0</div></div>
<div class="lc-card"><small>TESTES</small><div class="lc-number" id="lc-tests">0</div></div>
<div class="lc-card"><small>EXPIRADOS</small><div class="lc-number" id="lc-expired">0</div></div>
<div class="lc-card"><small>ONLINE AGORA</small><div class="lc-number lc-live"><i class="lc-dot"></i><span id="lc-online">0</span></div></div>
</div>

<div class="lc-panel">
<div class="lc-toolbar">
<input id="lc-search" class="lc-input" placeholder="Pesquisar usuário, telefone ou WhatsApp..." oninput="LC.render()">
<select id="lc-filter" class="lc-select" onchange="LC.render()">
<option value="">Todos</option>
<option value="ativo">Ativos</option>
<option value="inativo">Inativos</option>
<option value="teste">Testes</option>
<option value="revendedor">Revendedores</option>
</select>
</div>

<table class="lc-table">
<thead><tr>
<th>Usuário</th><th>Status</th><th>Validade</th><th>Conexões</th><th>Tipo</th><th>Ações</th>
</tr></thead>
<tbody id="lc-body"></tbody>
</table>
</div>
</div>

<div id="lc-user-modal" class="lc-modal">
<div class="lc-box">
<button class="lc-close" onclick="LC.close('lc-user-modal')">×</button>
<h2 id="lc-user-title">Novo Usuário</h2>
<div class="lc-fields">
<input id="lc-u" placeholder="Usuário">
<input id="lc-p" placeholder="Senha">
<input id="lc-days" type="number" value="30" min="1" placeholder="Dias">
<input id="lc-limit" type="number" value="1" min="1" placeholder="Limite de conexões">
<input id="lc-phone" placeholder="Telefone / WhatsApp">
<input id="lc-value" type="number" step="0.01" placeholder="Valor">
<select id="lc-type">
<option value="usuario">Usuário</option>
<option value="teste">Teste</option>
</select>
</div>
<div class="lc-footer">
<button class="lc-btn" onclick="LC.close('lc-user-modal')">Cancelar</button>
<button class="lc-btn lc-primary" onclick="LC.saveUser()">Salvar Usuário</button>
</div>
</div>
</div>

<div id="lc-test-modal" class="lc-modal">
<div class="lc-box">
<button class="lc-close" onclick="LC.close('lc-test-modal')">×</button>
<h2>⚡ Criar Teste Automático</h2>
<p style="opacity:.65">Escolha quantas horas o teste ficará ativo.</p>
<div class="lc-hours">
<button class="lc-hour" onclick="LC.setHours(1)">1h</button>
<button class="lc-hour" onclick="LC.setHours(2)">2h</button>
<button class="lc-hour" onclick="LC.setHours(3)">3h</button>
<button class="lc-hour" onclick="LC.setHours(5)">5h</button>
<button class="lc-hour" onclick="LC.setHours(10)">10h</button>
<button class="lc-hour" onclick="LC.setHours(24)">24h</button>
<button class="lc-hour" onclick="LC.setHours(48)">48h</button>
<button class="lc-hour" onclick="LC.setHours(72)">72h</button>
</div>
<input id="lc-test-hours" class="lc-input" type="number" min="1" value="1" placeholder="Quantidade personalizada de horas">
<input id="lc-test-limit" class="lc-input" type="number" min="1" value="1" placeholder="Limite de conexões" style="margin-top:10px">
<div class="lc-footer">
<button class="lc-btn" onclick="LC.close('lc-test-modal')">Cancelar</button>
<button class="lc-btn lc-primary" onclick="LC.createTest()">⚡ Criar Teste</button>
</div>
</div>
</div>

<script>
window.LC=(function(){
let users=[],editing=null;

async function load(){
try{
const r=await fetch('/api/admin/usuarios',{credentials:'same-origin'});
const j=await r.json();
users=Array.isArray(j)?j:(j.usuarios||j.users||[]);
render();
}catch(e){console.error(e)}
}

function render(){
const q=(document.getElementById('lc-search').value||'').toLowerCase();
const f=document.getElementById('lc-filter').value;
let list=users.filter(x=>{
const text=JSON.stringify(x).toLowerCase();
if(q&&!text.includes(q))return false;
const tipo=String(x.tipo||x.role||'usuario').toLowerCase();
const status=String(x.status||'').toLowerCase();
if(f==='revendedor'&&!tipo.includes('revendedor'))return false;
if(f==='teste'&&!tipo.includes('teste'))return false;
if(f==='ativo'&&!['ativo','active','1'].includes(status)&&x.ativo!==1&&x.ativo!==true)return false;
if(f==='inativo'&&(['ativo','active','1'].includes(status)||x.ativo===1||x.ativo===true))return false;
return true;
});

document.getElementById('lc-total').textContent=users.length;
document.getElementById('lc-active').textContent=users.filter(x=>['ativo','active','1'].includes(String(x.status).toLowerCase())||x.ativo===1||x.ativo===true).length;
document.getElementById('lc-tests').textContent=users.filter(x=>String(x.tipo||'').toLowerCase().includes('teste')).length;
document.getElementById('lc-expired').textContent=users.filter(x=>String(x.status||'').toLowerCase().includes('expir')).length;
document.getElementById('lc-online').textContent=users.filter(x=>x.online||x.conectado||Number(x.conexoes_utilizadas||0)>0).length;

document.getElementById('lc-body').innerHTML=list.map(x=>{
const tipo=String(x.tipo||x.role||'usuario');
const rev=tipo.toLowerCase().includes('revendedor');
const online=x.online||x.conectado||Number(x.conexoes_utilizadas||0)>0;
return `<tr>
<td><b>${esc(x.usuario||x.username||'-')}</b><br><small style="opacity:.45">${esc(x.telefone||x.whatsapp||'')}</small></td>
<td><span class="lc-badge ${online?'lc-online':''}">${online?'● ONLINE':esc(x.status||'ATIVO')}</span></td>
<td>${esc(x.validade||x.data_expiracao||x.expira_em||'-')}</td>
<td>${x.conexoes_utilizadas||0}/${x.limite_conexoes||1}</td>
<td>${esc(tipo)}</td>
<td style="white-space:nowrap">
${rev?'<span class="lc-badge">PROTEGIDO</span>':`
<button class="lc-btn" onclick='LC.edit(${JSON.stringify(x).replace(/'/g,"&#39;")})'>Editar</button>
<button class="lc-btn" onclick="LC.renew(${Number(x.id)||0})">Renovar</button>
<button class="lc-btn" onclick="LC.status(${Number(x.id)||0})">Ativar/Desativar</button>
<button class="lc-btn" onclick="LC.del(${Number(x.id)||0})">Excluir</button>`}
</td></tr>`;
}).join('');
}

function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}

function openUser(){editing=null;document.getElementById('lc-user-title').textContent='Novo Usuário';['lc-u','lc-p','lc-phone','lc-value'].forEach(id=>document.getElementById(id).value='');document.getElementById('lc-days').value=30;document.getElementById('lc-limit').value=1;document.getElementById('lc-type').value='usuario';show('lc-user-modal')}
function edit(x){editing=x;document.getElementById('lc-user-title').textContent='Editar Usuário';document.getElementById('lc-u').value=x.usuario||x.username||'';document.getElementById('lc-p').value='';document.getElementById('lc-phone').value=x.telefone||x.whatsapp||'';document.getElementById('lc-value').value=x.valor||x.valor_mensal||'';document.getElementById('lc-limit').value=x.limite_conexoes||1;document.getElementById('lc-type').value=String(x.tipo||'usuario').toLowerCase().includes('teste')?'teste':'usuario';show('lc-user-modal')}
async function saveUser(){
const body={usuario:document.getElementById('lc-u').value,senha:document.getElementById('lc-p').value,dias:Number(document.getElementById('lc-days').value)||30,tipo:document.getElementById('lc-type').value,telefone:document.getElementById('lc-phone').value,whatsapp:document.getElementById('lc-phone').value,valor:Number(document.getElementById('lc-value').value)||0,valor_mensal:Number(document.getElementById('lc-value').value)||0,limite_conexoes:Number(document.getElementById('lc-limit').value)||1};
if(editing)body.id=editing.id;
const url=editing?'/api/admin/usuarios/editar':'/api/admin/usuarios';
const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(body)});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível salvar.');
else{close('lc-user-modal');await load()}
}
function openTest(){document.getElementById('lc-test-hours').value=1;show('lc-test-modal')}
function setHours(h){document.getElementById('lc-test-hours').value=h}
async function createTest(){
const horas=Math.max(1,Number(document.getElementById('lc-test-hours').value)||1);
const limite=Math.max(1,Number(document.getElementById('lc-test-limit').value)||1);
const r=await fetch('/api/admin/usuarios/teste',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({horas,limite_conexoes:limite,valor:0})});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível criar o teste.');
else{close('lc-test-modal');await load()}
}
async function renew(id){if(!id)return;const dias=Number(prompt('Quantos dias deseja renovar?',30));if(!dias)return;await fetch('/api/admin/usuarios/renovar',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id,dias})});await load()}
async function status(id){if(!id)return;await fetch('/api/admin/usuarios/status',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
async function del(id){if(!id||!confirm('Excluir este usuário permanentemente?'))return;await fetch('/api/admin/usuarios/excluir',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
function show(id){document.getElementById(id).style.display='flex'}
function close(id){document.getElementById(id).style.display='none'}
load();setInterval(load,15000);
return{load,render,openUser,edit,saveUser,openTest,setHours,createTest,renew,status,del,show,close}
})();
</script>

</body>
</html>
