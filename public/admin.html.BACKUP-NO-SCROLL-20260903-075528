<script>
window.LC=(function(){
let users=[],editing=null;

async function load(){
try{
const r=await fetch('/api/admin/usuarios',{credentials:'same-origin'});
const j=await r.json();
users=Array.isArray(j)?j:(j.usuarios||j.users||[]);
render();
}catch(e){console.error(e)}
}

function render(){
const q=(document.getElementById('lc-search').value||'').toLowerCase();
const f=document.getElementById('lc-filter').value;
let list=users.filter(x=>{
const text=JSON.stringify(x).toLowerCase();
if(q&&!text.includes(q))return false;
const tipo=String(x.tipo||x.role||'usuario').toLowerCase();
const status=String(x.status||'').toLowerCase();
if(f==='revendedor'&&!tipo.includes('revendedor'))return false;
if(f==='teste'&&!tipo.includes('teste'))return false;
if(f==='ativo'&&!['ativo','active','1'].includes(status)&&x.ativo!==1&&x.ativo!==true)return false;
if(f==='inativo'&&(['ativo','active','1'].includes(status)||x.ativo===1||x.ativo===true))return false;
return true;
});

document.getElementById('lc-total').textContent=users.length;
document.getElementById('lc-active').textContent=users.filter(x=>['ativo','active','1'].includes(String(x.status).toLowerCase())||x.ativo===1||x.ativo===true).length;
document.getElementById('lc-tests').textContent=users.filter(x=>String(x.tipo||'').toLowerCase().includes('teste')).length;
document.getElementById('lc-expired').textContent=users.filter(x=>String(x.status||'').toLowerCase().includes('expir')).length;
document.getElementById('lc-online').textContent=users.filter(x=>x.online||x.conectado||Number(x.conexoes_utilizadas||0)>0).length;

document.getElementById('lc-body').innerHTML=list.map(x=>{
const tipo=String(x.tipo||x.role||'usuario');
const rev=tipo.toLowerCase().includes('revendedor');
const online=x.online||x.conectado||Number(x.conexoes_utilizadas||0)>0;
return `<tr>
<td><b>${esc(x.usuario||x.username||'-')}</b><br><small style="opacity:.45">${esc(x.telefone||x.whatsapp||'')}</small></td>
<td><span class="lc-badge ${online?'lc-online':''}">${online?'● ONLINE':esc(x.status||'ATIVO')}</span></td>
<td>${esc(x.validade||x.data_expiracao||x.expira_em||'-')}</td>
<td>${x.conexoes_utilizadas||0}/${x.limite_conexoes||1}</td>
<td>${esc(tipo)}</td>
<td style="white-space:nowrap">
${rev?'<span class="lc-badge">PROTEGIDO</span>':`
<button class="lc-btn" onclick='LC.edit(${JSON.stringify(x).replace(/'/g,"&#39;")})'>Editar</button>
<button class="lc-btn" onclick="LC.renew(${Number(x.id)||0})">Renovar</button>
<button class="lc-btn" onclick="LC.status(${Number(x.id)||0})">Ativar/Desativar</button>
<button class="lc-btn" onclick="LC.del(${Number(x.id)||0})">Excluir</button>`}
</td></tr>`;
}).join('');
}

function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}

function openUser(){editing=null;document.getElementById('lc-user-title').textContent='Novo Usuário';['lc-u','lc-p','lc-phone','lc-value'].forEach(id=>document.getElementById(id).value='');document.getElementById('lc-days').value=30;document.getElementById('lc-limit').value=1;document.getElementById('lc-type').value='usuario';show('lc-user-modal')}
function edit(x){editing=x;document.getElementById('lc-user-title').textContent='Editar Usuário';document.getElementById('lc-u').value=x.usuario||x.username||'';document.getElementById('lc-p').value='';document.getElementById('lc-phone').value=x.telefone||x.whatsapp||'';document.getElementById('lc-value').value=x.valor||x.valor_mensal||'';document.getElementById('lc-limit').value=x.limite_conexoes||1;document.getElementById('lc-type').value=String(x.tipo||'usuario').toLowerCase().includes('teste')?'teste':'usuario';show('lc-user-modal')}
async function saveUser(){
const body={usuario:document.getElementById('lc-u').value,senha:document.getElementById('lc-p').value,dias:Number(document.getElementById('lc-days').value)||30,tipo:document.getElementById('lc-type').value,telefone:document.getElementById('lc-phone').value,whatsapp:document.getElementById('lc-phone').value,valor:Number(document.getElementById('lc-value').value)||0,valor_mensal:Number(document.getElementById('lc-value').value)||0,limite_conexoes:Number(document.getElementById('lc-limit').value)||1};
if(editing)body.id=editing.id;
const url=editing?'/api/admin/usuarios/editar':'/api/admin/usuarios';
const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(body)});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível salvar.');
else{close('lc-user-modal');await load()}
}
function openTest(){document.getElementById('lc-test-hours').value=1;show('lc-test-modal')}
function setHours(h){document.getElementById('lc-test-hours').value=h}
async function createTest(){
const horas=Math.max(1,Number(document.getElementById('lc-test-hours').value)||1);
const limite=Math.max(1,Number(document.getElementById('lc-test-limit').value)||1);
const r=await fetch('/api/admin/usuarios/teste',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({horas,limite_conexoes:limite,valor:0})});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível criar o teste.');
else{close('lc-test-modal');await load()}
}
async function renew(id){if(!id)return;const dias=Number(prompt('Quantos dias deseja renovar?',30));if(!dias)return;await fetch('/api/admin/usuarios/renovar',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id,dias})});await load()}
async function status(id){if(!id)return;await fetch('/api/admin/usuarios/status',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
async function del(id){if(!id||!confirm('Excluir este usuário permanentemente?'))return;await fetch('/api/admin/usuarios/excluir',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
function show(id){document.getElementById(id).style.display='flex'}
function close(id){document.getElementById(id).style.display='none'}
load();setInterval(load,15000);
return{load,render,openUser,edit,saveUser,openTest,setHours,createTest,renew,status,del,show,close}
})();
</script>


<script id="LUKA-ULTRA">
(function(){
  function animateNumbers(){
    document.querySelectorAll('#LUKA-CENTRAL .lc-number').forEach(el=>{
      if(el.dataset.lkAnimated==='1') return;
      const raw=el.textContent.trim();
      const n=parseInt(raw.replace(/\D/g,''),10);
      if(!Number.isFinite(n)) return;
      el.dataset.lkAnimated='1';
      const start=performance.now();
      const duration=650;
      function frame(t){
        const p=Math.min(1,(t-start)/duration);
        const e=1-Math.pow(1-p,3);
        el.textContent=Math.round(n*e).toLocaleString('pt-BR');
        if(p<1) requestAnimationFrame(frame);
      }
      el.textContent='0';
      requestAnimationFrame(frame);
    });
  }

  function addLiveIndicator(){
    const top=document.querySelector('#LUKA-CENTRAL .lc-top');
    if(!top || top.querySelector('.lk-live-system')) return;
    const d=document.createElement('div');
    d.className='lk-live-system';
    d.innerHTML='<span></span> SISTEMA ONLINE';
    d.style.cssText='display:flex;align-items:center;gap:7px;font-size:9px;font-weight:950;letter-spacing:1.2px;color:#7f8ba3;margin-left:auto;margin-right:8px';
    d.querySelector('span').style.cssText='width:7px;height:7px;border-radius:50%;background:#27e889;box-shadow:0 0 14px #27e889;animation:lkLive 1.5s infinite';
    top.appendChild(d);
  }

  function reveal(){
    document.querySelectorAll('#LUKA-CENTRAL .lc-card,#LUKA-CENTRAL .lc-panel').forEach((el,i)=>{
      if(el.dataset.lkReveal==='1') return;
      el.dataset.lkReveal='1';
      el.style.opacity='0';
      el.style.transform='translateY(12px)';
      setTimeout(()=>{
        el.style.transition='opacity .45s ease,transform .45s ease';
        el.style.opacity='1';
        el.style.transform='none';
      },60+i*45);
    });
  }

  setTimeout(()=>{
    addLiveIndicator();
    reveal();
    animateNumbers();
  },120);

  new MutationObserver(()=>{
    addLiveIndicator();
    animateNumbers();
  }).observe(document.body,{childList:true,subtree:true});
})();
</script>

<script id="LUKA-FUNCTIONAL-NAV">
(function(){

let activeFilter='all';

function findUserRows(){
  return [...document.querySelectorAll('#LUKA-CENTRAL tbody tr')];
}

function getRowText(row){
  return (row.innerText||row.textContent||'').toLowerCase();
}

function filterUsers(filter){

  activeFilter=filter;

  const rows=findUserRows();

  rows.forEach(row=>{
    let show=true;
    const text=getRowText(row);

    if(filter==='online'){
      show=/online|conectado|🟢/.test(text);
    }

    if(filter==='active'){
      show=/ativo|ativa|🟢/.test(text) && !/expirado|inativo/.test(text);
    }

    if(filter==='tests'){
      show=/teste|test/.test(text);
    }

    if(filter==='expired'){
      show=/expirado|vencido|inativo/.test(text);
    }

    if(filter==='all'){
      show=true;
    }

    row.style.display=show?'':'none';
  });

  document.querySelectorAll('#LUKA-CENTRAL .lc-card[data-filter]')
    .forEach(c=>c.classList.toggle('lk-filter-active',
      c.dataset.filter===filter));

  const label=document.querySelector('#lk-active-filter');

  if(label){
    const names={
      all:'Todos os usuários',
      online:'Usuários online',
      active:'Usuários ativos',
      tests:'Testes ativos',
      expired:'Usuários expirados'
    };
    label.textContent=names[filter]||'Todos os usuários';
  }

  const visible=rows.filter(r=>r.style.display!=='none');

  let empty=document.querySelector('#lk-filter-empty');

  if(!visible.length){

    if(!empty){
      empty=document.createElement('div');
      empty.id='lk-filter-empty';
      empty.className='lk-empty';
      empty.innerHTML='Nenhum usuário encontrado neste filtro.';
      const table=document.querySelector('#LUKA-CENTRAL table');
      if(table && table.parentElement)
        table.parentElement.appendChild(empty);
    }

    empty.style.display='block';

  }else if(empty){

    empty.style.display='none';

  }

  const panel=document.querySelector('#LUKA-CENTRAL .lc-panel');
  if(panel) panel.scrollIntoView({behavior:'smooth',block:'start'});
}

function findCardByFilter(filter){
  return document.querySelector(
    '#LUKA-CENTRAL .lc-card[data-filter="'+filter+'"]'
  );
}

function prepareCards(){

  const numbers=[...document.querySelectorAll('#LUKA-CENTRAL .lc-number')];

  numbers.forEach(number=>{

    const card=number.closest('.lc-card');
    if(!card || card.dataset.lkBound==='1') return;

    const label=(card.innerText||'').toLowerCase();

    let filter='all';

    if(label.includes('online')) filter='online';
    else if(label.includes('teste')) filter='tests';
    else if(label.includes('expir')) filter='expired';
    else if(label.includes('ativo')) filter='active';
    else if(label.includes('usuário') || label.includes('usuarios'))
      filter='all';

    card.dataset.filter=filter;
    card.dataset.lkBound='1';

    card.addEventListener('click',function(e){
      e.preventDefault();
      e.stopPropagation();
      filterUsers(filter);
    });

    card.addEventListener('touchend',function(e){
      e.preventDefault();
      filterUsers(filter);
    },{passive:false});

  });
}

function installNavigation(){

  const top=document.querySelector('#LUKA-CENTRAL .lc-top');
  if(!top || top.querySelector('.lk-navigation')) return;

  const nav=document.createElement('div');
  nav.className='lk-navigation';

  nav.innerHTML=`
    <button type="button" class="lk-filmes" id="lk-voltar-filmes">
      🎬 Filmes
    </button>
    <button type="button" class="lk-sair" id="lk-sair-total">
      🚪 Sair
    </button>
  `;

  top.insertBefore(nav,top.firstChild);

  document
    .querySelector('#lk-voltar-filmes')
    .addEventListener('click',()=>{
      window.location.href='/';
    });

  document
    .querySelector('#lk-sair-total')
    .addEventListener('click',async()=>{

      try{

        await fetch('/api/logout',{
          method:'POST',
          credentials:'include'
        });

      }catch(e){}

      window.location.href='/login.html';

    });

}

function installFilterHeader(){

  const panel=document.querySelector('#LUKA-CENTRAL .lc-panel');
  if(!panel || document.querySelector('#lk-active-filter')) return;

  const toolbar=panel.querySelector('.lc-toolbar');

  if(toolbar){

    const label=document.createElement('span');
    label.id='lk-active-filter';
    label.className='lk-filter-label';
    label.textContent='Todos os usuários';

    toolbar.appendChild(label);

  }

}

function installRefresh(){

  const buttons=[...document.querySelectorAll('#LUKA-CENTRAL button')];

  buttons.forEach(btn=>{

    const text=(btn.innerText||'').toLowerCase();

    if(
      text.includes('atualizar') ||
      text.includes('refresh')
    ){

      if(btn.dataset.lkRefresh==='1') return;

      btn.dataset.lkRefresh='1';

      btn.addEventListener('click',()=>{
        activeFilter='all';
        setTimeout(()=>{
          prepareCards();
          filterUsers('all');
        },300);
      });

    }

  });

}

function boot(){

  installNavigation();
  installFilterHeader();
  prepareCards();
  installRefresh();

}

boot();

setTimeout(boot,300);
setTimeout(boot,1000);
setTimeout(boot,2000);

new MutationObserver(()=>{
  installNavigation();
  installFilterHeader();
  prepareCards();
  installRefresh();

  if(activeFilter!=='all'){
    setTimeout(()=>filterUsers(activeFilter),50);
  }

}).observe(document.body,{
  childList:true,
  subtree:true
});

})();
</script>
</body>
