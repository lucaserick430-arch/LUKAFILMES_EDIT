<body>

<div id="fundoTrailer">
    <iframe
        src="https://www.youtube.com/embed/c51ND9Hdbw0?autoplay=1&mute=1&controls=0&loop=1&playlist=c51ND9Hdbw0&modestbranding=1&rel=0"
        allow="autoplay; fullscreen"
        frameborder="0">
    </iframe>
</div>

<div id="escuro"></div>


<div class="login">

    <div class="premium-entrada">

        <div class="premium-logo">
            <span>LUKA</span><b>FILMES</b>
        </div>

        <div class="premium-linha"></div>

        <div class="premium-kicker">
            UMA NOVA EXPERIÊNCIA DE ENTRETENIMENTO
        </div>

        <h1>
            Sua próxima história<br>
            <strong>começa agora.</strong>
        </h1>

        <p class="premium-subtitulo">
            Filmes, séries e grandes histórias.<br>
            Tudo em um só lugar.
        </p>

        <form id="loginForm">

        <div class="premium-tags">
            <span>FILMES</span>
            <i></i>
            <span>SÉRIES</span>
            <i></i>
            <span>ENTRETENIMENTO</span>
        </div>

        <div class="premium-login-campos">

            <input
            id="usuario"
            type="text"
            placeholder="Usuário"
            autocomplete="username"
            required
        >

            <input
            id="senha"
            type="password"
            placeholder="Senha"
            autocomplete="current-password"
            required
        >

        </div>

        <button id="botaoEntrar" type="button">
            <span class="icone-play">▶</span>
            <span>COMEÇAR A ASSISTIR</span>
        </button>

        <div id="mensagem"></div>

        <div class="premium-mensagem">
            Explore o catálogo e descubra seu próximo filme.
        </div>

        </form>

    </div>

</div>





<div id="lukafilmesLoginLoader" aria-hidden="true">
    <div id="lukafilmesLoginLoaderBox">
        <div id="lukafilmesLoginLoaderLogo">
            <span class="luka">LUKA</span><span class="filmes">FILMES</span>
        </div>
        <div id="lukafilmesLoginLoaderSpinner"></div>
        <h2 id="lukafilmesLoginLoaderTitle">Entrando no LUKAFILMES...</h2>
        <p id="lukafilmesLoginLoaderText">Preparando sua sessão...</p>
    </div>
</div>



<script id="lukafilmes-login-funcional">
document
        .getElementById("loginForm")
        .addEventListener("submit", async function(event) {

            event.preventDefault();

            const usuario =
                document.getElementById("usuario").value.trim();

            const senha =
                document.getElementById("senha").value;

            const mensagem =
                document.getElementById("mensagem");

            const botao =
                document.getElementById("botaoEntrar");

            mensagem.textContent = "";
            botao.disabled = true;
            botao.textContent = "ENTRANDO...";

            try {

                const resposta = await fetch(
                    "/login",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            usuario,
                            senha
                        })
                    }
                );

                const dados = await resposta.json();

                if (dados.sucesso) {

                    window.location.href = dados.destino || "/";

                } else {

                    mensagem.textContent =
                        dados.mensagem ||
                        "Usuário ou senha incorretos.";

                }

            } catch (erro) {

                console.error(
                    "Erro no login:",
                    erro
                );

                mensagem.textContent =
                    "Não foi possível conectar ao servidor.";

            } finally {

                botao.disabled = false;
                botao.textContent = "ENTRAR";

            }

        });
</script>

<script id="lukafilmes-login-loader-js">
(function(){

    var loader = document.getElementById("lukafilmesLoginLoader");
    var form = document.getElementById("loginForm");

    function mostrarLoginLoader(){
        if(!loader)return;
        loader.classList.add("ativo");
        loader.setAttribute("aria-hidden","false");
    }

    function esconderLoginLoader(){
        if(!loader)return;
        loader.classList.remove("ativo");
        loader.setAttribute("aria-hidden","true");
    }

    window.lukafilmesMostrarLoginLoader = mostrarLoginLoader;
    window.lukafilmesEsconderLoginLoader = esconderLoginLoader;

    if(form){
        form.addEventListener("submit",function(){
            mostrarLoginLoader();
        },true);
    }

    window.addEventListener("pageshow",function(){
        esconderLoginLoader();
    });

})();
</script>




