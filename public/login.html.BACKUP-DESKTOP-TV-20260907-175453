<style>

    #fundoTrailer {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: -3;
        background: #000;
    }

    #fundoTrailer iframe {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 120vw;
        height: 67.5vw;
        min-width: 177.78vh;
        min-height: 100vh;
        transform: translate(-50%, -50%) scale(1.12);
        border: 0;
        pointer-events: none;
    }

    #escuro {
        position: fixed;
        inset: 0;
        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.88),
                rgba(0,0,0,.58),
                rgba(0,0,0,.88)
