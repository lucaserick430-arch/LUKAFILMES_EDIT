                label:"TESTES DISPONÍVEIS"
            },

            revendedores:{
                icon:"🤝",
                titulo:"Central de Revendedores",
                subtitulo:"Gerencie parceiros e conexões",
                label:"REVENDEDORES"
            },

            online:{
                icon:"🟢",
                titulo:"Central Online",
                subtitulo:"Acompanhe a presença em tempo real",
                label:"CONECTADOS AGORA"
            }

        };

        return configs[tipo] || configs.usuarios;
    }

    function render(tipo){

        const lista=dados(tipo);
        const c=config(tipo);

        const total=lista.length;
        const ativos=lista.filter(u=>
            String(u.status||"ativo").toLowerCase()==="ativo"
        ).length;

        const suspensos=lista.filter(u=>
            String(u.status||"ativo").toLowerCase()==="suspenso"
        ).length;

        const online=lista.filter(u=>u.online).length;

        document.getElementById("lukaCentralTitulo").textContent=
            c.titulo;

        document.getElementById("lukaCentralSubtitulo").textContent=
            c.subtitulo;

        const body=document.getElementById("lukaCentralBody");

        body.innerHTML=`

            <div class="luka-central-hero">

                <div class="luka-central-main">

                    <div class="luka-central-icon">
                        ${c.icon}
                    </div>

                    <h2>${c.titulo}</h2>

                    <p>${c.subtitulo}</p>

                    <div class="luka-central-total">
                        ${total}
                        <small>${c.label}</small>
                    </div>

                </div>

                <div class="luka-central-side">

                    <small>ATIVIDADE ONLINE</small>

                    <strong>
                        ${online}
                        <span style="
                            color:#777;
                            font-size:12px;
                            font-weight:600;
                        "> conectados</span>
                    </strong>

                </div>

            </div>

            <div class="luka-central-stats">

                <div class="luka-central-stat">
                    <small>Total</small>
                    <strong>${total}</strong>
                </div>

                <div class="luka-central-stat">
                    <small>Ativos</small>
                    <strong>${ativos}</strong>
                </div>

                <div class="luka-central-stat">
                    <small>Suspensos</small>
                    <strong>${suspensos}</strong>
                </div>

            </div>

            <input
                class="luka-central-search"
                id="lukaCentralBusca"
                placeholder="🔎 Pesquisar nesta central..."
                autocomplete="off"
            >

            <div class="luka-central-list">

                <div class="luka-central-list-head">
                    <strong>Contas</strong>
                    <span>${total} registros</span>
                </div>

                <div id="lukaCentralLista"></div>

            </div>
        `;

        const busca=document.getElementById("lukaCentralBusca");

        function atualizarLista(){

            const q=(busca.value||"").toLowerCase();

            const filtrada=lista.filter(u=>
                String(u.usuario||"")
                    .toLowerCase()
                    .includes(q)
            );

            const el=document.getElementById("lukaCentralLista");

            if(!filtrada.length){
                el.innerHTML=`
                    <div class="luka-central-empty">
                        🔎 Nenhuma conta encontrada.
                    </div>
                `;
                return;
            }

            el.innerHTML=filtrada.slice(0,100).map(u=>{

                const nome=String(u.usuario||"—");
                const inicial=nome.charAt(0).toUpperCase();

                const isOnline=!!u.online;

                let detalhe=
                    String(u.tipo||"usuario").toUpperCase();

                if(u.validade){
                    const d=new Date(u.validade);

                    if(!Number.isNaN(d.getTime())){
                        detalhe+=" • expira "+
                            d.toLocaleDateString("pt-BR");
                    }
                }

                return `

                    <div
                        class="luka-central-user"
                        onclick="lukaAbrirContaCentral(${Number(u.id)})"
                        style="cursor:pointer"
                    >

                        <div class="luka-central-avatar">
                            ${esc(inicial)}
                        </div>

                        <div class="luka-central-user-info">

                            <strong>${esc(nome)}</strong>

                            <span>${esc(detalhe)}</span>

                        </div>

                        <div class="
                            luka-central-user-status
                            ${isOnline ? "online" : "offline"}
                        ">
                            ${isOnline ? "● ONLINE" : "○ OFFLINE"}
                        </div>

                    </div>

                `;

            }).join("");
        }

        busca.addEventListener("input",atualizarLista);

        atualizarLista();
    }

    window.lukaAbrirCentral=function(tipo){

        criarCentral();

        render(tipo);

        const overlay=document.getElementById(
            "lukaCentralOverlay"
        );

        overlay.classList.add("show");

        centralAberta=true;

        document.body.style.overflow="hidden";
    };

    window.lukaFecharCentral=function(){

        const overlay=document.getElementById(
            "lukaCentralOverlay"
        );

        if(overlay){
            overlay.classList.remove("show");
        }

        centralAberta=false;

        document.body.style.overflow="";
    };

    window.lukaAbrirContaCentral=function(id){

        lukaFecharCentral();

        setTimeout(function(){

            if(typeof abrirContaDetalhes==="function"){
                abrirContaDetalhes(id);
            }

        },180);
    };

    function ligarCards(){

        const mapa={

            usuarios:"👤",
            testes:"🧪",
            revendedores:"🤝",
            online:"🟢"

        };

        document.querySelectorAll(
            ".clickable-card"
        ).forEach(card=>{

            if(card.dataset.lukaCentral==="1") return;

            const texto=card.innerText.toLowerCase();

            let tipo=null;

            if(texto.includes("usuário") ||
               texto.includes("usuarios") ||
               texto.includes("usuários")){
                tipo="usuarios";
            }

            else if(texto.includes("teste")){
                tipo="testes";
            }

            else if(texto.includes("revendedor")){
                tipo="revendedores";
            }

            else if(texto.includes("online")){
                tipo="online";
            }

            if(!tipo) return;

            card.dataset.lukaCentral="1";

            card.setAttribute(
                "role",
                "button"
            );

            card.setAttribute(
                "tabindex",
                "0"
            );

            card.onclick=function(e){

                e.preventDefault();
                e.stopPropagation();

                lukaAbrirCentral(tipo);
            };

            card.onkeydown=function(e){

                if(e.key==="Enter" ||
                   e.key===" "){

                    e.preventDefault();

                    lukaAbrirCentral(tipo);
                }
            };

            const hint=
                card.querySelector(".card-hint");

            if(hint){
                hint.textContent="Abrir central →";
            }

        });
    }

    function iniciar(){

        ligarCards();

        setTimeout(ligarCards,500);
        setTimeout(ligarCards,1500);
        setTimeout(ligarCards,3000);
    }

    if(document.readyState==="loading"){
        document.addEventListener(
            "DOMContentLoaded",
            iniciar,
            {once:true}
        );
    }else{
        iniciar();
    }

})();

</script>

