<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta id="lukafilmes-admin-no-cache" http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>LUKAFILMES • ADMIN</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#050505;--card:#0d0d0f;--card2:#151517;--line:#27272a;--text:#ffffff;--muted:#929292;--blue:#e50914;--green:#e50914;--red:#e50914;--yellow:#e50914}
body{
 font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;
 background:
 radial-gradient(circle at 80% 0%,rgba(91,140,255,.18),transparent 30%),
 radial-gradient(circle at 0% 100%,rgba(53,217,255,.08),transparent 30%),
 var(--bg);
 color:var(--text);
 min-height:100vh;
}
button,input,select{font:inherit}
button{cursor:pointer;border:0}
.app{display:flex;min-height:100vh}
.sidebar{
 width:255px;
 position:fixed;
 inset:0 auto 0 0;
 background:rgba(7,12,27,.88);
 backdrop-filter:blur(20px);
 border-right:1px solid var(--line);
 padding:22px 15px;
 z-index:20;
}
.logo{
 font-size:24px;
 font-weight:900;
 letter-spacing:-1px;
 padding:15px;
 margin-bottom:28px;
 cursor:pointer;
 user-select:none;
}
.logo span{
 color:var(--blue);
 text-shadow:0 0 25px rgba(91,140,255,.6);
}
.nav{display:grid;gap:8px}
.nav button{
 width:100%;
 text-align:left;
 padding:14px 16px;
 border-radius:13px;
 background:transparent;
 color:#aeb8cb;
 transition:.25s;
 font-weight:700;
}
.nav button:hover,.nav button.active{
 background:linear-gradient(90deg,rgba(91,140,255,.18),rgba(91,140,255,.04));
 color:#fff;
 transform:translateX(3px);
}
.main{
 margin-left:255px;
 width:calc(100% - 255px);
 padding:28px;
}
.top{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
 margin-bottom:28px;
}
.title h1{font-size:31px;letter-spacing:-1px}
.title p{color:var(--muted);margin-top:5px}
.online{
 padding:9px 13px;
 border-radius:999px;
 background:rgba(32,212,154,.1);
 color:var(--green);
 font-size:12px;
 font-weight:900;
}
.cards{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:16px;
}
.card{
 background:linear-gradient(145deg,rgba(16,25,45,.96),rgba(9,15,29,.96));
 border:1px solid var(--line);
 border-radius:20px;
 padding:21px;
 box-shadow:var(--shadow);
 animation:up .5s ease both;
}
.card small{color:var(--muted);font-weight:800}
.num{font-size:36px;font-weight:900;margin-top:12px}
.blue{color:var(--blue)}
.green{color:var(--green)}
.yellow{color:var(--yellow)}
.red{color:var(--red)}
.section{display:none}
.section.active{display:block;animation:fade .3s ease}
.panel{
 margin-top:20px;
 background:rgba(11,17,32,.9);
 border:1px solid var(--line);
 border-radius:20px;
 overflow:hidden;
 box-shadow:var(--shadow);
}
.panelHead{
 padding:18px;
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:12px;
 border-bottom:1px solid var(--line);
}
.panelHead h2{font-size:18px}
.tools{display:flex;gap:8px;flex-wrap:wrap}
input,select{
 background:#080f1f;
 color:#fff;
 border:1px solid var(--line);
 border-radius:11px;
 padding:11px 13px;
 outline:none;
}
input:focus,select:focus{border-color:var(--blue)}
.btn{
 padding:11px 15px;
 border-radius:11px;
 color:#fff;
 font-weight:800;
 background:#18243b;
 transition:.2s;
}
.btn:hover{transform:translateY(-1px)}
.btn.primary{background:linear-gradient(135deg,#5b8cff,#416ce0)}
.btn.green{background:linear-gradient(135deg,#20d49a,#159d77)}
.btn.red{background:linear-gradient(135deg,#ff5575,#d93859)}
.btn.yellow{background:linear-gradient(135deg,#ffc857,#e3a62e);color:#161108}
.tableWrap{overflow:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{
 padding:15px 17px;
 border-bottom:1px solid rgba(29,41,66,.7);
 text-align:left;
 white-space:nowrap;
}
th{font-size:11px;color:var(--muted);text-transform:uppercase}
td{font-size:14px}
.badge{
 display:inline-flex;
 align-items:center;
 gap:6px;
 padding:6px 9px;
 border-radius:999px;
 font-size:11px;
 font-weight:900;
}
.badge.active{background:rgba(32,212,154,.1);color:var(--green)}
.badge.off{background:rgba(255,85,117,.1);color:var(--red)}
.actions{display:flex;gap:6px}
.actions button{padding:7px 9px;border-radius:8px;color:#fff;background:#17233a}
.empty{text-align:center;color:var(--muted);padding:35px}
.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.72);
 backdrop-filter:blur(8px);
 display:none;
 align-items:center;
 justify-content:center;
 padding:20px;
 z-index:100;
}
.modal.show{display:flex}
.box{
 width:min(480px,100%);
 background:#0c1426;
 border:1px solid var(--line);
 border-radius:22px;
 padding:22px;
 box-shadow:0 30px 100px rgba(0,0,0,.6);
 animation:pop .25s ease;
}
.box h2{margin-bottom:18px}
.form{display:grid;gap:11px}
.form label{font-size:12px;color:var(--muted);font-weight:800}
.form input,.form select{width:100%}
.modalActions{display:flex;gap:8px;margin-top:17px}
.modalActions button{flex:1}
.toast{
 position:fixed;
 right:20px;
 bottom:20px;
 background:#111d32;
 border:1px solid var(--line);
 color:#fff;
 padding:14px 17px;
 border-radius:13px;
 box-shadow:var(--shadow);
 transform:translateY(30px);
 opacity:0;
 pointer-events:none;
 transition:.25s;
 z-index:200;
}
.toast.show{transform:none;opacity:1}
.chart{
 display:grid;
 grid-template-columns:repeat(12,1fr);
 align-items:end;
 height:150px;
 gap:9px;
 padding:20px;
}
.bar{
 background:linear-gradient(180deg,var(--blue),#27479e);
 border-radius:8px 8px 3px 3px;
 min-height:8px;
 animation:grow .7s ease;
}
.quick{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:12px;
 padding:20px;
}
.quick .btn{padding:18px}
@keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
@keyframes up{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:none}}
@keyframes grow{from{height:0}}
@media(max-width:900px){
 .sidebar{width:75px;padding:15px 8px}
 .logo{font-size:0;text-align:center}
 .logo:before{content:"L";font-size:28px;color:var(--blue)}
 .nav button{font-size:0;text-align:center;padding:14px 5px}
 .nav button::first-letter{font-size:20px}
 .main{margin-left:75px;width:calc(100% - 75px);padding:18px}
 .cards{grid-template-columns:repeat(2,1fr)}
 .quick{grid-template-columns:1fr}
}
@media(max-width:560px){
 .cards{grid-template-columns:1fr 1fr;gap:9px}
 .card{padding:14px}
 .num{font-size:27px}
 .top{align-items:flex-start}
 .title h1{font-size:25px}
 .panelHead{align-items:flex-start;flex-direction:column}
}
</style>

<style id="admin-clickable-cards">
.clickable-card{
    cursor:pointer;
    position:relative;
    transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
}
.clickable-card:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 35px rgba(0,0,0,.28);
    border-color:rgba(91,140,255,.65);
}
.clickable-card:active{
    transform:scale(.98);
}
.card-hint{
    display:block;
    margin-top:8px;
    font-size:11px;
    color:var(--muted);
    opacity:.8;
}
</style>

<style id="admin-back-button">
.admin-back{
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-bottom:18px;
    padding:10px 16px;
    border:1px solid var(--line);
    border-radius:12px;
    background:var(--card2);
    color:var(--text);
    cursor:pointer;
    font-weight:600;
    transition:.2s;
}
.admin-back:hover{
    transform:translateX(-3px);
    border-color:var(--blue);
    box-shadow:0 8px 25px rgba(0,0,0,.2);
}
</style>



<style id="luka-black-red-theme">

html{
    background:#050505;
}

body{
    font-family:Inter,system-ui,Arial,sans-serif;
    background:
        radial-gradient(circle at 90% 0%,rgba(229,9,20,.16),transparent 28%),
        radial-gradient(circle at 0% 100%,rgba(229,9,20,.07),transparent 30%),
        #050505;
    color:#fff;
}

/* SIDEBAR */
.sidebar{
    background:linear-gradient(180deg,#090909 0%,#050505 100%)!important;
    border-right:1px solid #202020!important;
    box-shadow:8px 0 35px rgba(0,0,0,.45);
}

.logo{
    color:#fff!important;
    font-weight:900;
    letter-spacing:-1px;
    cursor:pointer;
    transition:.25s;
}

.logo span{
    color:#e50914!important;
}

.logo:hover{
    text-shadow:0 0 20px rgba(229,9,20,.5);
}

/* MENU */
.nav button{
    color:#a8a8a8!important;
    background:transparent!important;
    border:1px solid transparent!important;
    border-radius:12px!important;
    transition:.22s ease!important;
}

.nav button:hover{
    color:#fff!important;
    background:#151515!important;
    border-color:#292929!important;
    transform:translateX(4px);
}

.nav button.active{
    color:#fff!important;
    background:linear-gradient(135deg,#e50914,#a8070f)!important;
    border-color:#e50914!important;
    box-shadow:
        0 8px 25px rgba(229,9,20,.25),
        inset 0 1px rgba(255,255,255,.12);
}

/* CONTEÚDO */
.main{
    background:transparent!important;
}

/* CARDS */
.card{
    position:relative;
    overflow:hidden;
    background:linear-gradient(145deg,#111113,#0b0b0c)!important;
    border:1px solid #242426!important;
    border-radius:18px!important;
    box-shadow:0 12px 35px rgba(0,0,0,.35)!important;
    transition:.25s ease!important;
}

.card::before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:2px;
    background:linear-gradient(90deg,transparent,#e50914,transparent);
    opacity:.55;
}

.card:hover{
    transform:translateY(-5px);
    border-color:rgba(229,9,20,.45)!important;
    box-shadow:
        0 18px 45px rgba(0,0,0,.55),
        0 0 25px rgba(229,9,20,.08)!important;
}

/* NÚMEROS */
.num,
.num.blue,
.num.green,
.num.red,
.num.yellow{
    color:#e50914!important;
    text-shadow:0 0 18px rgba(229,9,20,.28);
}

/* ONLINE */
.online{
    color:#ff3340!important;
    text-shadow:0 0 12px rgba(229,9,20,.35);
}

/* CARDS CLICÁVEIS */
.clickable-card{
    cursor:pointer;
}

.clickable-card:hover{
    border-color:#e50914!important;
    box-shadow:
        0 18px 45px rgba(0,0,0,.55),
        0 0 30px rgba(229,9,20,.12)!important;
}

.card-hint{
    color:#777!important;
}

/* BOTÃO VOLTAR */
.admin-back{
    background:#111!important;
    color:#fff!important;
    border:1px solid #292929!important;
    box-shadow:0 8px 25px rgba(0,0,0,.3);
}

.admin-back:hover{
    background:#e50914!important;
    color:#fff!important;
    border-color:#e50914!important;
    box-shadow:0 8px 25px rgba(229,9,20,.25);
}

/* INPUTS */
input,
select,
textarea{
    background:#0d0d0f!important;
    color:#fff!important;
    border:1px solid #292929!important;
    border-radius:10px!important;
}

input::placeholder,
textarea::placeholder{
    color:#666!important;
}

input:focus,
select:focus,
textarea:focus{
    outline:none!important;
    border-color:#e50914!important;
    box-shadow:0 0 0 3px rgba(229,9,20,.12)!important;
}

/* MODAIS */
.modal{
    background:rgba(0,0,0,.78)!important;
    backdrop-filter:blur(9px);
}

.modal>div,
.modal .modal-content{
    background:linear-gradient(145deg,#151517,#090909)!important;
    color:#fff!important;
    border:1px solid #292929!important;
    box-shadow:
        0 30px 100px rgba(0,0,0,.75),
        0 0 40px rgba(229,9,20,.08)!important;
}

/* BOTÕES */
button{
    transition:.2s ease;
}

button:active{
    transform:scale(.97);
}

/* DESTAQUE VERMELHO */
button[type="submit"]{
    background:linear-gradient(135deg,#e50914,#a8070f)!important;
    color:#fff!important;
    border-color:#e50914!important;
    box-shadow:0 7px 22px rgba(229,9,20,.20);
}

button[type="submit"]:hover{
    box-shadow:0 10px 30px rgba(229,9,20,.35);
    transform:translateY(-2px);
}

/* ANIMAÇÃO */
@keyframes lukaGlow{
    0%,100%{
        box-shadow:0 0 0 0 rgba(229,9,20,0);
    }
    50%{
        box-shadow:0 0 20px rgba(229,9,20,.12);
    }
}

.online{
    animation:lukaGlow 2.5s infinite;
}

</style>

<style id="luka-online-modern">
.online{
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:800;
    letter-spacing:1px;
    color:#fff;
    text-shadow:0 0 10px rgba(255,0,55,.8);
}

.online-dot{
    color:#ff1744;
    font-size:18px;
    animation:lukaOnlinePulse 1.2s infinite ease-in-out;
}

@keyframes lukaOnlinePulse{
    0%,100%{
        color:#ff1744;
        opacity:1;
        transform:scale(1);
        text-shadow:0 0 5px #ff1744;
    }
    50%{
        color:#fff;
        opacity:.65;
        transform:scale(1.35);
        text-shadow:0 0 18px #fff;
    }
}
</style>








<style id="admin-profile-avatar">
.logo{
    position:relative;
    overflow:hidden;
}
.logo-avatar{
    width:42px;
    height:42px;
    border-radius:50%;
    object-fit:cover;
    display:none;
    vertical-align:middle;
    margin-right:8px;
    border:2px solid #e50914;
    box-shadow:0 0 18px rgba(229,9,20,.45);
}
.logo-avatar.has-photo{
    display:inline-block;
}
.profile-upload{
    display:none;
}
@media(max-width:900px){
    .logo{
        width:52px;
        height:52px;
        padding:5px!important;
        display:flex;
        align-items:center;
        justify-content:center;
    }
    .logo:before{
        display:none!important;
    }
    .logo-avatar{
        width:42px;
        height:42px;
        margin:0;
    }
}
</style>


<style id="no-zoom-panel">
html,body{
    touch-action:pan-x pan-y;
    overscroll-behavior-x:none;
}
*{
    -webkit-tap-highlight-color:transparent;
}
input,select,textarea{
    font-size:16px!important;
}
</style>


<style id="lukafilmes-loader-global">
#lukaLoaderOverlay{
    position:fixed;
    inset:0;
    z-index:9999999;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(0,0,0,.94);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    opacity:1;
    visibility:visible;
    pointer-events:auto;
    transition:
        opacity .28s ease,
        visibility .28s ease;
}

#lukaLoaderOverlay.luka-loader-oculto{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}

#lukaLoaderBox{
    width:min(540px,88vw);
    min-height:340px;
    box-sizing:border-box;
    border:1px solid #292929;
    border-radius:18px;
    background:#030303;
    box-shadow:0 25px 80px rgba(0,0,0,.8);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:42px 30px;
    text-align:center;
}

#lukaLoaderLogo{
    font-family:Arial,Helvetica,sans-serif;
    font-size:34px;
    font-weight:900;
    letter-spacing:-1.8px;
    margin-bottom:32px;
    line-height:1;
    text-transform:uppercase;
}

#lukaLoaderLogo .luka{
    color:#fff;
}

#lukaLoaderLogo .filmes{
    color:#e50914;
}

#lukaLoaderSpinner{
    width:58px;
    height:58px;
    border-radius:50%;
    border:7px solid #242424;
    border-top-color:#e50914;
    border-right-color:#e50914;
    box-sizing:border-box;
    animation:lukaLoaderSpin .85s linear infinite;
    margin-bottom:27px;
}

#lukaLoaderTitle{
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    font-size:20px;
    font-weight:700;
    margin:0 0 10px;
}

#lukaLoaderText{
    color:#858585;
    font-family:Arial,Helvetica,sans-serif;
    font-size:16px;
    margin:0;
}

@keyframes lukaLoaderSpin{
    to{transform:rotate(360deg)}
}

@media(max-width:600px){
    #lukaLoaderBox{
        width:88vw;
        min-height:300px;
        padding:35px 22px;
        border-radius:16px;
    }

    #lukaLoaderLogo{
        font-size:30px;
        margin-bottom:28px;
    }

    #lukaLoaderSpinner{
        width:52px;
        height:52px;
        border-width:6px;
        margin-bottom:24px;
    }

    #lukaLoaderTitle{
        font-size:18px;
    }

    #lukaLoaderText{
        font-size:14px;
    }
}
</style>


<style id="luka-conta-detalhes">
#lukaContaOverlay{
    position:fixed;
    inset:0;
    z-index:9999998;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(0,0,0,.82);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
}

#lukaContaOverlay.show{
    display:flex;
}

#lukaContaBox{
    width:min(620px,100%);
    max-height:90vh;
    overflow:auto;
    background:#0b0b0b;
    border:1px solid #292929;
    border-radius:20px;
    box-shadow:0 25px 90px rgba(0,0,0,.85);
    color:#fff;
    animation:lukaContaEntrada .22s ease;
}

@keyframes lukaContaEntrada{
    from{
        opacity:0;
        transform:translateY(15px) scale(.98);
    }
    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

.luka-conta-head{
    padding:22px;
    border-bottom:1px solid #242424;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}

.luka-conta-head h2{
    margin:0;
    font-size:21px;
}

.luka-conta-close{
    width:38px;
    height:38px;
    border:1px solid #333;
    border-radius:10px;
    background:#171717;
    color:#fff;
    font-size:20px;
    cursor:pointer;
}

.luka-conta-close:hover{
    background:#e50914;
    border-color:#e50914;
}

.luka-conta-body{
    padding:22px;
}

.luka-conta-user{
    padding:18px;
    border-radius:15px;
    background:linear-gradient(135deg,#171717,#0d0d0d);
    border:1px solid #292929;
    margin-bottom:18px;
}

.luka-conta-user strong{
    display:block;
    font-size:23px;
    margin-bottom:7px;
}

.luka-conta-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
}

.luka-conta-item{
    padding:14px;
    border:1px solid #252525;
    border-radius:12px;
    background:#111;
}

.luka-conta-item small{
    display:block;
    color:#777;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    margin-bottom:6px;
}

.luka-conta-item span{
    font-size:15px;
    font-weight:700;
    word-break:break-word;
}

.luka-conta-expira{
    margin-top:14px;
    padding:16px;
    border-radius:13px;
    border:1px solid rgba(229,9,20,.35);
    background:rgba(229,9,20,.07);
}

.luka-conta-expira small{
    display:block;
    color:#999;
    margin-bottom:5px;
}

.luka-conta-expira strong{
    color:#fff;
    font-size:17px;
}

.luka-conta-acoes{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:9px;
    margin-top:18px;
}

.luka-conta-acoes button{
    min-height:45px;
    border:1px solid #333;
    border-radius:10px;
    background:#171717;
    color:#fff;
    cursor:pointer;
    font-weight:700;
}

.luka-conta-acoes button:hover{
    background:#e50914;
    border-color:#e50914;
}

@media(max-width:600px){
    #lukaContaOverlay{
        padding:10px;
    }

    #lukaContaBox{
        max-height:94vh;
        border-radius:16px;
    }

    .luka-conta-grid{
        grid-template-columns:1fr;
