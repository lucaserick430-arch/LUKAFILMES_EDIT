<script>
(function(){

window.LUKA_TESTE_TEXTO = "";

window.LUKA_MOSTRAR_RESULTADO_TESTE = function(testes){

    if(!Array.isArray(testes) || !testes.length){
        return;
    }

    var blocos = [];

    testes.forEach(function(t, i){

        var validade = t.validade || "";

        try {
            validade = new Date(validade).toLocaleString("pt-BR");
        } catch(e) {}

        blocos.push(
            '<div style="padding:16px;margin-bottom:12px;border-radius:14px;' +
            'background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);">' +

            '<div style="font-weight:800;margin-bottom:10px;">' +
            '🎬 TESTE ' + (testes.length > 1 ? (i + 1) : '') +
            '</div>' +

            '<div>👤 <b>Usuário:</b> ' +
            String(t.usuario || '') +
            '</div>' +

            '<div>🔑 <b>Senha:</b> ' +
            String(t.senha || '') +
            '</div>' +

            '<div>⏱️ <b>Expira em:</b> ' +
            validade +
            '</div>' +

            '</div>'
        );
    });

    var texto =
`🎉 TESTE CRIADO COM SUCESSO!

🎬 SEJA BEM-VINDO À LUKAFILMES!

🍿 Aproveite bastante o teste gratuito.
Teste filmes e séries à vontade, explore a plataforma e conheça tudo que a LUKAFILMES oferece.

`;

    testes.forEach(function(t, i){

        var validade = t.validade || "";

        try {
            validade = new Date(validade).toLocaleString("pt-BR");
        } catch(e) {}

        if(testes.length > 1){
            texto += "🎬 TESTE " + (i + 1) + "\n";
        }

        texto +=
            "👤 Usuário: " + (t.usuario || "") + "\n" +
            "🔑 Senha: " + (t.senha || "") + "\n" +
            "⏱️ Expira em: " + validade + "\n\n";
    });

    texto +=
`🍿 Teste bastante para depois decidir com calma se quer contratar.

💰 Plano completo: apenas R$ 18,00 mensais.

🎬 Aproveite a LUKAFILMES!`;

    window.LUKA_TESTE_TEXTO = texto;

    var el = document.getElementById("luka-teste-resultado-conteudo");

    if(el){
        el.innerHTML = blocos.join("");
    }

    var modal = document.getElementById("luka-teste-resultado");

    if(modal){
        modal.style.display = "flex";
    }
};

window.LUKA_COPIAR_TESTE = async function(){

    var texto = window.LUKA_TESTE_TEXTO || "";

    if(!texto){
        return;
    }

    try {
        await navigator.clipboard.writeText(texto);

        var btn = event && event.currentTarget
            ? event.currentTarget
            : null;

        if(btn){
            var original = btn.innerHTML;
            btn.innerHTML = "✅ Copiado!";
            setTimeout(function(){
                btn.innerHTML = original;
            }, 1800);
        }

    } catch(e){

        var area = document.createElement("textarea");
        area.value = texto;
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.appendChild(area);
        area.select();

        try {
            document.execCommand("copy");
        } catch(err) {}

        area.remove();

        alert("Mensagem copiada!");
    }
};

window.LUKA_FECHAR_TESTE = function(){

    var modal = document.getElementById("luka-teste-resultado");

    if(modal){
        modal.style.display = "none";
    }
};

})();
</script>

