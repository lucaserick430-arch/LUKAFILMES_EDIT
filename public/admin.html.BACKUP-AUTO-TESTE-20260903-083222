function escapeHtml(v){

 return String(v??"")
 .replaceAll("&","&amp;")
 .replaceAll("<","&lt;")
 .replaceAll(">","&gt;")
 .replaceAll('"',"&quot;")
 .replaceAll("'","&#039;");
}


let contaDetalhesAberta = null;

function formatarValorConta(v){

    const n = Number(v);

    if(!Number.isFinite(n)){
        return "Não informado";
    }

    return n.toLocaleString("pt-BR",{
        style:"currency",
        currency:"BRL"
    });
}

function formatarDataHoraConta(v){

    if(!v){
        return "Não informado";
    }

    const d = new Date(v);

    if(Number.isNaN(d.getTime())){
        return "Não informado";
    }

    return d.toLocaleString("pt-BR",{
        dateStyle:"short",
        timeStyle:"short"
    });
}

function calcularTempoRestante(v){

    if(!v){
        return "Sem validade";
    }

    const fim = new Date(v).getTime();

    if(!Number.isFinite(fim)){
        return "Data inválida";
    }

    let restante = fim - Date.now();

    if(restante <= 0){
        return "Expirado";
    }

    const totalSegundos = Math.floor(restante / 1000);

    const dias = Math.floor(totalSegundos / 86400);
    const horas = Math.floor((totalSegundos % 86400) / 3600);
    const minutos = Math.floor((totalSegundos % 3600) / 60);

    if(dias > 0){
        return `${dias} dia${dias===1?"":"s"}, ${horas}h`;
    }

    if(horas > 0){
        return `${horas}h ${minutos}min`;
    }

    return `${Math.max(1,minutos)} min`;
}

function abrirContaDetalhes(id){

    const u = usuarios.find(
        x => Number(x.id) === Number(id)
    );

    if(!u){
        toast("Conta não encontrada.");
        return;
    }

    contaDetalhesAberta = u;

    const usuario = u.usuario || "—";
    const tipo = String(u.tipo || "usuario").toUpperCase();
    const st = String(u.status || "ativo").toLowerCase();
    const online = Boolean(u.online);

    document.getElementById("lukaContaUsuario").textContent = usuario;
    document.getElementById("lukaContaTipo").textContent = tipo;
    document.getElementById("lukaContaStatus").textContent =
        st === "ativo" ? "ATIVO" : "SUSPENSO";

    document.getElementById("lukaContaOnline").textContent =
        online ? "🟢 Online" : "⚪ Offline";

    document.getElementById("lukaContaValor").textContent =
        formatarValorConta(u.valor ?? u.valor_mensal ?? 0);

    document.getElementById("lukaContaTelefone").textContent =
        u.telefone || u.whatsapp || "Não informado";

    document.getElementById("lukaContaCriado").textContent =
        formatarDataHoraConta(u.criado_em);

    document.getElementById("lukaContaId").textContent =
        u.id ?? "—";

    const validade = u.validade || "";
    const validadeData = validade ? new Date(validade) : null;
    const agora = Date.now();

    let restante = "Sem validade";
    let expirado = false;
    let percentual = 100;

    if(validadeData && !Number.isNaN(validadeData.getTime())){

        const fim = validadeData.getTime();
        const inicio = u.criado_em
            ? new Date(u.criado_em).getTime()
            : agora;

        const total = Math.max(fim - inicio, 1);
        const decorrido = agora - inicio;

        percentual = Math.max(
            0,
            Math.min(100, ((total - decorrido) / total) * 100)
        );

        if(fim <= agora){
            expirado = true;
            restante = "EXPIRADO";
        }else{
            restante = calcularTempoRestante(validade);
        }

        document.getElementById("lukaContaValidade").textContent =
            formatarDataHoraConta(validade) +
            " • " +
            restante;

    }else{
        document.getElementById("lukaContaValidade").textContent =
            "Sem validade";
    }

    const body = document.querySelector("#lukaContaBox .luka-conta-body");

    if(body){

        const antigo = body.querySelector(".luka-pro-extra");
        if(antigo) antigo.remove();

        const telefone = u.telefone || u.whatsapp || "";

        const extra = document.createElement("div");
        extra.className = "luka-pro-extra";

        extra.innerHTML = `
            <div class="luka-pro-status">
                <span class="luka-pro-dot ${online ? "online" : "offline"}"></span>
                <span>${online ? "Sessão online detectada" : "Nenhuma sessão ativa"}</span>
            </div>

            <div class="luka-pro-grid">

                <div class="luka-pro-card highlight">
                    <small>Plano / Tipo</small>
                    <strong>${escapeHtml(tipo)}</strong>
                </div>

                <div class="luka-pro-card">
                    <small>Status da conta</small>
                    <strong>${escapeHtml(st === "ativo" ? "ATIVO" : "SUSPENSO")}</strong>
                </div>

                <div class="luka-pro-card">
                    <small>Valor</small>
                    <strong>${escapeHtml(
                        formatarValorConta(u.valor ?? u.valor_mensal ?? 0)
                    )}</strong>
                </div>

                <div class="luka-pro-card">
                    <small>Conexões</small>
                    <strong>${
                        u.tipo === "revendedor"
                        ? `${u.conexoes_utilizadas ?? 0}/${u.limite_conexoes ?? 0}`
                        : "1"
                    }</strong>
                </div>

            </div>

            <div class="luka-pro-validade ${expirado ? "luka-pro-expirada" : ""}">

                <div class="luka-pro-validade-head">
                    <small>Monitoramento da validade</small>
                    <div class="luka-pro-restante">
                        ${escapeHtml(restante)}
                    </div>
                </div>

                <div class="luka-pro-progress">
                    <div
                        class="luka-pro-progress-bar"
                        style="width:${percentual}%"
                    ></div>
                </div>

            </div>

            ${
                telefone
                ? `
                <button
                    type="button"
                    class="luka-pro-copy"
                    onclick="copiarTelefoneConta(${JSON.stringify(telefone)})"
                >
                    📱 Copiar telefone / WhatsApp
                </button>
                `
                : ""
            }

            <div class="luka-pro-id">
                LUKAFILMES • ACCOUNT-ID #${escapeHtml(u.id ?? "—")}
            </div>
        `;

        const acoes = body.querySelector(".luka-conta-acoes");

        if(acoes){
            body.insertBefore(extra, acoes);
        }else{
            body.appendChild(extra);
        }
    }

    document
        .getElementById("lukaContaOverlay")
        .classList.add("show");
}

function copiarTelefoneConta(valor){

    if(!valor){
        toast("Telefone não informado.");
        return;
    }

    if(navigator.clipboard){
        navigator.clipboard.writeText(String(valor))
            .then(() => toast("📋 Telefone copiado!"))
            .catch(() => copiarTelefoneFallback(valor));
    }else{
        copiarTelefoneFallback(valor);
    }
}

function copiarTelefoneFallback(valor){

    const area = document.createElement("textarea");
    area.value = String(valor);
    area.style.position = "fixed";
    area.style.opacity = "0";

    document.body.appendChild(area);
    area.focus();
    area.select();

    try{
        document.execCommand("copy");
        toast("📋 Telefone copiado!");
    }catch(e){
        toast("Não foi possível copiar.");
    }

    area.remove();
}

function fecharContaDetalhes(event){

    if(event && event.target !== event.currentTarget){
        return;
    }

    const el = document.getElementById("lukaContaOverlay");

    if(el){
        el.classList.remove("show");
