  btn.textContent="Criar";
 }
}

async function carregar(){

 try{

  const r=await fetch("/api/admin/presenca",{credentials:"include"});
  const d=await r.json();

  if(!r.ok||d.sucesso===false){
   throw new Error(d.mensagem||"Erro ao carregar painel.");
  }

  usuarios=Array.isArray(d.usuarios)?d.usuarios:[];window.usuarios=usuarios;

  (document.getElementById("cUsuarios") || {set textContent(v){}}).textContent=
   usuarios.filter(x=>x.tipo==="usuario").length;

  (document.getElementById("cTestes") || {set textContent(v){}}).textContent=
   usuarios.filter(x=>x.tipo==="teste").length;

  (document.getElementById("cRevendedores") || {set textContent(v){}}).textContent=
   usuarios.filter(x=>x.tipo==="revendedor").length;

  (document.getElementById("cOnline") || {set textContent(v){}}).textContent=
   usuarios.filter(x=>x.online).length;

