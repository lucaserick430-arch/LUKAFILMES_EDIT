    if(event && event.target !== event.currentTarget){
        return;
    }

    const el=document.getElementById("lukaEditarConta");

    if(el){
        el.classList.remove("show");
    }
}

async function salvarEdicaoConta(){

    if(!contaDetalhesAberta){
        toast("Nenhuma conta selecionada.");
        return;
    }

    const id=Number(contaDetalhesAberta.id);

    const usuario=
        document.getElementById("editarContaUsuario")
        .value.trim();

    const senha=
        document.getElementById("editarContaSenha")
        .value;

    const tipo=
        document.getElementById("editarContaTipo")
        .value;

    const telefone=
        document.getElementById("editarContaTelefone")
        .value.trim();

    const valorTexto=
        document.getElementById("editarContaValor")
        .value;

    const valor=
        valorTexto === ""
            ? 0
            : Number(valorTexto);

    if(!usuario){
        toast("Informe o usuário.");
        return;
    }

    if(!Number.isFinite(valor) || valor < 0){
        toast("Valor inválido.");
        return;
    }

    if(senha && senha.length < 4){
        toast("A senha precisa ter pelo menos 4 caracteres.");
        return;
    }

    const btn=
        document.getElementById("btnSalvarEdicaoConta");

    btn.disabled=true;
    btn.textContent="Salvando...";

    try{

        const r=await fetch(
            "/api/admin/usuarios/editar",
            {
                method:"POST",
                credentials:"include",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    id,
                    usuario,
                    senha,
                    tipo,
                    telefone,
                    valor,
                    whatsapp:telefone,
                    valor_mensal:valor
                })
            }
        );

        const d=await r.json().catch(()=>({}));

        if(!r.ok || d.sucesso===false){
            throw new Error(
                d.mensagem ||
                "Não foi possível atualizar a conta."
            );
        }

        fecharEditorConta();

        toast("✅ Conta atualizada com sucesso.");

        await carregar();

        const atualizada=usuarios.find(
            x=>Number(x.id)===id
        );

        if(atualizada){
            contaDetalhesAberta=atualizada;
            abrirContaDetalhes(id);
        }

    }catch(e){

        console.error("[ADMIN EDITAR]",e);

        toast("❌ "+(
            e.message ||
            "Erro ao salvar."
        ));

    }finally{

        btn.disabled=false;
        btn.textContent="💾 Salvar alterações";
    }
}

async function renovar(id){

 const dias=prompt("Quantos dias deseja adicionar?","30");

 if(dias===null)return;

 const n=Number(dias);

 if(!Number.isInteger(n)||n<1){
  toast("Quantidade inválida.");
  return;
 }

 try{

  const r=await fetch("/api/admin/usuarios/renovar",{
   method:"POST",
   credentials:"include",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({id,dias:n})
  });

  const d=await r.json();

  if(!r.ok||d.sucesso===false)throw new Error(d.mensagem);

  toast("✅ Usuário renovado.");
  carregar();

 }catch(e){
  toast("❌ "+e.message);
 }
}

async function alternar(id){

 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!u)return;

 const novo=u.status==="ativo"?"suspenso":"ativo";

 if(!confirm((novo==="ativo"?"Ativar ":"Suspender ")+u.usuario+"?"))return;

 try{

  const r=await fetch("/api/admin/usuarios/status",{
   method:"POST",
   credentials:"include",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({id,status:novo})
  });

  const d=await r.json();

  if(!r.ok||d.sucesso===false)throw new Error(d.mensagem);

  toast("✅ Status atualizado.");
  carregar();

 }catch(e){
  toast("❌ "+e.message);
 }
}

async function excluir(id){

 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!u)return;

 if(u.tipo==="admin"){
  toast("O administrador não pode ser excluído.");
  return;
 }

 if(!confirm('Excluir definitivamente "'+u.usuario+'"?'))return;

 try{

  const r=await fetch("/api/admin/usuarios/excluir",{
   method:"POST",
   credentials:"include",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({id})
  });

  const d=await r.json();

  if(!r.ok||d.sucesso===false)throw new Error(d.mensagem);

  toast("🗑️ Usuário excluído.");
  carregar();

 }catch(e){
  toast("❌ "+e.message);
 }
}

carregar();
setInterval(carregar,15000);

</script>


