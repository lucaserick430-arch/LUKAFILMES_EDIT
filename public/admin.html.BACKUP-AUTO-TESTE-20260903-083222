<script id="luka-admin-ultra-2026">
(function(){

"use strict";

const sleep = ms =>
    new Promise(resolve => setTimeout(resolve,ms));

/* ============================================================
   CONTADOR ANIMADO
============================================================ */

function animarNumero(el, destino){

    if(!el) return;

    const finalValue = Number(destino) || 0;
    const inicio = Number(el.dataset.lukaValue || 0);

    if(inicio === finalValue){
        el.textContent = finalValue;
        return;
    }

    el.dataset.lukaValue = String(finalValue);

    const duracao = 500;
    const inicioTempo = performance.now();

    function frame(agora){

        const progresso =
            Math.min((agora - inicioTempo) / duracao,1);

        const ease =
            1 - Math.pow(1 - progresso,3);

        const valor =
            Math.round(inicio + (finalValue - inicio) * ease);

        el.textContent = valor;

        if(progresso < 1){
            requestAnimationFrame(frame);
        }else{
            el.classList.remove("luka-counter-flash");
            void el.offsetWidth;
            el.classList.add("luka-counter-flash");
        }
    }

    requestAnimationFrame(frame);
}

/* ============================================================
   ATUALIZAÇÃO DOS CARDS
============================================================ */

function atualizarCards(){

    const mapa = [
        ["cUsuarios","lukaModernUsuarios"],
        ["cTestes","lukaModernTestes"],
        ["cRevendedores","lukaModernRevendedores"],
        ["cOnline","lukaModernOnline"]
    ];

    mapa.forEach(([origem,destino])=>{

        const a = document.getElementById(origem);
        const b = document.getElementById(destino);

        if(a && b){
            animarNumero(b,a.textContent.trim());
        }

    });

}

/* ============================================================
   RELÓGIO DO PAINEL
============================================================ */

function criarRelogio(){

    const alvo =
        document.getElementById("ultimaAtualizacao");

    if(!alvo || document.getElementById("lukaAdminClock")){
        return;
    }

    const clock = document.createElement("span");
    clock.id = "lukaAdminClock";

    alvo.appendChild(clock);

    function atualizar(){

        const agora = new Date();

        clock.textContent =
            agora.toLocaleTimeString("pt-BR",{
                hour:"2-digit",
                minute:"2-digit",
                second:"2-digit"
            });

    }

    atualizar();
    setInterval(atualizar,1000);
}

/* ============================================================
   ESTADO VISUAL DO BOTÃO ATUALIZAR
============================================================ */

function prepararRefresh(){

    const botoes =
        document.querySelectorAll(
            'button[onclick="carregar()"]'
        );

    botoes.forEach(btn=>{

        if(btn.dataset.lukaUltra){
            return;
        }

        btn.dataset.lukaUltra="1";

        const original = btn.textContent;

        btn.addEventListener("click",()=>{

            btn.classList.add("luka-refreshing");
            btn.textContent="⟳ Atualizando...";

            setTimeout(()=>{

                btn.classList.remove("luka-refreshing");
                btn.textContent=original;

            },900);

        });

    });
}

/* ============================================================
   ONLINE DOT
============================================================ */

function melhorarOnline(){

    document
        .querySelectorAll(".badge.active")
        .forEach(el=>{

            if(el.dataset.lukaOnline){
                return;
            }

            if(
                el.textContent.includes("Online") ||
                el.textContent.includes("Ativo")
            ){

                el.dataset.lukaOnline="1";

                if(el.textContent.includes("Online")){

                    el.innerHTML =
                        '<span class="luka-online-dot"></span>Online';

                }

            }

        });

}

/* ============================================================
   ATALHO CTRL + K
============================================================ */

function instalarAtalho(){

    document.addEventListener("keydown",function(e){

        if((e.ctrlKey || e.metaKey) && e.key.toLowerCase()==="k"){

            e.preventDefault();

            const campo =
                document.getElementById("buscaUsuarios");

            if(campo){

                campo.focus();
                campo.select();

            }

        }

        if(e.key==="Escape"){

            const overlay =
                document.getElementById("lukaContaOverlay");

            if(
                overlay &&
                overlay.classList.contains("show") &&
                typeof fecharContaDetalhes==="function"
            ){
                fecharContaDetalhes();
            }

        }

    });

}

/* ============================================================
   OBSERVADOR DO PAINEL
============================================================ */

function iniciarObserver(){

    /*
     * IMPORTANTE:
     * A V3 do painel já possui seu próprio MutationObserver.
     * A camada Ultra não precisa observar o document.body inteiro.
     *
     * Isso evita atualizações em cascata durante o carregamento.
     */

    let ultimo = "";

    setInterval(function(){

        const dados = [
            document.getElementById("cUsuarios")?.textContent || "",
            document.getElementById("cTestes")?.textContent || "",
            document.getElementById("cRevendedores")?.textContent || "",
            document.getElementById("cOnline")?.textContent || ""
        ].join("|");

        if(dados !== ultimo){

            ultimo = dados;

            atualizarCards();
            melhorarOnline();

        }

    },1000);
}

/* ============================================================
   INICIALIZAÇÃO
============================================================ */

function iniciar(){

    criarRelogio();
    prepararRefresh();
    instalarAtalho();
    iniciarObserver();

    setTimeout(atualizarCards,400);
    setTimeout(atualizarCards,1000);
    setTimeout(atualizarCards,2000);
    setTimeout(melhorarOnline,700);

}

if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",iniciar);
}else{
    iniciar();
}

})();
</script>

