<script id="luka-admin-modern-js">
(function(){

    function lukaModernDashboard(){

        if(document.querySelector(".luka-modern-overview")){
            lukaAtualizarCards();
            return;
        }

        const alvo =
            document.querySelector("main") ||
            document.querySelector(".content") ||
            document.body;

        if(!alvo)return;

        const overview=document.createElement("div");
        overview.className="luka-modern-overview";

        overview.innerHTML=`
            <div class="luka-modern-stat"
                 onclick="abrirPainelPremium('usuarios')">
                <div class="luka-modern-stat-icon">👤</div>
                <div class="luka-modern-stat-label">Usuários</div>
                <div class="luka-modern-stat-number"
                     id="lukaModernUsuarios">0</div>
                <div class="luka-modern-stat-sub">
                    Contas ativas no sistema
                </div>
            </div>

            <div class="luka-modern-stat"
                 onclick="abrirAbaAdmin('testes')">
                <div class="luka-modern-stat-icon">🧪</div>
                <div class="luka-modern-stat-label">Testes</div>
                <div class="luka-modern-stat-number"
                     id="lukaModernTestes">0</div>
                <div class="luka-modern-stat-sub">
                    Acessos temporários
                </div>
            </div>

            <div class="luka-modern-stat"
                 onclick="abrirPainelPremium('revendedores')">
                <div class="luka-modern-stat-icon">🤝</div>
                <div class="luka-modern-stat-label">Revendedores</div>
                <div class="luka-modern-stat-number"
                     id="lukaModernRevendedores">0</div>
                <div class="luka-modern-stat-sub">
                    Parceiros cadastrados
                </div>
            </div>

            <div class="luka-modern-stat"
                 onclick="abrirPainelPremium('online')">
                <div class="luka-modern-stat-icon">🟢</div>
                <div class="luka-modern-stat-label">Online</div>
                <div class="luka-modern-stat-number"
                     id="lukaModernOnline">0</div>
                <div class="luka-modern-stat-sub">
                    Sessões detectadas agora
                </div>
            </div>
        `;

        const primeiraSection =
            alvo.querySelector(".section");

        if(primeiraSection){
            primeiraSection.parentNode.insertBefore(
                overview,
                primeiraSection
            );
        }else{
            alvo.prepend(overview);
        }

        lukaAtualizarCards();
    }

    function lukaAtualizarCards(){

        const ids=[
            ["cUsuarios","lukaModernUsuarios"],
            ["cTestes","lukaModernTestes"],
            ["cRevendedores","lukaModernRevendedores"],
            ["cOnline","lukaModernOnline"]
        ];

        ids.forEach(([origem,destino])=>{
            const a=document.getElementById(origem);
            const b=document.getElementById(destino);

            if(a && b){
                b.textContent=a.textContent || "0";
            }
        });
    }

    const observer=new MutationObserver(function(){
        lukaAtualizarCards();
    });

    document.addEventListener("DOMContentLoaded",function(){

        lukaModernDashboard();

        const alvo=
            document.getElementById("cUsuarios") ||
            document.body;

        observer.observe(alvo,{
            childList:true,
            characterData:true,
            subtree:true
        });

        setTimeout(lukaAtualizarCards,500);
        setTimeout(lukaAtualizarCards,1500);
        setTimeout(lukaAtualizarCards,3000);
    });

})();
</script>

