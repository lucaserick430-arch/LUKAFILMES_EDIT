(function(){

    function iniciarV4(){

        /* Indicador de sistema online */
        const titulo =
            document.querySelector(".title h1") ||
            document.querySelector("h1");

        if(titulo && !document.getElementById("lukaV4Live")){

            const live=document.createElement("span");
            live.id="lukaV4Live";
            live.className="luka-v4-live";
            live.innerHTML="<i></i> SISTEMA ONLINE";

            titulo.appendChild(live);
        }

        /* Atualiza tooltip das ações */
        document.querySelectorAll(".actions button").forEach(btn=>{
            if(!btn.getAttribute("aria-label")){
                const title=btn.getAttribute("title");
                if(title) btn.setAttribute("aria-label",title);
            }
        });

        /* Animação numérica sem interferir no valor real */
        document.querySelectorAll(
            "#cUsuarios,#cTestes,#cRevendedores,#cOnline"
        ).forEach(el=>{

            if(el.dataset.v4Ready) return;
            el.dataset.v4Ready="1";

            const observer=new MutationObserver(()=>{
                el.animate(
                    [
                        {transform:"scale(.96)",opacity:.72},
                        {transform:"scale(1.05)",opacity:1},
                        {transform:"scale(1)",opacity:1}
                    ],
                    {
                        duration:280,
                        easing:"cubic-bezier(.2,.8,.2,1)"
                    }
                );
            });

            observer.observe(el,{
                childList:true,
                characterData:true,
                subtree:true
            });
        });
    }

    if(document.readyState==="loading"){
        document.addEventListener(
            "DOMContentLoaded",
            iniciarV4,
            {once:true}
        );
    }else{
        iniciarV4();
    }

    setTimeout(iniciarV4,700);
