<script>

let usuarios=[];
let timer=null;

function aba(id,btn){

 document.querySelectorAll(".section").forEach(x=>x.classList.remove("active"));
 document.getElementById(id).classList.add("active");

 document.querySelectorAll(".nav button").forEach(x=>x.classList.remove("active"));
 if(btn)btn.classList.add("active");

 carregar();
}

function toast(msg){

 const t=document.getElementById("toast");
 t.textContent=msg;
 t.classList.add("show");

 clearTimeout(timer);
 timer=setTimeout(()=>t.classList.remove("show"),2800);
}

function abrirModal(tipo){

 document.getElementById("modal").classList.add("show");
 document.getElementById("tipoCriacao").value=tipo;

 document.getElementById("fUsuario").value="";
 document.getElementById("fSenha").value="";
 document.getElementById("fTempoLabel").textContent =
  tipo==="teste" ? "Horas de teste" : "Dias";

 document.getElementById("fDias").value =
  tipo==="teste" ? 1 : 30;

 if(document.getElementById("fValor")){
  document.getElementById("fValor").value="";
 }

 if(document.getElementById("fTelefone")){
  document.getElementById("fTelefone").value="";
 }

 const limite=document.getElementById("limiteBox");

 limite.style.display=tipo==="revendedor"?"block":"none";

 (document.getElementById("modalTitulo") || {set textContent(v){}}).textContent=
 tipo==="usuario"?"Criar usuário":
 tipo==="teste"?"Criar teste":
 "Criar revendedor";
}

function fecharModal(){
 document.getElementById("modal").classList.remove("show");
}


function escaparTextoMensagem(v){
 return String(v ?? "");
}

function formatarDataMensagem(v){

 const d=new Date(v);

 if(Number.isNaN(d.getTime())){
  return String(v || "");
 }

 return d.toLocaleString("pt-BR",{
  dateStyle:"short",
  timeStyle:"short"
 });
}

function mostrarMensagemCriacao(d, dados){

 const existente=document.getElementById("mensagemCriacao");

 if(existente){
  existente.remove();
 }

 const usuario=
  d.usuario ||
  dados.usuario ||
  "";

 const senha=
  d.senha ||
  dados.senha ||
  "";

 const valorNumerico=
  Number(
   d.valor ??
   dados.valor ??
   0
  );

 const valor=
  valorNumerico.toLocaleString(
   "pt-BR",
   {
    style:"currency",
    currency:"BRL"
   }
  );

 const telefone=
  d.telefone ||
  dados.telefone ||
  "Não informado";

 const criado=
  d.criado_em ||
  new Date().toISOString();

 const validade=
  d.validade ||
  "";

 const mensagem=
`🎬 SEJA BEM-VINDO AO LUKAFILMES!

Seu acesso foi criado com sucesso.

🍿 Aproveite o catálogo de filmes e séries do LUKAFILMES.

👤 Usuário: ${usuario}
🔑 Senha: ${senha}
💰 Valor: ${valor}
📱 Telefone: ${telefone}

📅 Criado em: ${formatarDataMensagem(criado)}
⏰ Expira em: ${formatarDataMensagem(validade)}

Obrigado por fazer parte do LUKAFILMES!`;

 const box=document.createElement("div");

 box.id="mensagemCriacao";

 box.style.cssText=`
 position:fixed;
 inset:0;
 z-index:999999;
 background:rgba(0,0,0,.78);
 display:flex;
 align-items:center;
 justify-content:center;
 padding:20px;
 box-sizing:border-box;
 `;

 box.innerHTML=`
 <div style="
  width:min(520px,100%);
  max-height:90vh;
  overflow:auto;
  background:#151515;
  color:#fff;
  border:1px solid rgba(255,255,255,.15);
  border-radius:16px;
  padding:22px;
  box-sizing:border-box;
  box-shadow:0 20px 60px rgba(0,0,0,.6);
 ">
  <h2 style="
   margin:0 0 15px;
   font-size:20px;
  ">✅ Usuário criado</h2>

  <textarea
   id="mensagemCriadaTexto"
   readonly
   style="
    width:100%;
    min-height:300px;
    resize:vertical;
    box-sizing:border-box;
    background:#0b0b0b;
    color:#fff;
    border:1px solid #333;
    border-radius:10px;
    padding:14px;
    font-size:14px;
    line-height:1.5;
   ">${mensagem}</textarea>

  <div style="
   display:flex;
   gap:10px;
   margin-top:14px;
   flex-wrap:wrap;
  ">
   <button
    type="button"
    id="btnCopiarMensagem"
    style="
     flex:1;
     min-width:150px;
     padding:13px;
     border:0;
     border-radius:9px;
     cursor:pointer;
     font-weight:700;
    "
   >📋 Copiar mensagem</button>

   <button
    type="button"
    id="btnFecharMensagem"
    style="
     flex:1;
     min-width:150px;
     padding:13px;
     border:1px solid #444;
     border-radius:9px;
     background:#222;
     color:#fff;
     cursor:pointer;
     font-weight:700;
    "
   >Fechar</button>
  </div>
 </div>
 `;

 document.body.appendChild(box);

 document
  .getElementById("btnFecharMensagem")
  .onclick=function(){
   box.remove();
  };

 document
  .getElementById("btnCopiarMensagem")
  .onclick=async function(){

