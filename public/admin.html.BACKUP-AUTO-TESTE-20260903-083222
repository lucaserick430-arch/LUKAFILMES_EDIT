<script id="lukafilmes-loader-global-js">
(function(){

    var loaderPronto = false;

    function loader(){
        return document.getElementById("lukaLoaderOverlay");
    }

    function mostrarLukaLoader(){
        var overlay = loader();
        if(!overlay) return;

        overlay.classList.remove("luka-loader-oculto");
        overlay.setAttribute("aria-hidden","false");
    }

    function esconderLukaLoader(){
        var overlay = loader();
        if(!overlay) return;

        overlay.classList.add("luka-loader-oculto");
        overlay.setAttribute("aria-hidden","true");
    }

    window.mostrarLukaLoader = mostrarLukaLoader;

    window.LukaLoader = {
        show: mostrarLukaLoader,
        hide: esconderLukaLoader
    };

    /*
     * Qualquer navegação interna mostra o Loader.
     */
    function prepararNavegacao(){

        document.addEventListener("click",function(event){

            var link = event.target.closest
                ? event.target.closest("a[href]")
                : null;

            if(!link) return;

            if(
                link.target === "_blank" ||
                link.hasAttribute("download") ||
                link.getAttribute("href").startsWith("#") ||
                link.getAttribute("href").startsWith("javascript:")
            ){
                return;
            }

            var href = link.href;

            if(!href) return;

            try{
                var destino = new URL(href, location.href);

                if(destino.origin !== location.origin){
                    return;
                }

                if(
                    destino.pathname === location.pathname &&
                    destino.search === location.search &&
                    destino.hash !== ""
                ){
                    return;
                }

                mostrarLukaLoader();

            }catch(e){}

        },true);

        /*
         * Botões que normalmente iniciam player/navegação.
         */
        document.addEventListener("click",function(event){

            var botao = event.target.closest
                ? event.target.closest("button")
                : null;

            if(!botao) return;

            var texto = (botao.textContent || "")
                .trim()
                .toLowerCase();

            if(
                texto.includes("assistir") ||
                botao.matches("#playCentralFilme") ||
                botao.matches("#playCentralSerie") ||
                botao.matches(".btn-watch")
            ){
                mostrarLukaLoader();
            }

        },true);
    }

    /*
     * Voltar/avançar pelo navegador:
     * nunca deixar o Loader preso.
     */
    window.addEventListener("pageshow",function(event){

        if(event.persisted){
            esconderLukaLoader();
        }

    });

    /*
     * A própria página já terminou de carregar.
     * Para páginas normais, isso libera o Loader.
     *
     * A Home possui controle próprio abaixo.
     */
    window.addEventListener("load",function(){

        setTimeout(function(){

            if(!window.__LUKAFILMES_HOME_LOADER_CONTROLLED__){
                esconderLukaLoader();
            }

        },80);

    });

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            prepararNavegacao
        );
    }else{
        prepararNavegacao();
    }

})();
</script>


