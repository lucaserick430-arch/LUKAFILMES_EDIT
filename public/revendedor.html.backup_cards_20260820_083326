/* ============================================================
   LUKAFILMES • NAVEGAÇÃO DOS CARDS DO REVENDEDOR
   ============================================================ */

let filtroClientesAtual = "todos";

function abrirListaClientes(filtro){
    filtroClientesAtual = filtro || "todos";

    document.body.classList.add("modo-clientes");

    const titulo = document.getElementById("tituloClientes");
    const subtitulo = document.getElementById("subtituloClientes");

    const nomes = {
        todos: ["Meus clientes", "Todos os clientes deste revendedor"],
        ativo: ["Clientes ativos", "Somente clientes com acesso ativo"],
        suspenso: ["Clientes suspensos", "Somente clientes suspensos"],
        online: ["Online agora", "Clientes conectados neste momento"]
    };

    const dados = nomes[filtroClientesAtual] || nomes.todos;

    if(titulo) titulo.textContent = dados[0];
    if(subtitulo) subtitulo.textContent = dados[1];

    aplicarFiltroClientes();

    const card = document.getElementById("clientesCard");
    if(card){
        setTimeout(() => {
            card.scrollIntoView({
                behavior:"smooth",
                block:"start"
            });
        }, 50);
    }

    // Atualiza os dados para refletir online/status imediatamente.
    if(typeof carregar === "function"){
        carregar();
    }
}

function fecharListaClientes(){
    document.body.classList.remove("modo-clientes");
    filtroClientesAtual = "todos";

    const titulo = document.getElementById("tituloClientes");
    const subtitulo = document.getElementById("subtituloClientes");

    if(titulo) titulo.textContent = "Meus clientes";
    if(subtitulo) subtitulo.textContent = "Todos os clientes deste revendedor";

    const topo = document.querySelector(".topo");
    if(topo){
        topo.scrollIntoView({
            behavior:"smooth",
            block:"start"
        });
    }

    if(typeof carregar === "function"){
        carregar();
    }
}

function aplicarFiltroClientes(){
    const tbody = document.getElementById("clientes");
    if(!tbody) return;

    const linhas = tbody.querySelectorAll("tr");

    linhas.forEach(tr => {
        const texto = (tr.textContent || "").toUpperCase();

        if(
            texto.includes("NENHUM CLIENTE") ||
            texto.includes("CARREGANDO") ||
            texto.includes("ERRO AO CARREGAR")
        ){
            tr.style.display = "";
            return;
        }

        const statusAtivo =
            texto.includes("ATIVO") &&
            !texto.includes("SUSPENSO");

        const statusSuspenso =
            texto.includes("SUSPENSO");

        const online =
            texto.includes("● ONLINE") ||
            texto.includes("ONLINE");

        let mostrar = true;

        if(filtroClientesAtual === "ativo"){
            mostrar = statusAtivo;
        }

        if(filtroClientesAtual === "suspenso"){
            mostrar = statusSuspenso;
        }

        if(filtroClientesAtual === "online"){
            mostrar = online;
        }

        tr.style.display = mostrar ? "" : "none";
    });
}

