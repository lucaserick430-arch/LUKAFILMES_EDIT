<body>




<div class="container">

    <div class="topo">

        <div>
            <a href="/" class="logo">
                LUKA<span>FILMES</span>
            </a>

            <div class="subtitulo">
                Painel do revendedor
            </div>
        </div>

        <button
            class="btn-sair"
            onclick="sair()"
        >
            SAIR
        </button>

    </div>

    
<div class="dashboard">

    <div class="card card-selecionado"
         id="cardTodos"
         onclick="filtrarClientes('todos')">
        <div class="label">CLIENTES</div>
        <div class="numero" id="clientesNumero">0 / 0</div>
        <span class="card-indicador">Clique para ver todos →</span>
    </div>

    <div class="card"
         id="cardAtivos"
         onclick="filtrarClientes('ativos')">
        <div class="label">CLIENTES ATIVOS</div>
        <div class="numero" id="clientesAtivos">0</div>
        <span class="card-indicador">Clique para ver ativos →</span>
    </div>

    <div class="card"
         id="cardSuspensos"
         onclick="filtrarClientes('suspensos')">
        <div class="label">CLIENTES SUSPENSOS</div>
        <div class="numero" id="clientesSuspensos">0</div>
        <span class="card-indicador">Clique para ver suspensos →</span>
    </div>

    <div class="card"
         id="cardOnline"
         onclick="filtrarClientes('online')">
        <div class="label">ONLINE AGORA</div>
        <div class="numero" id="clientesOnline">0</div>
        <span class="card-indicador">Clique para ver online →</span>
    </div>

</div>


    <div class="card">

        <h2>Criar novo cliente</h2>

        <div id="mensagem" class="mensagem"></div>

        <form id="formCliente">

            <div class="form-grid">

                <div class="campo">
                    <label>Usuário</label>
                    <input id="clienteUsuario" required>
                </div>

                <div class="campo">
                    <label>Senha</label>
                    <input id="clienteSenha" type="password" required>
                </div>

                <div class="campo">
                    <label>Dias</label>
                    <input id="clienteDias" type="number" min="1" value="30" required>
                </div>

                <button class="btn" type="submit">
                    CRIAR CLIENTE
                </button>

            </div>

        </form>

    </div>

    <div class="card" id="clientesCard">

        <div class="clientes-topo">
            <div>
                <h2 id="tituloClientes">Meus clientes</h2>
                <div id="subtituloClientes" class="clientes-subtitulo">Todos os clientes deste revendedor</div>
            </div>
            <button id="btnVoltarDashboard" class="btn-voltar-clientes" onclick="fecharListaClientes()">← Voltar ao Dashboard</button>
        </div>

        
<div id="filtroClientesAtivo">
    <span>Filtro: <strong id="filtroClientesNome">Todos os clientes</strong></span>
    <button id="limparFiltroClientes" type="button" onclick="filtrarClientes('todos')">LIMPAR</button>
</div>

<div class="tabela-wrapper">


            <table>

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>USUÁRIO</th>
                        <th>STATUS</th>
<th>ONLINE</th>
                        <th>VALIDADE</th>
                        <th>AÇÕES</th>
                    </tr>

                </thead>

                <tbody id="clientes">
                    <tr>
                        <td colspan="6">
                            Carregando...
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

</div>


<script id="lf-filtro-clientes">

let filtroClientesAtual = "todos";
let clientesCacheFiltro = [];

function marcarCardFiltro(tipo){

    document.querySelectorAll(".dashboard .card").forEach(c=>{
        c.classList.remove("card-selecionado");
    });

    const mapa={
        todos:"cardTodos",
        ativos:"cardAtivos",
        suspensos:"cardSuspensos",
        online:"cardOnline"
    };

    const card=document.getElementById(mapa[tipo]);

    if(card){
        card.classList.add("card-selecionado");
    }
}

function filtrarClientes(tipo){

    filtroClientesAtual=tipo;

    marcarCardFiltro(tipo);

    const nomes={
        todos:"Todos os clientes",
        ativos:"Clientes ativos",
        suspensos:"Clientes suspensos",
        online:"Usuários online"
    };

    const filtro=document.getElementById("filtroClientesAtivo");
    const nome=document.getElementById("filtroClientesNome");

    if(tipo==="todos"){
        filtro.classList.remove("show");
    }else{
        nome.textContent=nomes[tipo] || "Clientes";
        filtro.classList.add("show");
    }

    renderizarClientesFiltro();
}

function renderizarClientesFiltro(){

    const tbody=document.getElementById("clientes");

    if(!tbody) return;

    let lista=[...clientesCacheFiltro];

    if(filtroClientesAtual==="ativos"){
        lista=lista.filter(c=>c.status==="ativo");
    }

    if(filtroClientesAtual==="suspensos"){
        lista=lista.filter(c=>c.status!=="ativo");
    }

    if(filtroClientesAtual==="online"){
        lista=lista.filter(c=>c.online===true);
    }

    if(!lista.length){

        tbody.innerHTML=`
            <tr>
                <td colspan="6" style="text-align:center;padding:35px;color:#777">
                    Nenhum cliente encontrado neste filtro.
                </td>
            </tr>
        `;

        return;
    }

    tbody.innerHTML=lista.map(cliente=>{

        const status=
            cliente.status==="ativo"
            ? "ativo"
            : "suspenso";

        const botaoStatus=
            cliente.status==="ativo"
            ? `<button class="acao-btn suspender"
                onclick="alterarStatus(${cliente.id},'suspenso')">
                SUSPENDER
               </button>`
            : `<button class="acao-btn ativar"
                onclick="alterarStatus(${cliente.id},'ativo')">
                ATIVAR
               </button>`;

        return `
        <tr>

            <td>${cliente.id}</td>

            <td>
                ${escapeHtml(cliente.usuario)}
            </td>

            <td>
                <span class="badge ${status}">
                    ${cliente.status==="ativo" ? "ATIVO" : "SUSPENSO"}
                </span>
            </td>

            <td>
                <span class="badge ${cliente.online ? "online" : "offline"}">
                    ${cliente.online ? "● ONLINE" : "● OFFLINE"}
                </span>
            </td>

            <td>
                ${cliente.validade
                    ? new Date(cliente.validade).toLocaleString("pt-BR")
                    : "—"}
            </td>

            <td>
                <div class="acoes">

                    <button class="acao-btn editar"
                        onclick="editarCliente(${cliente.id},'${escapeJs(cliente.usuario)}')">
                        EDITAR
                    </button>

                    ${botaoStatus}

                    <button class="acao-btn renovar"
                        onclick="renovarCliente(${cliente.id})">
                        RENOVAR
                    </button>

                    <button class="acao-btn excluir"
                        onclick="excluirCliente(${cliente.id},'${escapeJs(cliente.usuario)}')">
                        EXCLUIR
                    </button>

                </div>
            </td>

        </tr>
        `;

    }).join("");

        renderizarClientesFiltro();
}

function atualizarFiltroDepoisDoCarregamento(lista){

    clientesCacheFiltro=Array.isArray(lista) ? lista : [];

    const online=clientesCacheFiltro.filter(c=>c.online===true).length;

    const el=document.getElementById("clientesOnline");

    if(el){
        el.textContent=online;
    }

    renderizarClientesFiltro();
}

</script>

<script>

async function carregar() {

    try {

        const resposta =
            await fetch(
                "/api/revendedor/clientes",
                {
                    credentials: "same-origin"
                }
            );

        if (resposta.status === 403) {
            window.location.href = "/login";
            return;
        }

        const dados = await resposta.json();

        if (!dados.sucesso) {
            throw new Error(dados.mensagem || "Erro");
        }

        document.getElementById("clientesNumero")
            .textContent =
            dados.utilizados +
            " / " +
            dados.limite;

        const ativos =
            dados.clientes.filter(
                u => u.status === "ativo"
            ).length;

        const suspensos =
            dados.clientes.filter(
                u => u.status !== "ativo"
            ).length;

        document.getElementById("clientesAtivos")
            .textContent = ativos;

        document.getElementById("clientesSuspensos")
            .textContent = suspensos;

        clientesCacheFiltro = Array.isArray(dados.clientes) ? dados.clientes : [];

        const onlineCount = clientesCacheFiltro.filter(c => c.online === true).length;
        const onlineEl = document.getElementById("clientesOnline");
        if (onlineEl) onlineEl.textContent = onlineCount;

        const tbody =
            document.getElementById("clientes");

        if (!dados.clientes.length) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="6">
                        Nenhum cliente cadastrado.
                    </td>
                </tr>
            `;

            return;
        }

        tbody.innerHTML =
            dados.clientes.map(cliente => {

                const status =
                    cliente.status === "ativo"
                        ? "ativo"
                        : "suspenso";

                const botaoStatus =
                    cliente.status === "ativo"
                        ? `<button class="acao-btn suspender"
                                onclick="alterarStatus(${cliente.id}, 'suspenso')">
                                SUSPENDER
                           </button>`
                        : `<button class="acao-btn ativar"
                                onclick="alterarStatus(${cliente.id}, 'ativo')">
                                ATIVAR
                           </button>`;

                return `
                    <tr>
                        <td>${cliente.id}</td>

                        <td>
                            ${escapeHtml(cliente.usuario)}
                        </td>

                        <td>
                            <span class="badge ${cliente.online ? "online" : "offline"}">
                                ${cliente.online ? "● ONLINE" : "● OFFLINE"}
                            </span>
                        </td>

                        <td>
                            <span class="badge ${status}">
                                ${cliente.status === "ativo"
                                    ? "ATIVO"
                                    : "SUSPENSO"}
                            </span>
                        </td>

                        <td>
                            ${cliente.validade
                                ? new Date(cliente.validade).toLocaleString("pt-BR")
                                : "—"}
                        </td>

                        <td>
                            <div class="acoes">

                                <button
                                    class="acao-btn editar"
                                    onclick="editarCliente(${cliente.id}, '${escapeJs(cliente.usuario)}')">
                                    EDITAR
                                </button>

                                ${botaoStatus}

                                <button
                                    class="acao-btn renovar"
                                    onclick="renovarCliente(${cliente.id})">
                                    RENOVAR
                                </button>

                                <button
                                    class="acao-btn excluir"
                                    onclick="excluirCliente(${cliente.id}, '${escapeJs(cliente.usuario)}')">
                                    EXCLUIR
                                </button>

                            </div>
                        </td>
                    </tr>
                `;

            }).join("");

        if(typeof aplicarFiltroClientes === "function") aplicarFiltroClientes();

    } catch (erro) {

        console.error(erro);

        document.getElementById("clientes")
            .innerHTML = `
                <tr>
                    <td colspan="6">
                        Erro ao carregar clientes.
                    </td>
                </tr>
            `;
    }
}


// Atualiza clientes e presença automaticamente
setInterval(carregar, 15000);

carregar();


document
.getElementById("formCliente")
.addEventListener("submit", async function(event) {

    event.preventDefault();

    const usuario =
        document.getElementById("clienteUsuario")
            .value.trim();

    const senha =
        document.getElementById("clienteSenha")
            .value;

    const dias =
        Number(
            document.getElementById("clienteDias")
                .value
        );

    try {

        const resposta =
            await fetch(
                "/api/revendedor/clientes",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        usuario,
                        senha,
                        dias
                    })
                }
            );

        const dados =
            await resposta.json();

        mostrarMensagem(
            dados.mensagem,
            dados.sucesso
        );

        if (dados.sucesso) {

            document.getElementById("clienteUsuario").value = "";
            document.getElementById("clienteSenha").value = "";
            document.getElementById("clienteDias").value = "30";

            carregar();
        }

    } catch (erro) {

        mostrarMensagem(
            "Erro de comunicação com o servidor.",
            false
        );
    }

});


function mostrarMensagem(texto, sucesso) {

    const el =
        document.getElementById("mensagem");

    el.textContent = texto;
    el.style.display = "block";

    el.style.background =
        sucesso
            ? "rgba(0,210,106,.15)"
            : "rgba(229,9,20,.15)";

    el.style.color =
        sucesso
            ? "#00d26a"
            : "#ff5b64";
}


async function sair() {

    await fetch(
        "/logout",
        {
            credentials: "same-origin"
        }
    );

    window.location.href = "/login";
}


function escapeJs(valor) {

    return String(valor || "")
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'")
        .replace(/"/g, '\\"')
        .replace(/\r?\n/g, "\\n");

}


async function editarCliente(id, usuarioAtual) {

    const usuario =
        prompt("Novo usuário:", usuarioAtual);

    if (usuario === null) return;

    const novoUsuario = usuario.trim();

    if (!novoUsuario) {
        alert("Informe um usuário válido.");
        return;
    }

    const senha =
        prompt("Nova senha (deixe vazio para manter a atual):");

    if (senha === null) return;

    const resposta =
        await fetch(
            "/api/revendedor/clientes/editar",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    id,
                    usuario: novoUsuario,
                    senha
                })
            }
        );

    const dados = await resposta.json();

    mostrarMensagem(
        dados.mensagem,
        dados.sucesso
    );

    if (dados.sucesso) {
        carregar();
    }

}


async function alterarStatus(id, status) {

    const acao =
        status === "ativo"
            ? "ativar"
            : "suspender";

    if (!confirm(`Deseja ${acao} este cliente?`)) {
        return;
    }

    const resposta =
        await fetch(
            "/api/revendedor/clientes/status",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    id,
                    status
                })
            }
        );

    const dados = await resposta.json();

    mostrarMensagem(
        dados.mensagem,
        dados.sucesso
    );

    if (dados.sucesso) {
        carregar();
    }

}


async function renovarCliente(id) {

    const valor =
        prompt(
            "Quantos dias deseja adicionar?",
            "30"
        );

    if (valor === null) return;

    const dias = Number(valor);

    if (
        !Number.isInteger(dias) ||
        dias < 1
    ) {
        alert("Informe uma quantidade válida de dias.");
        return;
    }

    const resposta =
        await fetch(
            "/api/revendedor/clientes/renovar",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    id,
                    dias
                })
            }
        );

    const dados = await resposta.json();

    mostrarMensagem(
        dados.mensagem,
        dados.sucesso
    );

    if (dados.sucesso) {
        carregar();
    }

}


async function excluirCliente(id, usuario) {

    if (
        !confirm(
            `Tem certeza que deseja excluir o cliente "${usuario}"?`
        )
    ) {
        return;
    }

    const resposta =
        await fetch(
            "/api/revendedor/clientes/excluir",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    id
                })
            }
        );

    const dados = await resposta.json();

    mostrarMensagem(
        dados.mensagem,
        dados.sucesso
    );

    if (dados.sucesso) {
        carregar();
    }

}

function escapeHtml(valor) {

    return String(valor || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


carregar();

</script>

