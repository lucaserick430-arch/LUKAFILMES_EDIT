nav.className='lk-admin-navigation';

nav.innerHTML=`
<button type="button" class="lk-admin-home">
🎬 Voltar para o início
</button>

<button type="button" class="lk-admin-exit">
🚪 Sair
</button>
`;

top.insertBefore(nav,top.firstChild);

nav.querySelector('.lk-admin-home').addEventListener('click',function(){
window.location.href='/';
});

nav.querySelector('.lk-admin-exit').addEventListener('click',async function(){

this.disabled=true;
this.textContent='Saindo...';

try{
