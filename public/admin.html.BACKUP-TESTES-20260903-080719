<script>
window.LC=(function(){
let users=[],editing=null;

async function load(){
try{
const r=await fetch('/api/admin/usuarios',{credentials:'same-origin'});
const j=await r.json();
users=Array.isArray(j)?j:(j.usuarios||j.users||[]);window.LUKA_ADMIN_USERS=users;
render();
}catch(e){console.error(e)}
}

function render(){
const q=(document.getElementById('lc-search').value||'').toLowerCase();
const f=document.getElementById('lc-filter').value;
let list=users.filter(x=>{
const text=JSON.stringify(x).toLowerCase();
if(q&&!text.includes(q))return false;
const tipo=String(x.tipo||x.role||'usuario').toLowerCase();
const status=String(x.status||'').toLowerCase();
if(f==='revendedor'&&!tipo.includes('revendedor'))return false;
if(f==='teste'&&!tipo.includes('teste'))return false;
if(f==='ativo'&&!['ativo','active','1'].includes(status)&&x.ativo!==1&&x.ativo!==true)return false;
if(f==='inativo'&&(['ativo','active','1'].includes(status)||x.ativo===1||x.ativo===true))return false;
return true;
});

document.getElementById('lc-total').textContent=users.length;
document.getElementById('lc-active').textContent=users.filter(x=>['ativo','active','1'].includes(String(x.status).toLowerCase())||x.ativo===1||x.ativo===true).length;
document.getElementById('lc-tests').textContent=users.filter(x=>String(x.tipo||'').toLowerCase().includes('teste')).length;
document.getElementById('lc-expired').textContent=users.filter(x=>String(x.status||'').toLowerCase().includes('expir')).length;
document.getElementById('lc-online').textContent=users.filter(x=>x.online||x.conectado||Number(x.conexoes_utilizadas||0)>0).length;

document.getElementById('lc-body').innerHTML=list.map(x=>{
const tipo=String(x.tipo||x.role||x.perfil||'usuario');
const rev=tipo.toLowerCase().includes('revendedor');

const nome=
x.usuario||
x.username||
x.nome||
x.login||
x.user||
x.email||
'Usuário';

const telefone=
x.telefone||
x.whatsapp||
x.celular||
x.phone||
'';

const validade=
x.validade||
x.data_expiracao||
x.expira_em||
x.vencimento||
x.data_vencimento||
'-';

const conexoes=
Number(x.conexoes_utilizadas??x.conexoes??x.sessoes??0)||0;

const limite=
Number(x.limite_conexoes??x.limite??x.max_conexoes??1)||1;

const statusRaw=String(x.status||x.estado||x.situacao||'ATIVO');

const online=!!(
x.online===true||
x.online===1||
x.conectado===true||
x.conectado===1||
conexoes>0
);

const status=online?'● ONLINE':statusRaw;

return `<tr class="lk-user-row" data-user-id="${esc(x.id)}">

<td>
<div class="lk-user-main">
<strong>${esc(nome)}</strong>
${telefone?`<small>${esc(telefone)}</small>`:''}
</div>
</td>

<td>
<span class="lc-badge ${online?'lc-online':''}">
${esc(status)}
</span>
</td>

<td>${esc(validade)}</td>

<td>${conexoes}/${limite}</td>

<td>${esc(tipo)}</td>

<td style="white-space:nowrap">

${rev
?'<span class="lc-badge">PROTEGIDO</span>'
:`
<button type="button" class="lc-btn lk-action-edit" data-id="${esc(x.id)}">Editar</button>
<button type="button" class="lc-btn lk-action-renew" data-id="${esc(x.id)}">Renovar</button>
<button type="button" class="lc-btn lk-action-status" data-id="${esc(x.id)}">Ativar/Desativar</button>
<button type="button" class="lc-btn lk-action-delete" data-id="${esc(x.id)}">Excluir</button>`
}

</td>

</tr>`;
}).join('');

const body=document.getElementById('lc-body');

if(body){

body.querySelectorAll('.lk-user-row').forEach(row=>{

row.addEventListener('click',function(e){

if(e.target.closest('button')) return;

const id=this.dataset.userId;

const u=users.find(x=>String(x.id)===String(id));

if(u && typeof edit==='function'){
edit(u);
}

});

});

body.querySelectorAll('.lk-action-edit').forEach(btn=>{
btn.addEventListener('click',e=>{
e.stopPropagation();

const u=users.find(x=>String(x.id)===String(btn.dataset.id));

if(u) edit(u);
});
});

body.querySelectorAll('.lk-action-renew').forEach(btn=>{
btn.addEventListener('click',e=>{
e.stopPropagation();
renew(Number(btn.dataset.id));
});
});

body.querySelectorAll('.lk-action-status').forEach(btn=>{
btn.addEventListener('click',e=>{
e.stopPropagation();
status(Number(btn.dataset.id));
});
});

body.querySelectorAll('.lk-action-delete').forEach(btn=>{
btn.addEventListener('click',e=>{
e.stopPropagation();
del(Number(btn.dataset.id));
});
});

}

}

function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}

function openUser(){editing=null;document.getElementById('lc-user-title').textContent='Novo Usuário';['lc-u','lc-p','lc-phone','lc-value'].forEach(id=>document.getElementById(id).value='');document.getElementById('lc-days').value=30;document.getElementById('lc-limit').value=1;document.getElementById('lc-type').value='usuario';show('lc-user-modal')}
function edit(x){editing=x;document.getElementById('lc-user-title').textContent='Editar Usuário';document.getElementById('lc-u').value=x.usuario||x.username||'';document.getElementById('lc-p').value='';document.getElementById('lc-phone').value=x.telefone||x.whatsapp||'';document.getElementById('lc-value').value=x.valor||x.valor_mensal||'';document.getElementById('lc-limit').value=x.limite_conexoes||1;document.getElementById('lc-type').value=String(x.tipo||'usuario').toLowerCase().includes('teste')?'teste':'usuario';show('lc-user-modal')}
async function saveUser(){
const body={usuario:document.getElementById('lc-u').value,senha:document.getElementById('lc-p').value,dias:Number(document.getElementById('lc-days').value)||30,tipo:document.getElementById('lc-type').value,telefone:document.getElementById('lc-phone').value,whatsapp:document.getElementById('lc-phone').value,valor:Number(document.getElementById('lc-value').value)||0,valor_mensal:Number(document.getElementById('lc-value').value)||0,limite_conexoes:Number(document.getElementById('lc-limit').value)||1};
if(editing)body.id=editing.id;
const url=editing?'/api/admin/usuarios/editar':'/api/admin/usuarios';
const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(body)});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível salvar.');
else{close('lc-user-modal');await load()}
}
function openTest(){document.getElementById('lc-test-hours').value=1;show('lc-test-modal')}
function setHours(h){document.getElementById('lc-test-hours').value=h}
async function createTest(){
const horas=Math.max(1,Number(document.getElementById('lc-test-hours').value)||1);
const limite=Math.max(1,Number(document.getElementById('lc-test-limit').value)||1);
const r=await fetch('/api/admin/usuarios/teste',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({horas,limite_conexoes:limite,valor:0})});
const j=await r.json().catch(()=>({}));
if(!r.ok||j.sucesso===false)alert(j.mensagem||'Não foi possível criar o teste.');
else{close('lc-test-modal');await load()}
}
async function renew(id){if(!id)return;const dias=Number(prompt('Quantos dias deseja renovar?',30));if(!dias)return;await fetch('/api/admin/usuarios/renovar',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id,dias})});await load()}
async function status(id){if(!id)return;await fetch('/api/admin/usuarios/status',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
async function del(id){if(!id||!confirm('Excluir este usuário permanentemente?'))return;await fetch('/api/admin/usuarios/excluir',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({id})});await load()}
function show(id){document.getElementById(id).style.display='flex'}
function close(id){document.getElementById(id).style.display='none'}
load();setInterval(load,15000);
return{load,render,openUser,edit,saveUser,openTest,setHours,createTest,renew,status,del,show,close}
})();
</script>




<script id="LUKA-FUNCTIONAL-NAV">
(function(){

let activeFilter='all';

function rows(){
return [...document.querySelectorAll('#lc-body .lk-user-row')];
}

function filterUsers(filter){

activeFilter=filter||'all';

rows().forEach(row=>{
row.style.display='';
});

const allUsers=window.LUKA_ADMIN_USERS||[];

rows().forEach(row=>{

const id=row.dataset.userId;

const u=allUsers.find(x=>String(x.id)===String(id));

if(!u) return;

const status=String(
u.status||u.estado||u.situacao||''
).toLowerCase();

const tipo=String(
u.tipo||u.role||u.perfil||''
).toLowerCase();

const online=
u.online===true||
u.online===1||
u.conectado===true||
u.conectado===1||
Number(u.conexoes_utilizadas||0)>0;

const expirado=
status.includes('expir')||
status.includes('venc')||
status==='inativo'||
status==='inactive';

let mostrar=true;

if(filter==='online')
mostrar=online;

if(filter==='active')
mostrar=!expirado &&
(status===''||
status.includes('ativo')||
status==='active'||
u.ativo===true||
u.ativo===1);

if(filter==='tests')
mostrar=tipo.includes('teste')||tipo.includes('test');

if(filter==='expired')
mostrar=expirado;

if(filter==='revendedor')
mostrar=tipo.includes('revendedor');

row.style.display=mostrar?'':'none';

});

document.querySelectorAll('#LUKA-CENTRAL .lc-card').forEach(card=>{
card.classList.remove('lk-filter-active');
if(card.dataset.filter===filter)
card.classList.add('lk-filter-active');
});

const label=document.getElementById('lk-active-filter');

if(label){

const names={
all:'Todos os usuários',
online:'Usuários online',
active:'Usuários ativos',
tests:'Testes',
expired:'Expirados',
revendedor:'Revendedores'
};

label.textContent=names[filter]||names.all;

}

}

function prepareCards(){

document.querySelectorAll('#LUKA-CENTRAL .lc-card').forEach(card=>{

if(card.dataset.lkCleanBound==='1') return;

const text=(card.innerText||'').toLowerCase();

let filter='all';

if(text.includes('online'))
filter='online';
else if(text.includes('teste'))
filter='tests';
else if(text.includes('expir'))
filter='expired';
else if(text.includes('ativo'))
filter='active';
else if(text.includes('revendedor'))
filter='revendedor';

card.dataset.filter=filter;
card.dataset.lkCleanBound='1';

card.addEventListener('click',function(e){

e.preventDefault();
e.stopPropagation();

filterUsers(filter);

const table=document.querySelector('#LUKA-CENTRAL .lc-table');

if(table){
table.scrollIntoView({
behavior:'auto',
block:'start'
});
}

});

});

}

function installHeader(){

const panel=document.querySelector('#LUKA-CENTRAL .lc-panel');

if(!panel) return;

if(!document.getElementById('lk-active-filter')){

const toolbar=panel.querySelector('.lc-toolbar');

if(toolbar){

const label=document.createElement('span');

label.id='lk-active-filter';
label.className='lk-filter-label';
label.textContent='Todos os usuários';

toolbar.appendChild(label);

}

}

}

function boot(){

prepareCards();
installHeader();

}

boot();

setTimeout(boot,500);
setTimeout(boot,1500);

})();
</script>



<script id="LUKA-ADMIN-NAV-FINAL">
(function(){

function instalar(){

const central=document.getElementById('LUKA-CENTRAL');
if(!central)return;

if(document.getElementById('lk-admin-navigation'))return;

const top=central.querySelector('.lc-top');
if(!top)return;

