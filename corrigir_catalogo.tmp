const fs = require('fs');

const p = 'server.js';

let s = fs.readFileSync(p, 'utf8');

const marca = '/api/catalogo';

const inicioBusca = s.indexOf(marca);

const inicio = s.lastIndexOf('app.get(', inicioBusca);

const fim = s.indexOf('// ADMIN', inicio);

if (inicio < 0 || fim < 0) {
    throw new Error('BLOCO NAO ENONTRADO');
}

