<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LUKAFILMES - Filmes</title>
<link rel="stylesheet" href="../css/style.css">

<style>

/* ==========================================
   FUNDO CINEMATOGRÁFICO
   IGUAL AO LOGIN
   ========================================== */

html,
body {
    min-height: 100%;
}

body {
    position: relative;
    background: #000 !important;
}

/* VÍDEO */
#fundoFilmes {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    z-index: 0;
    pointer-events: none;
}

/* IFRAME DO TRAILER */
#trailerFilmes {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 120vw;
    height: 67.5vw;

    min-width: 177.78vh;
    min-height: 100vh;

    transform:
        translate(-50%, -50%)
        scale(1.12);

    border: 0;
    pointer-events: none;
}

/* ESCURECIMENTO */
#fundoFilmesEscuro {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    z-index: 1;
    pointer-events: none;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.90),
            rgba(0,0,0,.58),
            rgba(0,0,0,.82)
        ),
        linear-gradient(
            180deg,
            rgba(0,0,0,.65),
            transparent 40%,
            rgba(0,0,0,.95)
        );
}

/* CONTEÚDO DA PÁGINA NA FRENTE */
.pagina {
    position: relative;
    z-index: 2;
}

/* TOPO TRANSPARENTE */
.topo {
    position: relative;
    z-index: 3;

    background: rgba(5,5,5,.65);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-radius: 12px;
    padding: 15px 20px;

    border: 1px solid rgba(255,255,255,.08);
}

/* CARDS NA FRENTE */
.grade {
    position: relative;
    z-index: 3;
}

.grade .filme {
    position: relative;
    z-index: 3;

    background: rgba(18,18,18,.88);

    box-shadow:
        0 12px 35px rgba(0,0,0,.60);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.grade .filme:hover {
    transform:
        translateY(-8px)
        scale(1.03);

    box-shadow:
        0 20px 50px rgba(0,0,0,.80),
        0 0 20px rgba(229,9,20,.20);
}

.grade .filme img {
    transition: transform .45s ease;
}

.grade .filme:hover img {
    transform: scale(1.06);
}

@media (max-width: 700px) {

    #trailerFilmes {
        transform:
            translate(-50%, -50%)
            scale(1.35);
    }

}

body{
    margin:0;
    background:#080808;
    color:#fff;
    font-family:Arial,sans-serif;
}

.pagina{
    padding:25px 5%;
}

.topo{
    display:flex;
    align-items:center;
    gap:20px;
    margin-bottom:30px;
}

.voltar{
    background:#222;
    color:#fff;
    border:0;
    padding:10px 18px;
    border-radius:6px;
    cursor:pointer;
}

.grade{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
    gap:20px;
}

.filme{
    background:#151515;
    border-radius:8px;
    overflow:hidden;
    cursor:pointer;
    transition:.2s;
}

.filme:hover{
    transform:scale(1.03);
}

.filme img{
    width:100%;
    height:240px;
    object-fit:cover;
    display:block;
}

.info{
    padding:10px;
}

.info h3{
    font-size:15px;
    margin:0 0 5px;
}

.info p{
    margin:0;
    color:#aaa;
    font-size:13px;
}

.carregando{
    text-align:center;
    padding:50px;
    color:#aaa;
}


/* ==========================================================
   PESQUISA MOBILE — ESTILO NETFLIX
   ========================================================== */

@media (max-width: 700px) {

    /* Campo de pesquisa */
    #pesquisaFilmes,
    #pesquisaSeries,
    input[type="search"],
    input[placeholder*="pesquisa" i],
    input[placeholder*="buscar" i] {

        width: min(100%, 260px) !important;
        max-width: 260px !important;
        height: 42px !important;

        padding: 0 46px 0 16px !important;

        margin-left: auto !important;
        margin-right: auto !important;

        border-radius: 24px !important;

        font-size: 14px !important;
        box-sizing: border-box !important;

    }

    /* Área/botão da pesquisa */
    .pesquisa,
    .barra-pesquisa,
    .search-box,
    .search-container {

        width: auto !important;
        max-width: 280px !important;

        margin-left: auto !important;
        margin-right: auto !important;

        display: flex !important;
        justify-content: center !important;
        align-items: center !important;

    }

}


/* ==========================================================
   PESQUISA MOBILE — COMPACTA
   ========================================================== */
@media (max-width: 700px) {

    .pesquisa-filmes,
    .pesquisa,
    .barra-pesquisa,
    .search-box,
    .search-container {
        width: 100% !important;
        max-width: 320px !important;
        margin-left: auto !important;
        margin-right: auto !important;
    }

    .pesquisa-filmes input,
    .pesquisa input,
    .barra-pesquisa input,
    .search-box input,
    .search-container input,
    input[type="search"],
    input[placeholder*="pesquisa" i],
    input[placeholder*="buscar" i] {
        width: 100% !important;
        max-width: 320px !important;
        height: 46px !important;
        box-sizing: border-box !important;

        padding: 0 55px 0 17px !important;

        border-radius: 25px !important;
        font-size: 14px !important;
    }

    .pesquisa-filmes button,
    .pesquisa button,
    .barra-pesquisa button,
    .search-box button,
    .search-container button {
        width: 38px !important;
        height: 38px !important;

        border-radius: 50% !important;
        font-size: 17px !important;
    }
}

</style>
</head>

<body>

<div id="fundoFilmes">
    <iframe
        id="trailerFilmes"
        src="https://www.youtube.com/embed/aBlsrtxuwss?autoplay=1&mute=1&controls=0&loop=1&playlist=aBlsrtxuwss&rel=0&modestbranding=1"
        allow="autoplay; fullscreen"
        frameborder="0">
    </iframe>
</div>

<div id="fundoFilmesEscuro"></div>


<div class="pagina">

    <div class="topo">
        <button class="voltar" onclick="history.back()">← Voltar</button>
        <h1>🎬 Filmes</h1>
    </div>

    <div id="grade" class="grade">
        <div class="carregando">Carregando filmes...</div>
    </div>

</div>

<script>

let paginaFilmes = 1;
let carregandoFilmes = false;
let acabouFilmes = false;

const filmesCarregados = new Set();

async function carregarFilmes() {

    if (carregandoFilmes || acabouFilmes) {
        return;
    }

    carregandoFilmes = true;

    const grade = document.getElementById("grade");

    try {

        const resposta = await fetch(
            "/api/catalogo-filmes?pagina=" + paginaFilmes
        );

        const dados = await resposta.json();

        if (!dados.sucesso) {
            throw new Error(
                dados.mensagem || "Erro no catálogo"
            );
        }

        const filmes = Array.isArray(dados.filmes)
            ? dados.filmes
            : [];

        let adicionados = 0;

        for (const filme of filmes) {

            const id = String(
                filme.id ||
                filme.tmdb_id ||
                filme.titulo ||
                ""
            ).trim();

            if (!id || filmesCarregados.has(id)) {
                continue;
            }

            filmesCarregados.add(id);

            const card = document.createElement("div");

            card.className = "filme";

            card.innerHTML =
                '<img src="' +
                (filme.capa || "") +
                '" alt="">' +
                '<div class="info">' +
                '<h3>' +
                (filme.titulo || "Sem título") +
                '</h3>' +
                '<p>' +
                (filme.ano || "") +
                '</p>' +
                '</div>';

            card.onclick = function() {

                localStorage.setItem(
                    "filmeSelecionado",
                    JSON.stringify(filme)
                );

                sessionStorage.setItem(
                    "lukafilmes_estado_filmes",
                    JSON.stringify({
                        pagina: paginaFilmes,
                        scroll: window.scrollY
                    })
                );

                location.href =
                    "/paginas/filme.html";
            };

            grade.appendChild(card);

            adicionados++;
        }

        if (paginaFilmes === 1 && adicionados === 0) {

            grade.innerHTML =
                '<div class="carregando">' +
                'Nenhum filme encontrado.' +
                '</div>';

        }

        if (dados.acabou || filmes.length === 0) {

            acabouFilmes = true;

            const fim = document.createElement("div");

            fim.className = "carregando";

            fim.textContent =
                "Você chegou ao fim do catálogo.";

            grade.appendChild(fim);

        } else {

            paginaFilmes++;
        }

    } catch (erro) {

        console.error(
            "[FILMES]",
            erro
        );

        /*
         * Se for uma falha temporária do TMDB,
         * permitimos tentar novamente quando
         * o usuário continuar descendo.
         */

    } finally {

        carregandoFilmes = false;
    }
}


/*
 * Primeiros 40 filmes:
 * duas páginas do nosso endpoint.
 */

async function carregarPrimeirosFilmes() {

    await carregarFilmes();

    if (!acabouFilmes) {
        await carregarFilmes();
    }
}


/*
 * Carrega mais filmes quando o usuário
 * chega perto do final da página.
 */

window.addEventListener(
    "scroll",
    function() {

        if (carregandoFilmes || acabouFilmes) {
            return;
        }

        const distancia =
            document.documentElement.scrollHeight -
            (
                window.scrollY +
                window.innerHeight
            );

        if (distancia < 1000) {
            carregarFilmes();
        }
    },
    {
        passive: true
    }
);


async function iniciarFilmesComEstado() {

    const salvo = sessionStorage.getItem(
        "lukafilmes_estado_filmes"
    );

    if (!salvo) {
        await carregarPrimeirosFilmes();
        return;
    }

    let estado;

    try {
        estado = JSON.parse(salvo);
    } catch (e) {
        sessionStorage.removeItem(
            "lukafilmes_estado_filmes"
        );
        await carregarPrimeirosFilmes();
        return;
    }

    const paginasSalvas = Math.max(
        1,
        Number(estado.pagina || 1)
    );

    paginaFilmes = 1;

    for (let i = 0; i < paginasSalvas; i++) {
        await carregarFilmes();
    }

    sessionStorage.removeItem(
        "lukafilmes_estado_filmes"
    );

    setTimeout(function () {
        window.scrollTo({
            top: Number(estado.scroll || 0),
            behavior: "instant"
        });
    }, 700);
}

iniciarFilmesComEstado();

</script>

<script src="../js/navegacao.js"></script>
</body>
</html>







