<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LUKAFILMES - Filme</title>

<link rel="stylesheet" href="../css/style.css">



</head>

<body>






<div class="pagina-filme">

    <div class="voltar-area">
        <a href="#" class="voltar" id="voltarFilmes">
            ← Voltar para filmes
        </a>
    </div>

    <main class="detalhes">

        <div class="poster">
            <img id="poster" src="" alt="Capa do filme">
        </div>

        <div class="informacoes">

            <h1 id="titulo">Carregando...</h1>

            <div id="dados" class="dados"></div>

            <div id="generos" class="generos"></div>

            <div class="sinopse-box">

                <h2 class="sinopse-titulo">
                    Sinopse
                </h2>

                <p id="sinopse" class="sinopse">
                    Carregando sinopse...
                </p>

            </div>

            <div
                class="botoes-assistir"
                style="
                    display:flex;
                    flex-wrap:wrap;
                    justify-content:center;
                    align-items:center;
                    gap:12px;
                    margin:20px auto;
                ">

                <a
                    class="assistir"
                    id="botaoAssistir"
                    href="#">
                    ▶ PLAY
                </a>

                <a
                    class="assistir"
                    id="botaoAssistirOrigem"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display:none;">
                    🌐 SITE DE ORIGEM
                </a>

                <a
                    class="assistir"
                    id="botaoMinhaListaFilme"
                    href="javascript:void(0)"
                    style="text-decoration:none;">
                    ＋ Minha lista
                </a>

                

<section
        class="trailer"
        id="trailerContainer"
        style="display:none;">

        <h2>▶ Trailer</h2>

        <div class="trailer-video">

            <iframe
                id="trailerFrame"
                src=""
                title="Trailer do filme"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
            </iframe>

        </div>

    </section>

            </div>

    </main>

    <section
        class="player-filme"
        id="playerFilme"
        style="display:none;">

        <h2>🎬 Escolha o Player</h2>

        <div
            id="listaPlayers"
            class="lista-plays">

            <div class="play-card">
                <div class="play-numero">PLAY 1</div>
                
                <button type="button"
                        class="play-btn player-btn"
                        data-player="1">
                    ▶ PLAY
                </button>
            </div>

            <div class="play-card">
                <div class="play-numero">PLAY 2</div>
                
                <button type="button"
                        class="play-btn player-btn"
                        data-player="2">
                    ▶ PLAY
                </button>
            </div>

            <div class="play-card">
                <div class="play-numero">PLAY 3</div>

                <button type="button"
                        class="play-btn player-btn"
                        data-player="3">
                    ▶ PLAY
                </button>
            </div>

            <div class="play-card">
                <div class="play-numero">PLAY 4</div>

                <button type="button"
                        class="play-btn player-btn"
                        data-player="4">
                    ▶ PLAY
                </button>
            </div>

        </div>

        <div class="player-video" id="playerVideoArea">
            <button
                type="button"
                id="playCentralFilme"
                class="play-central-filme">
                ▶ PLAY
            </button>

            <iframe id="filmeFrame" src="" allow="autoplay;encrypted-media;picture-in-picture" allowfullscreen frameborder="0" scrolling="no" style="width:100%;border:0;height:70vh"></iframe>
        </div>

    </section>
    

</div>







</body>
</html>
















