    <style>

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #050505;
            color: #fff;
            font-family: Arial, Helvetica, sans-serif;
        }

        .pagina-serie {
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            padding-bottom: 80px;
            background: #050505;
        }

        /* ==========================================
           FUNDO
           ========================================== */

        .pagina-serie::before {

            content: "";

            position: absolute;

            top: 0;
            left: 0;
            right: 0;

            height: 780px;

            background-image:
                linear-gradient(
                    to bottom,
                    rgba(5, 5, 5, .15),
                    rgba(5, 5, 5, .30) 35%,
                    rgba(5, 5, 5, .65) 65%,
                    #050505 100%
                ),
                var(--fundo-serie);

            background-size: cover;

            background-position: center top;

            filter: blur(2px);

            transform: scale(1.03);

            opacity: .9;

            z-index: 0;
        }

        .pagina-serie::after {

            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    to bottom,
                    transparent 0,
                    transparent 25%,
                    rgba(5, 5, 5, .25) 45%,
                    #050505 78%
                );

            z-index: 0;

            pointer-events: none;
        }


        /* ==========================================
           VOLTAR
           ========================================== */

        .voltar-area {

            position: relative;

            z-index: 5;

            max-width: 1200px;

            margin: auto;

            padding: 25px;
        }

        .voltar {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding: 11px 18px;

            color: #fff;

            text-decoration: none;

            background: rgba(0, 0, 0, .55);

            border: 1px solid rgba(255, 255, 255, .14);

            border-radius: 30px;

            backdrop-filter: blur(12px);

            font-weight: bold;

            transition: .25s;
        }

        .voltar:hover {

            background: #e50914;

            border-color: #e50914;

            transform: translateX(-3px);
        }


        /* ==========================================
           DETALHES
           ========================================== */

        .detalhes-serie {

            position: relative;

            z-index: 2;

            width: 100%;

            max-width: 1000px;

            margin: 40px auto 0;

            padding: 0 20px;

            text-align: center;
        }


        /* ==========================================
           CAPA
           ========================================== */

        .poster-serie {

            width: 270px;

            margin: 0 auto 25px;
        }

        .poster-serie img {

            width: 100%;

            display: block;

            border-radius: 17px;

            border: 1px solid rgba(255, 255, 255, .18);

            box-shadow:
                0 30px 80px rgba(0, 0, 0, .9);
        }


        /* ==========================================
           TITULO
           ========================================== */

        #tituloSerie {

            margin: 0 0 15px;

            font-size: clamp(34px, 5vw, 58px);

            line-height: 1.05;

            font-weight: 900;

            text-shadow:
                0 8px 35px rgba(0, 0, 0, .95);
        }

        .dados-serie {

            color: #ddd;

            font-size: 15px;

            margin-bottom: 18px;
        }


        /* ==========================================
           SINOPSE
           ========================================== */

        .sinopse-box {

            width: 100%;

            max-width: 850px;

            margin: 25px auto 0;

            padding: 30px 35px;

            text-align: left;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, .075),
                    rgba(255, 255, 255, .025)
                );

            border: 1px solid rgba(255, 255, 255, .10);

            border-radius: 20px;

            backdrop-filter: blur(16px);

            box-shadow:
                0 25px 70px rgba(0, 0, 0, .55);
        }

        .sinopse-box h2 {

            margin: 0 0 15px;

            font-size: 22px;
        }

        .sinopse {

            margin: 0;

            color: #d1d1d1;

            font-size: 16px;

            line-height: 1.8;
        }


        /* ==========================================
           TEMPORADAS
           ========================================== */

        .temporadas {

            position: relative;

            z-index: 3;

            width: calc(100% - 40px);

            max-width: 1000px;

            margin: 55px auto 0;

            padding: 30px;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, .075),
                    rgba(255, 255, 255, .025)
                );

            border: 1px solid rgba(255, 255, 255, .10);

            border-radius: 22px;

            backdrop-filter: blur(16px);

            box-shadow:
                0 30px 80px rgba(0, 0, 0, .65);
        }

        .temporadas h2 {

            margin: 0 0 20px;

            font-size: 26px;
        }

        #selectTemporada {

            width: 100%;

            padding: 14px 16px;

            color: #fff;

            background: #151515;

            border: 1px solid rgba(255, 255, 255, .15);

            border-radius: 10px;

            outline: none;

            font-size: 16px;

            cursor: pointer;
        }


        /* ==========================================
           EPISODIOS
           ========================================== */

        .episodios {

            margin-top: 25px;

            display: grid;

            grid-template-columns:
                repeat(auto-fill, minmax(180px, 1fr));

            gap: 14px;
        }

        .episodio {

    position: relative;

    padding: 20px 17px;

    text-align: center;

    color: #fff;

    background: rgba(0, 0, 0, .18);

    border: 1px solid rgba(255, 255, 255, .08);

    border-radius: 14px;

    cursor: pointer;

    transition:
        transform .25s ease,
        background .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;

    font-family: inherit;

    min-height: 145px;

    backdrop-filter: blur(4px);

    -webkit-backdrop-filter: blur(4px);
}

.episodio span {

    transition:
        transform .25s ease,
        background .25s ease,
        box-shadow .25s ease;
}

.episodio:hover {

    background: rgba(229, 9, 20, .18);

    border-color: rgba(229, 9, 20, .65);

    transform: translateY(-4px);

    box-shadow:
        0 12px 35px rgba(0, 0, 0, .35);
}

.episodio:hover span {

    background: rgba(229, 9, 20, .9) !important;

    transform: scale(1.08);

    box-shadow:
        0 0 20px rgba(229, 9, 20, .35);
}

.episodio strong {

    display: block;

    margin-bottom: 6px;

    color: #fff;

    font-weight: 700;

    text-shadow:
        0 2px 8px rgba(0, 0, 0, .8);
}

.episodio small {

    display: block;

    color: rgba(255, 255, 255, .58);

    line-height: 1.4;

    transition: color .25s ease;
}

.episodio:hover small {

    color: rgba(255, 255, 255, .9);
}
/* ==========================================
           PLAYER
           ========================================== */

        .player-serie {

            position: relative;

            z-index: 3;

            width: calc(100% - 40px);

            max-width: 1000px;

            margin: 55px auto 0;

            padding: 30px;

            text-align: center;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, .075),
                    rgba(255, 255, 255, .025)
                );

            border: 1px solid rgba(255, 255, 255, .10);

            border-radius: 22px;

            box-shadow:
                0 30px 80px rgba(0, 0, 0, .65);

            backdrop-filter: blur(16px);
        }

        .player-serie h2 {

            margin: 0 0 22px;

            font-size: 26px;
        }

        .player-video {

            width: 100%;

            aspect-ratio: 16 / 9;

            overflow: hidden;

            background: #000;

            border-radius: 15px;

            box-shadow:
                0 20px 60px rgba(0, 0, 0, .7);
        }

        .player-video iframe {

            width: 100%;

            height: 100%;

            border: 0;

            display: block;
        }


        /* ==========================================
           MOBILE
           ========================================== */

        @media (max-width: 700px) {

            .voltar-area {

                padding: 18px 15px 0;
            }

            .detalhes-serie {

                margin-top: 35px;

                padding: 0 15px;
            }

            .poster-serie {

                width: 205px;
            }

            .sinopse-box {

                padding: 22px 20px;
            }

            .temporadas,
            .player-serie {

                width: calc(100% - 24px);

                padding: 18px 14px;

                border-radius: 17px;
            }

            .episodios {

                grid-template-columns: 1fr;
            }

            #tituloSerie {

                font-size: 36px;
            }

        }

    
