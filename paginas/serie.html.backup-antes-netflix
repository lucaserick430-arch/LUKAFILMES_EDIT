    font-size: 24px;
    font-weight: 700;
}

/* Select */

#selectTemporada {
    background: #181818;
    border-color: rgba(255,255,255,.10);
    border-radius: 8px;
    transition: border-color .2s ease, box-shadow .2s ease;
}

#selectTemporada:focus {
    border-color: rgba(229,9,20,.65);
    box-shadow: 0 0 0 3px rgba(229,9,20,.12);
}

/* Episódios */

.episodio {
