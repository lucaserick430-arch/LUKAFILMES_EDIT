/* ==========================================
   FUNDO CINEMATOGRÁFICO
   IGUAL AO LOGIN
   ========================================== */

html,
body {
    min-height: 100%;
}

body {
    position: relative;
    background: #000 !important;
}

/* VÍDEO */
#fundoFilmes {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    z-index: 0;
    pointer-events: none;
}

/* IFRAME DO TRAILER */
#trailerFilmes {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 120vw;
    height: 67.5vw;

    min-width: 177.78vh;
    min-height: 100vh;

    transform:
        translate(-50%, -50%)
        scale(1.12);

    border: 0;
    pointer-events: none;
}

/* ESCURECIMENTO */
#fundoFilmesEscuro {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    z-index: 1;
    pointer-events: none;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.90),
            rgba(0,0,0,.58),
            rgba(0,0,0,.82)
        ),
        linear-gradient(
            180deg,
            rgba(0,0,0,.65),
            transparent 40%,
            rgba(0,0,0,.95)
        );
}

/* CONTEÚDO DA PÁGINA NA FRENTE */
.pagina {
    position: relative;
    z-index: 2;
}

/* TOPO TRANSPARENTE */
.topo {
    position: relative;
    z-index: 3;

    background: linear-gradient(180deg, rgba(20,20,20,.92), rgba(20,20,20,.55));

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-radius: 0;
    padding: 18px 24px;

    border: 1px solid rgba(255,255,255,.08);
}

/* CARDS NA FRENTE */
.grade {
    position: relative;
    z-index: 3;
}

.grade .filme {
    position: relative;
    z-index: 3;

    background: rgba(18,18,18,.88);

    box-shadow:
        0 12px 35px rgba(0,0,0,.60);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.grade .filme:hover {
    transform:
        translateY(-8px)
        scale(1.03);

    box-shadow:
        0 20px 50px rgba(0,0,0,.80),
        0 0 20px rgba(229,9,20,.20);
}

.grade .filme img {
    transition: transform .45s ease;
}

.grade .filme:hover img {
    transform: scale(1.06);
}

@media (max-width: 700px) {

    #trailerFilmes {
        transform:
            translate(-50%, -50%)
            scale(1.35);
    }

}

