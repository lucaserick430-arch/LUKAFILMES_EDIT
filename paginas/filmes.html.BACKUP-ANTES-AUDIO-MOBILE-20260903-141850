    const botaoLista=
        document.getElementById("heroLista");

    if(!botaoLista)
        return;

    botaoLista.onclick=function(){

        if(!filmeHeroAtual)
            return;

        let lista=[];

        try{

            lista=JSON.parse(
                localStorage.getItem(
                    "lukafilmes_minhalista"
                )||"[]"
            );

        }catch(e){

            lista=[];
        }

        const id=String(
            filmeHeroAtual.id||
            filmeHeroAtual.tmdb_id||
            filmeHeroAtual.titulo||
            filmeHeroAtual.nome||
            ""
        );

        const existe=lista.some(
            item=>
                String(
                    item.id||
                    item.tmdb_id||
                    item.titulo||
                    item.nome||
                    ""
                )===id
        );

        if(!existe){

            lista.push(filmeHeroAtual);

            localStorage.setItem(
                "lukafilmes_minhalista",
                JSON.stringify(lista)
            );
        }

        botaoLista.textContent=
            existe
            ?"✓ Na minha lista"
            :"✓ Adicionada";
    };
}


/*
 * Busca várias páginas do catálogo,
 * mas NÃO espera todos os trailers.
 */
async function buscarFilmes(){

    const filmes=[];
    const ids=new Set();

    const paginas=[];

    for(
        let pagina=1;
        pagina<=PAGINAS_HERO;
        pagina++
    ){
        paginas.push(pagina);
    }

    /*
     * As páginas do catálogo são buscadas em
     * lotes para não bloquear o navegador.
     */

    const TAMANHO_LOTE=10;

    for(
        let inicio=0;
        inicio<paginas.length;
        inicio+=TAMANHO_LOTE
    ){

        const lote=
            paginas.slice(
                inicio,
                inicio+TAMANHO_LOTE
            );

        const respostas=
            await Promise.all(
                lote.map(
                    async pagina=>{

                        try{

                            const resposta=
                                await fetch(
                                    (
                                        "/api/catalogo-filmes?pagina=" +
                                        pagina +
                                        (
                                            categoriaAtualPagina
                                                ? "&categoria=" +
                                                  encodeURIComponent(
                                                      categoriaAtualPagina
                                                  )
                                                : ""
                                        )
                                    )
                                );

                            if(!resposta.ok)
                                return [];

                            const dados=
                                await resposta.json();

                            return Array.isArray(dados.filmes)
                                ?dados.filmes
                                :[];

                        }catch(e){

                            return [];
                        }
                    }
                )
            );

        for(const lista of respostas){

            for(const filme of lista){

                if(!filme)
                    continue;

                const id=String(
                    filme.id||
                    filme.tmdb_id||
                    filme.titulo||
                    ""
                ).trim();

                if(!id||ids.has(id))
                    continue;

                ids.add(id);
                filmes.push(filme);
            }
        }

        /*
         * Assim que temos uma quantidade razoável
         * já podemos começar a procurar trailers.
         */

        if(filmes.length>=200)
            break;
    }

    /*
     * Embaralha os candidatos.
     */

    for(
        let i=filmes.length-1;
        i>0;
        i--
    ){

        const j=
            Math.floor(
                Math.random()*(i+1)
            );

        [filmes[i],filmes[j]]=
        [filmes[j],filmes[i]];
    }

    return filmes;
}


/*
 * Procura trailers em paralelo.
 *
 * O PRIMEIRO trailer válido é exibido
 * imediatamente.
 *
 * Os demais continuam sendo pesquisados
 * em segundo plano para formar uma base grande.
 */
async function procurarTrailersRapido(filmes){

    let indice=0;

    const encontrados=[];

    async function trabalhador(){

        while(indice<filmes.length){

            const posicao=indice++;

            const resultado=
                await buscarTrailer(
                    filmes[posicao]
                );

            if(!resultado)
                continue;

            encontrados.push(resultado);

            /*
             * PRIMEIRO TRAILER:
             * aparece imediatamente.
             */
            if(!trailerHeroJaExibido){

                trailerHeroJaExibido=true;

                const ultimo=
                    sessionStorage.getItem(
                        "lukafilmes_ultimo_hero_filme"
                    );

                const id=
                    String(
                        resultado.filme.id||
                        resultado.filme.tmdb_id||
                        ""
                    );

                if(id!==String(ultimo||"")){

                    configurarTextoHero(
                        resultado.filme
                    );

                    configurarBotoes();

                    colocarTrailer(
                        resultado.trailer
                    );

                    sessionStorage.setItem(
                        "lukafilmes_ultimo_hero_filme",
                        id
                    );

                    console.log(
                        "[HERO FILMES] PRIMEIRO TRAILER OK:",
                        resultado.filme.titulo||
                        resultado.filme.nome||
                        ""
                    );
                }
            }

            /*
             * Banco grande de trailers.
             */
            if(encontrados.length>=META_TRAILERS)
                return;
        }
    }

    const trabalhadores=[];

    for(
        let i=0;
        i<CONCORRENCIA;
        i++
    ){

        trabalhadores.push(
            trabalhador()
        );
    }

    await Promise.all(trabalhadores);

    console.log(
        "[HERO FILMES] Trailers encontrados:",
        encontrados.length
    );

    return encontrados;
}


async function iniciarHeroFilmes(){

    configurarBotoes();

    try{

        console.log(
            "[HERO FILMES] Iniciando busca rápida..."
        );

        /*
         * Primeiro pegamos os filmes.
         */
        const filmes=
            await buscarFilmes();

        console.log(
            "[HERO FILMES] Filmes candidatos:",
            filmes.length
        );

        if(!filmes.length)
            return;

        /*
         * NÃO espera 1.000 trailers.
         *
         * O primeiro válido aparece assim
         * que for encontrado.
         *
         * A busca continua em paralelo.
         */
        procurarTrailersRapido(
            filmes
        ).catch(
            erro=>
                console.warn(
                    "[HERO FILMES] Busca trailers:",
                    erro
                )
        );

    }catch(erro){

        console.error(
            "[HERO FILMES] Erro:",
            erro
        );
    }
}


if(document.readyState==="loading"){

    document.addEventListener(
        "DOMContentLoaded",
        iniciarHeroFilmes
    );

}else{

    iniciarHeroFilmes();
}

})();
</script>


