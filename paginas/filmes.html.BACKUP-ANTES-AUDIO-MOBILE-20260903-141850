<script>

/*
 * =========================================================
 * LUKAFILMES — CARREGAMENTO ALEATORIO + INFINITO
 * =========================================================
 *
 * A cada nova abertura:
 *
 * 1. Começa em uma página aleatória do catálogo.
 * 2. Os filmes dessa página são embaralhados.
 * 3. Filmes já vistos nesta sessão não entram novamente.
 * 4. Ao descer, novas páginas continuam sendo carregadas.
 * 5. O catálogo infinito continua funcionando.
 *
 * O Hero / trailer possui lógica própria e não é alterado.
 */

/*
 * LUKAFILMES — CATÁLOGO TOTALMENTE MISTURADO
 *
 * A API normalmente entrega as páginas em ordem
 * cronológica/popularidade. Para que o catálogo não
 * apareça como:
 *
 * 2024 → 2023 → 2022 → 2021...
 *
 * criamos uma fila de páginas embaralhada.
 *
 * Assim o infinite scroll pode buscar:
 *
 * página 317 → página 42 → página 189 → página 7
 * → página 401 → página 93...
 *
 * Cada página também é embaralhada individualmente.
 */

const TOTAL_PAGINAS_CATALOGO_FILMES = 500;

/*
 * =========================================================
 * LUKAFILMES — FILMES REALMENTE MISTURADOS
 * =========================================================
 *
 * A API organiza as páginas aproximadamente por época.
 *
 * Por isso, simplesmente sortear 1..500 não é suficiente:
 * as páginas 1 e 2, que concentram 2026/2025, apareceriam
 * muito pouco.
 *
 * Estratégia:
 *
 * 1. As primeiras 50 páginas são embaralhadas juntas.
 *    Isso garante uma mistura forte de 2026 até anos mais
 *    antigos logo no começo.
 *
 * 2. Depois entram as páginas 51..500, também embaralhadas.
 *
 * 3. Nenhuma página é repetida durante a sessão.
 *
 * 4. O infinite scroll continua normalmente.
 */

function embaralharFila(lista){

    const resultado = [...lista];

    for(let i = resultado.length - 1; i > 0; i--){

        const j =
            Math.floor(
                Math.random() * (i + 1)
            );

        [
            resultado[i],
            resultado[j]
        ] = [
            resultado[j],
            resultado[i]
        ];
    }

    return resultado;
}


function criarFilaPaginasFilmes(){

    const paginasIniciais =
        Array.from(
            {length: Math.min(50, TOTAL_PAGINAS_CATALOGO_FILMES)},
            (_, i) => i + 1
        );

    const paginasRestantes =
        Array.from(
            {
                length:
                    Math.max(
                        0,
                        TOTAL_PAGINAS_CATALOGO_FILMES - 50
                    )
            },
            (_, i) => i + 51
        );

    /*
     * Mistura fortemente as páginas que contêm
     * os anos mais recentes e intermediários.
     */
    const primeiras =
        embaralharFila(
            paginasIniciais
        );

    /*
     * Depois mistura todo o restante.
     */
    const restantes =
        embaralharFila(
            paginasRestantes
        );

    return [
        ...primeiras,
        ...restantes
    ];
}


const filaPaginasFilmes =
    criarFilaPaginasFilmes();

let indiceFilaPaginasFilmes = 0;

let paginaFilmes = null;

/*
 * Próxima página realmente aleatória.
 *
 * Nunca volta para uma página já utilizada
 * durante esta abertura.
 */
function proximaPaginaFilmes(){

    if(
        indiceFilaPaginasFilmes >=
        filaPaginasFilmes.length
    ){
        return null;
    }

    const pagina =
        filaPaginasFilmes[
            indiceFilaPaginasFilmes
        ];

    indiceFilaPaginasFilmes++;

    return pagina;
}

/*
 * LUKAFILMES — CATEGORIA ATUAL DA PÁGINA
 * Uma única fonte para catálogo infinito e Hero.
 */
const parametrosCategoriaPagina =
    new URLSearchParams(window.location.search);

const categoriaAtualPagina =
    String(
        parametrosCategoriaPagina.get("categoria") || ""
    ).trim().toLowerCase();


let carregandoFilmes = false;
let acabouFilmes = false;

const filmesCarregados = new Set();
const titulosFilmesCarregados = new Set();

/*
 * Página inicial aleatória.
 *
 * O catálogo possui muitas páginas.
 * Começamos em uma página diferente a cada
 * atualização para variar os primeiros filmes.
 */
/*
 * Primeira página também vem da fila totalmente
 * embaralhada.
 *
 * Se uma página estiver vazia, carregarFilmes()
 * continuará procurando outra página da fila.
 */
paginaFilmes = proximaPaginaFilmes();


/*
 * Embaralhamento local.
 */
function embaralharFilmes(lista){

    const resultado = [...lista];

    for(let i = resultado.length - 1; i > 0; i--){

        const indice =
            Math.floor(
                Math.random() * (i + 1)
            );

        [
            resultado[i],
            resultado[indice]
        ] = [
            resultado[indice],
            resultado[i]
        ];
    }

    return resultado;
}


async function carregarFilmes() {

    if (carregandoFilmes || acabouFilmes) {
        return;
    }

    carregandoFilmes = true;

    const grade =
        document.getElementById("grade");

    try {

        /*
         * Mantém a categoria durante TODO o catálogo infinito.
         */
        /*
         * AÇÃO É UMA PÁGINA EXCLUSIVA.
         *
         * Quando categoria=acao:
         * - usa somente /api/catalogo-acao
         * - nunca consulta o catálogo geral
         * - cada página continua sendo somente Ação
         */
        /*
         * CATEGORIA DO MENU
         *
         * Todas as categorias usam a mesma rota oficial.
         * O servidor aplica o filtro real do gênero no TMDB.
         *
         * Exemplo:
         * ?categoria=acao
         * ?categoria=comedia
         * ?categoria=terror
         *
         * A categoria permanece durante TODO o infinite scroll.
         */
        let urlCatalogo =
            "/api/catalogo-filmes?pagina=" +
            paginaFilmes;

        if (categoriaAtualPagina) {
            urlCatalogo +=
                "&categoria=" +
                encodeURIComponent(
                    categoriaAtualPagina
                );
        }

        const resposta = await fetch(
            urlCatalogo
        );

        if(!resposta.ok){

            throw new Error(
                "HTTP " + resposta.status
            );
        }

        const dados =
            await resposta.json();

        if (!dados.sucesso) {

            throw new Error(
                dados.mensagem ||
                "Erro no catálogo"
            );
        }

        let filmes =
            Array.isArray(dados.filmes)
                ? dados.filmes
                : [];

        /*
         * Cada página também é embaralhada.
         */
        filmes =
            embaralharFilmes(filmes);

        let adicionados = 0;

        const primeiroLote = [];


        for (const filme of filmes) {

            const id = String(
                filme.id ||
                filme.tmdb_id ||
                ""
            ).trim();

            const tituloNormalizado =
                String(
                    filme.titulo ||
                    ""
                )
                .normalize("NFD")
                .replace(/[\\u0300-\\u036f]/g, "")
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, " ")
                .trim();

            /*
             * Proteção dupla contra repetição:
             *
             * 1. ID do filme.
             * 2. Título normalizado.
             *
             * Assim o mesmo filme não entra novamente
             * mesmo que a API apresente alguma diferença
             * na identificação.
             */
            if (
                (!id && !tituloNormalizado) ||
                (id && filmesCarregados.has(id)) ||
                (tituloNormalizado &&
                 titulosFilmesCarregados.has(tituloNormalizado))
            ) {
                continue;
            }

            if(id)
                filmesCarregados.add(id);

            if(tituloNormalizado)
                titulosFilmesCarregados.add(
                    tituloNormalizado
                );

            primeiroLote.push(filme);


            const criarCard =
                function(filme) {

                    const card =
                        document.createElement("div");

                    card.className = "filme";

                    card.innerHTML =
                        '<img src="' +
                        (filme.capa || "") +
                        '" alt="' +
                        (filme.titulo || "Filme") +
                        '">' +
                        '<div class="info">' +
                        '<h3>' +
                        (filme.titulo || "Sem título") +
                        '</h3>' +
                        '<p>' +
                        (filme.ano || "") +
                        '</p>' +
                        '</div>';

                    card.onclick =
                        function() {

                            localStorage.setItem(
                                "filmeSelecionado",
                                JSON.stringify(filme)
                            );

                            sessionStorage.setItem(
                                "lukafilmes_estado_filmes",
                                JSON.stringify({
                                    pagina:
                                        paginaFilmes,
                                    scroll:
                                        window.scrollY
                                })
                            );

                            location.href =
                                "/paginas/filme.html";
                        };

                    return card;
                };


            grade.appendChild(
                criarCard(filme)
            );

            adicionados++;
        }


        /*
         * Mantém o primeiro lote disponível
         * para qualquer lógica externa da página.
         */
        if (
            primeiroLote.length
        ) {

            window.dispatchEvent(
                new CustomEvent(
                    "filmes-primeiro-lote",
                    {
                        detail:
                            primeiroLote
                    }
                )
            );
        }


        /*
         * Se esta página não trouxe nenhum
         * filme novo, avançamos para outra.
         */
        if (
            filmes.length > 0 &&
            adicionados === 0
        ){

            paginaFilmes =
                proximaPaginaFilmes();

            carregandoFilmes = false;

            if(paginaFilmes === null){
                acabouFilmes = true;
                return;
            }

            return carregarFilmes();
        }


        if (
            paginaFilmes === 1 &&
            adicionados === 0
        ) {

            grade.innerHTML =
                '<div class="carregando">' +
                'Nenhum filme encontrado.' +
                '</div>';
        }


        /*
         * IMPORTANTE:
         *
         * Como começamos em uma página aleatória,
         * não podemos considerar "acabou" apenas
         * porque uma página retornou fim.
         *
         * Continuamos usando a paginação normalmente.
         */
        if (
            dados.acabou
        ){

            /*
             * O catálogo chegou ao limite disponível.
             *
             * NÃO voltar para a página 1.
             * Isso evita repetir filmes.
             */
            acabouFilmes = true;

        } else {

            paginaFilmes = proximaPaginaFilmes();
        }


        console.log(
            "[FILMES] Página carregada:",
            paginaFilmes - 1,
            "| Novos:",
            adicionados,
            "| Total nesta sessão:",
            filmesCarregados.size
        );


    } catch (erro) {

        console.error(
            "[FILMES]",
            erro
        );

    } finally {

        carregandoFilmes = false;
    }
}


/*
 * Primeiros lotes.
 *
 * Como a página inicial já é aleatória,
 * os primeiros filmes mudam a cada atualização.
 */
async function carregarPrimeirosFilmes() {

    await carregarFilmes();

    if (!acabouFilmes) {
        await carregarFilmes();
    }
}


/*
 * =========================================================
 * SCROLL INFINITO
 * =========================================================
 */

window.addEventListener(
    "scroll",
    function() {

        if (
            carregandoFilmes ||
            acabouFilmes
        ) {
            return;
        }

        const distancia =
            document.documentElement.scrollHeight -
            (
                window.scrollY +
                window.innerHeight
            );

        if (
            distancia < 1000
        ) {

            carregarFilmes();
        }
    },
    {
        passive: true
    }
);


/*
 * =========================================================
 * RESTAURAÇÃO DA POSIÇÃO
 * =========================================================
 */

async function iniciarFilmesComEstado() {

    const salvo =
        sessionStorage.getItem(
            "lukafilmes_estado_filmes"
        );

    /*
     * Entrada normal na página:
     * começa em uma página aleatória.
     */
    if (!salvo) {

        await carregarPrimeirosFilmes();

        return;
    }


    let estado;

    try {

        estado =
            JSON.parse(salvo);

    } catch (e) {

        sessionStorage.removeItem(
            "lukafilmes_estado_filmes"
        );

        await carregarPrimeirosFilmes();

        return;
    }


    /*
     * Ao voltar de um filme,
     * reconstruímos aproximadamente
     * as páginas necessárias.
     */
    const paginasSalvas =
        Math.max(
            1,
            Number(
                estado.pagina || 1
            )
        );


    /*
     * Para restauração de posição,
     * começamos novamente pelo catálogo.
     */
    paginaFilmes = 1;

    for (
        let i = 0;
        i < paginasSalvas;
        i++
    ) {

        await carregarFilmes();
    }


    sessionStorage.removeItem(
        "lukafilmes_estado_filmes"
    );


    setTimeout(
        function() {

            window.scrollTo({
                top:
                    Number(
                        estado.scroll || 0
                    ),
                behavior:
                    "instant"
            });

        },
        700
    );
}


iniciarFilmesComEstado();

</script>

