function limparCapa(){

    const hero=document.getElementById("heroFilme");

    if(hero)
        hero.style.backgroundImage="none";
}


function colocarTrailer(trailer){

    const iframe=
        document.getElementById("trailerFilmes");

    if(!iframe||!trailer)
        return false;

    const chave=
        trailer.chave||
        trailer.key||
        "";

    if(!chave)
        return false;

    const key=
        encodeURIComponent(String(chave));

    iframe.src=
        "https://www.youtube.com/embed/"+
        key+
        "?autoplay=1"+
        "&mute=1"+
        "&controls=0"+
        "&loop=1"+
        "&playlist="+key+
        "&rel=0"+
        "&modestbranding=1"+
        "&playsinline=1"+
        "&iv_load_policy=3";

    limparCapa();

    return true;
}


async function buscarTrailer(filme){

    const id=
        filme?.id||
        filme?.tmdb_id;

    if(!id)
        return null;

    try{

        const resposta=
            await fetch(
                "/api/filme/"+
                encodeURIComponent(id)+
                "/videos"
            );

        if(!resposta.ok)
            return null;

        const dados=
            await resposta.json();

        const trailer=
            dados?.trailer;

        if(
            trailer&&
            (
                trailer.chave||
                trailer.key
            )
        ){

            return {
                filme:filme,
                trailer:trailer
            };
        }

    }catch(e){}

    return null;
}


