<script>

(function () {

    const TMDB_IMAGE =
        "https://image.tmdb.org/t/p/w500";


    /* ==========================================
       ESCAPAR HTML
       ========================================== */

    function escaparHTML(texto) {

        const div = document.createElement("div");

        div.textContent = texto || "";

        return div.innerHTML;

    }


    /* ==========================================
       CRIAR CARD
       ========================================== */

    function criarCard(serie) {const card =
            document.createElement("div");

        card.className =
            "card-serie";


        const imagem =
            serie.capa ||
            (
                serie.poster_path
                    ? TMDB_IMAGE + serie.poster_path
                    : ""
            );


        const titulo =
            serie.titulo ||
            serie.name ||
            serie.original_name ||
            "Sem título";


        const nota =
            Number(
                serie.nota ??
                serie.vote_average ??
                0
            ).toFixed(1);


        const ano =
            serie.ano ||
            (
                serie.first_air_date
                    ? serie.first_air_date.substring(0, 4)
                    : ""
            );


        card.innerHTML = `

            <img
                src="${imagem}"
                alt="${escaparHTML(titulo)}"
                loading="lazy">

            <div class="card-serie-info">

                <h3>
                    ${escaparHTML(titulo)}
                </h3>

                <p>
                    ⭐ ${nota}
                    ${ano ? " • " + ano : ""}
                </p>

            </div>

        `;


        /* ======================================
           CLIQUE NA SÉRIE
           ====================================== */

        card.addEventListener(
            "click",
            function () {

                localStorage.setItem(
                    "serieSelecionada",
                    JSON.stringify(serie)
                );

                /*
                 * Por enquanto abrimos uma página
                 * própria da série.
                 *
                 * Vamos criar serie.html
                 * no próximo passo.
                 */

                sessionStorage.setItem(
                    "lukafilmes_estado_series",
                    JSON.stringify({
                        pagina: paginaSeries,
                        scroll: window.scrollY
                    })
                );

                window.location.href =
                    "serie.html";

            }
        );


        return card;

    }


    /* ==========================================
       MOSTRAR CARDS
       ========================================== */

    function mostrarSeries(
        container,
        series
    ) {

        container.innerHTML = "";


        if (
            !Array.isArray(series) ||
            series.length === 0
        ) {

            container.innerHTML = `

                <div class="sem-resultados">
                    Nenhuma série encontrada.
                </div>

            `;

            return;

        }


        series.forEach(function (serie) {

            container.appendChild(
                criarCard(serie)
            );

        });

    }
    /* ==========================================
       CATÁLOGO INFINITO DE SÉRIES
       MESMA LÓGICA DOS FILMES
       ATÉ 10.000 SÉRIES
       ========================================== */

    let paginaSeries = 1;

    // ==========================================
    // RESTAURAR ESTADO DA LISTAGEM
    // ==========================================

    const estadoSeriesSalvo =
        sessionStorage.getItem("lukafilmes_estado_series");

    let restaurandoSeries =
        !!estadoSeriesSalvo;

    let estadoSeries = null;

    if (estadoSeriesSalvo) {
        try {
            estadoSeries =
                JSON.parse(estadoSeriesSalvo);

            paginaSeries =
                Number(estadoSeries.pagina || 1);

        } catch (e) {
            sessionStorage.removeItem(
                "lukafilmes_estado_series"
            );

            restaurandoSeries = false;
        }
    }
    let carregandoSeries = false;
    let acabouSeries = false;

    const seriesCarregadas = new Set();


    async function carregarSeries() {

        if (carregandoSeries || acabouSeries) {
            return;
        }

        carregandoSeries = true;

        const grade =
            document.getElementById("populares");

        try {

            const resposta = await fetch(
                "/api/catalogo-series?pagina=" +
                paginaSeries
            );

            const dados = await resposta.json();

            if (!dados.sucesso) {

                throw new Error(
                    dados.mensagem ||
                    "Erro no catálogo de séries"
                );

            }

            const series =
                Array.isArray(dados.series)
                    ? dados.series
                    : Array.isArray(dados.resultados)
                        ? dados.resultados
                        : [];

            let adicionados = 0;


            for (const serie of series) {

                /*
                 * Esconde o Hockey Psychology somente
                 * no começo do catálogo.
                 *
                 * Depois da página 2 ele pode aparecer
                 * normalmente no carregamento infinito.
                 */
                if (
                    paginaSeries <= 2 &&
                    serie &&
                    String(serie.id || "") === "310518"
                ) {
                    continue;
                }


                const id = String(
                    serie.id ||
                    serie.tmdb_id ||
                    serie.titulo ||
                    ""
                ).trim();


                if (
                    !id ||
                    seriesCarregadas.has(id)
                ) {
                    continue;
                }


                seriesCarregadas.add(id);


                /*
                 * Usa exatamente o criador de cards
                 * que já existe na página de séries.
                 */

                const card =
                    criarCard(serie);


                grade.appendChild(card);

                adicionados++;

            }


            if (
                paginaSeries === 1 &&
                adicionados === 0
            ) {

                grade.innerHTML =
                    '<div class="carregando">' +
                    'Nenhuma série encontrada.' +
                    '</div>';

            }


            if (
                dados.acabou ||
                dados.proximaPagina === false ||
                series.length === 0 ||
                seriesCarregadas.size >= 10000
            ) {

                acabouSeries = true;


                const fim =
                    document.createElement("div");

                fim.className =
                    "carregando";

                fim.textContent =
                    "Você chegou ao fim do catálogo.";

                grade.appendChild(fim);


            } else {

                paginaSeries++;

            }


            console.log(
                "[SERIES] Página:",
                paginaSeries,
                "| Total:",
                seriesCarregadas.size
            );


        } catch (erro) {

            console.error(
                "[SERIES]",
                erro
            );

        } finally {

            carregandoSeries = false;

        }

    }


    /*
     * Primeiras 40 séries:
     * duas páginas do nosso endpoint.
     */

    async function carregarPrimeirasSeries() {

        await carregarSeries();

        if (!acabouSeries) {
            await carregarSeries();
        }

    }


    /*
     * Carrega mais séries quando o usuário
     * chega perto do final da página.
     */

    window.addEventListener(
        "scroll",
        function() {

            if (
                carregandoSeries ||
                acabouSeries
            ) {
                return;
            }


            const distancia =
                document.documentElement.scrollHeight -
                (
                    window.scrollY +
                    window.innerHeight
                );


            if (distancia < 1000) {

                carregarSeries();

            }

        },
        {
            passive: true
        }
    );


    /*
     * Primeira carga.
     */

    async function iniciarSeriesComEstado() {

        const salvo =
            sessionStorage.getItem(
                "lukafilmes_estado_series"
            );

        // Entrada normal na página de séries
        if (!salvo) {

            await carregarPrimeirasSeries();

            return;
        }

        let estado;

        try {

            estado = JSON.parse(salvo);

        } catch (erro) {

            console.warn(
                "[SÉRIES] Estado inválido:",
                erro
            );

            sessionStorage.removeItem(
                "lukafilmes_estado_series"
            );

            await carregarPrimeirasSeries();

            return;
        }

        const paginasSalvas =
            Math.max(
                1,
                Number(estado.pagina || 1)
            );

        // Começa novamente para reconstruir
        // exatamente a quantidade de páginas
        // que o usuário já tinha carregado.
        paginaSeries = 1;

        for (
            let i = 0;
            i < paginasSalvas;
            i++
        ) {

            await carregarSeries();

        }

        // O estado já foi utilizado.
        sessionStorage.removeItem(
            "lukafilmes_estado_series"
        );

        // Aguarda o navegador terminar de
        // montar todos os cards antes de
        // restaurar a posição.
        setTimeout(function () {

            const posicao =
                Number(
                    estado.scroll || 0
                );

            window.scrollTo({
                top: posicao,
                left: 0,
                behavior: "instant"
            });

            // Segunda tentativa para garantir
            // a posição mesmo em celulares mais lentos.
            setTimeout(function () {

                window.scrollTo({
                    top: posicao,
                    left: 0,
                    behavior: "instant"
                });

            }, 400);

        }, 700);

    }

    iniciarSeriesComEstado();

    /* ==========================================
       PESQUISA
       ========================================== */

    const campo =
        document.getElementById(
            "pesquisaSeries"
        );

    const botao =
        document.getElementById(
            "botaoPesquisa"
        );

    const resultado =
        document.getElementById(
            "resultadoPesquisa"
        );

    const lista =
        document.getElementById(
            "listaResultados"
        );

    const categorias =
        document.getElementById(
            "conteudoCategorias"
        );


    let temporizador = null;


    async function pesquisarSeries() {

        const busca =
            campo.value.trim();


        if (!busca) {

            resultado.style.display =
                "none";

            categorias.style.display =
                "block";

            return;

        }


        resultado.style.display =
            "block";

        categorias.style.display =
            "none";


        lista.innerHTML = `

            <div class="carregando">
                🔎 Procurando séries...
            </div>

        `;


        try {

            const resposta =
                await fetch(
                    "/api/pesquisar-series?q=" +
                    encodeURIComponent(busca)
                );


            const dados =
                await resposta.json();


            if (
                dados &&
                dados.sucesso &&
                Array.isArray(dados.resultados)
            ) {

                mostrarSeries(
                    lista,
                    dados.resultados
                );

            } else {

                lista.innerHTML = `

                    <div class="sem-resultados">
                        Nenhuma série encontrada.
                    </div>

                `;

            }

        } catch (erro) {

            console.error(
                "[ERRO PESQUISA SERIES]",
                erro
            );

            lista.innerHTML = `

                <div class="sem-resultados">
                    Erro ao pesquisar séries.
                </div>

            `;

        }

    }


    botao.addEventListener(
        "click",
        pesquisarSeries
    );


    campo.addEventListener(
        "keydown",
        function (evento) {

            if (
                evento.key === "Enter"
            ) {

                pesquisarSeries();

            }

        }
    );


    /* ==========================================
       PESQUISA AUTOMÁTICA
       ========================================== */

    campo.addEventListener(
        "input",
        function () {

            clearTimeout(
                temporizador
            );


            const valor =
                campo.value.trim();


            if (!valor) {

                resultado.style.display =
                    "none";

                categorias.style.display =
                    "block";

                return;

            }


            temporizador =
                setTimeout(
                    pesquisarSeries,
                    500
                );

        }
    );

})();

