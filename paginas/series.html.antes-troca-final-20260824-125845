<script id="hero-series-dinamico">

/* =========================================================
   LUKAFILMES — HERO AUTOMÁTICO DE SÉRIES
   =========================================================

   A cada atualização da página:

   1. Busca séries automaticamente.
   2. Escolhe uma série aleatória.
   3. Consulta os vídeos dessa série.
   4. Procura trailer oficial / trailer / teaser.
   5. Se uma série não tiver trailer, tenta outra.
   6. Coloca o vídeo do YouTube no HERO.
   7. Autoplay + mute + loop.
   8. Mantém título, nota, sinopse e Assistir.
   9. Assistir leva para serie.html.

   NÃO altera:
   - catálogo infinito
   - pesquisa/autocomplete
   - cards
   - categorias
   - Minha Lista
   ========================================================= */

let serieHeroAtual = null;

const cacheTrailerHeroSeries = new Map();


function nomeHeroSerie(serie) {

    return (
        serie?.titulo ||
        serie?.name ||
        serie?.original_name ||
        "Série"
    );

}


function idHeroSerie(serie) {

    return String(
        serie?.tmdb_id ||
        serie?.id ||
        ""
    ).trim();

}


function anoHeroSerie(serie) {

    return (
        serie?.ano ||
        (
            serie?.first_air_date
                ? String(serie.first_air_date).substring(0, 4)
                : ""
        )
    );

}


function imagemHeroSerie(serie) {

    return (
        serie?.backdrop ||
        (
            serie?.backdrop_path
                ? "https://image.tmdb.org/t/p/original" +
                  serie.backdrop_path
                : ""
        ) ||
        serie?.capa ||
        (
            serie?.poster_path
                ? "https://image.tmdb.org/t/p/original" +
                  serie.poster_path
                : ""
        )
    );

}


/* =========================================================
   GARANTE O IFRAME DO HERO
   ========================================================= */

function obterIframeHeroSerie() {

    const hero =
        document.getElementById("heroSeries");

    if (!hero) {
        return null;
    }

    let iframe =
        hero.querySelector("iframe");

    if (!iframe) {

        iframe =
            document.createElement("iframe");

        iframe.id = "trailerSeries";

        iframe.setAttribute(
            "title",
            "Trailer da série"
        );

        iframe.setAttribute(
            "allow",
            "autoplay; encrypted-media; picture-in-picture"
        );

        iframe.setAttribute(
            "allowfullscreen",
            ""
        );

        hero.insertBefore(
            iframe,
            hero.firstChild
        );

    }

    /*
     * Garante que o iframe esteja atrás
     * do conteúdo do HERO.
     */

    iframe.style.position = "absolute";
    iframe.style.inset = "0";
    iframe.style.width = "100%";
    iframe.style.height = "100%";
    iframe.style.border = "0";
    iframe.style.zIndex = "0";
    iframe.style.pointerEvents = "none";
    iframe.style.objectFit = "cover";

    return iframe;

}


/* =========================================================
   BUSCA TRAILER DE UMA SÉRIE
   ========================================================= */

async function buscarTrailerHeroSerie(serie) {

    const id =
        idHeroSerie(serie);

    if (!id) {
        return null;
    }

    if (
        cacheTrailerHeroSeries.has(id)
    ) {
        return cacheTrailerHeroSeries.get(id);
    }

    try {

        const resposta =
            await fetch(
                "/api/serie/" +
                encodeURIComponent(id) +
                "/videos",
                {
                    cache: "no-store"
                }
            );

        if (!resposta.ok) {
            return null;
        }

        const dados =
            await resposta.json();

        const trailer =
            dados &&
            dados.sucesso
                ? dados.trailer
                : null;

        cacheTrailerHeroSeries.set(
            id,
            trailer || null
        );

        return trailer || null;

    } catch (erro) {

        console.warn(
            "[HERO SÉRIES] Falha trailer:",
            id,
            erro
        );

        return null;

    }

}


/* =========================================================
   COLOCA O TRAILER NO HERO
   ========================================================= */

function colocarTrailerHeroSerie(trailer) {

    if (!trailer || !trailer.key) {
        return false;
    }

    const iframe =
        obterIframeHeroSerie();

    if (!iframe) {
        return false;
    }

    const key =
        String(trailer.key).trim();

    if (!key) {
        return false;
    }

    /*
     * playlist=KEY é necessário para o
     * loop funcionar no YouTube.
     */

    iframe.src =
        "https://www.youtube.com/embed/" +
        encodeURIComponent(key) +
        "?autoplay=1" +
        "&mute=1" +
        "&controls=0" +
        "&loop=1" +
        "&playlist=" +
        encodeURIComponent(key) +
        "&rel=0" +
        "&modestbranding=1" +
        "&playsinline=1" +
        "&iv_load_policy=3";

    return true;

}


/* =========================================================
   TEXTO DO HERO
   ========================================================= */

function configurarTextoHeroSerie(serie) {

    serieHeroAtual =
        serie;

    const titulo =
        nomeHeroSerie(serie);

    const ano =
        anoHeroSerie(serie);

    const notaNumero =
        Number(
            serie?.nota ??
            serie?.vote_average ??
            0
        );

    const sinopse =
        serie?.sinopse ||
        serie?.overview ||
        serie?.descricao ||
        "Descubra esta série no LUKAFILMES.";


    const tituloEl =
        document.getElementById(
            "heroTituloSeries"
        );

    const anoEl =
        document.getElementById(
            "heroAnoSeries"
        );

    const notaEl =
        document.getElementById(
            "heroNotaSeries"
        );

    const sinopseEl =
        document.getElementById(
            "heroSinopseSeries"
        );


    if (tituloEl) {
        tituloEl.textContent =
            titulo;
    }


    if (anoEl) {
        anoEl.textContent =
            ano || "";
    }


    if (notaEl) {

        notaEl.textContent =
            notaNumero > 0
                ? "⭐ " +
                  notaNumero.toFixed(1)
                : "";

    }


    if (sinopseEl) {
        sinopseEl.textContent =
            sinopse;
    }

}


/* =========================================================
   BOTÃO ASSISTIR
   ========================================================= */

function configurarBotaoAssistirHeroSerie() {

    const botao =
        document.getElementById(
            "heroAssistirSeries"
        );

    if (!botao) {
        return;
    }

    botao.onclick =
        function() {

            if (!serieHeroAtual) {
                return;
            }

            localStorage.setItem(
                "serieSelecionada",
                JSON.stringify(
                    serieHeroAtual
                )
            );

            window.location.href =
                "serie.html";

        };

}


/* =========================================================
   MINHA LISTA
   ========================================================= */

function configurarMinhaListaHeroSerie() {

    const botao =
        document.getElementById(
            "heroListaSeries"
        );

    if (!botao) {
        return;
    }

    botao.onclick =
        function() {

            if (!serieHeroAtual) {
                return;
            }

            try {

                const lista =
                    JSON.parse(
                        localStorage.getItem(
                            "lukafilmes_minhalista"
                        ) || "[]"
                    );

                const id =
                    idHeroSerie(
                        serieHeroAtual
                    ) ||
                    nomeHeroSerie(
                        serieHeroAtual
                    );


                const existe =
                    lista.some(
                        function(item) {

                            return String(
                                item?.tmdb_id ||
                                item?.id ||
                                item?.titulo ||
                                item?.name ||
                                ""
                            ) === String(id);

                        }
                    );


                if (!existe) {

                    lista.push(
                        serieHeroAtual
                    );

                    localStorage.setItem(
                        "lukafilmes_minhalista",
                        JSON.stringify(lista)
                    );

                }


                botao.textContent =
                    existe
                        ? "✓ Na minha lista"
                        : "✓ Adicionada";

            } catch (erro) {

                console.warn(
                    "[HERO SÉRIES] Minha lista:",
                    erro
                );

            }

        };

}


/* =========================================================
   CARREGA SÉRIES E ENCONTRA UMA COM TRAILER
   ========================================================= */

async function carregarHeroSerieAutomatico() {

    try {

        console.log(
            "[HERO SÉRIES] Buscando muitos trailers no TMDB..."
        );

        /*
         * Várias páginas do catálogo.
         * Isso aumenta enormemente a quantidade
         * de séries disponíveis para o Hero.
         */

        const paginas = [];

        for (let pagina = 1; pagina <= 20; pagina++) {

            try {

                const resposta =
                    await fetch(
                        "/api/catalogo-series?pagina=" +
                        pagina,
                        {
                            cache: "no-store"
                        }
                    );

                if (!resposta.ok) {
                    continue;
                }

                const dados =
                    await resposta.json();

                const lista =
                    Array.isArray(dados?.series)
                        ? dados.series
                        : Array.isArray(dados?.resultados)
                            ? dados.resultados
                            : [];

                paginas.push(
                    ...lista
                );

            } catch (erro) {

                console.warn(
                    "[HERO SÉRIES] Falha página:",
                    pagina,
                    erro
                );

            }

        }


        /*
         * Remove duplicadas.
         */

        const unicas = [];

        const ids = new Set();

        for (const serie of paginas) {

            const id =
                idHeroSerie(serie);

            if (!id) {
                continue;
            }

            if (ids.has(id)) {
                continue;
            }

            ids.add(id);

            unicas.push(
                serie
            );

        }


        if (!unicas.length) {

            throw new Error(
                "Nenhuma série encontrada no TMDB."
            );

        }


        /*
         * Histórico de trailers utilizados.
         *
         * Isso impede que a mesma sequência
         * apareça novamente a cada atualização.
         */

        let usados = [];

        try {

            usados =
                JSON.parse(
                    localStorage.getItem(
                        "lukafilmes_hero_series_trailers_usados"
                    ) || "[]"
                );

            if (!Array.isArray(usados)) {
                usados = [];
            }

        } catch {

            usados = [];

        }


        const usadosSet =
            new Set(
                usados.map(
                    x => String(x)
                )
            );


        /*
         * Embaralha todas as séries.
         */

        for (
            let i = unicas.length - 1;
            i > 0;
            i--
        ) {

            const j =
                Math.floor(
                    Math.random() * (i + 1)
                );

            [
                unicas[i],
                unicas[j]
            ] =
            [
                unicas[j],
                unicas[i]
            ];

        }


        /*
         * Primeira rodada:
         * tenta somente séries cujo trailer
         * ainda não foi usado.
         */

        let candidatos =
            unicas.filter(
                serie => {

                    const id =
                        idHeroSerie(serie);

                    return !usadosSet.has(
                        id
                    );

                }
            );


        /*
         * Se já usamos todos os trailers
         * disponíveis, inicia novo ciclo.
         */

        if (!candidatos.length) {

            console.log(
                "[HERO SÉRIES] ♻️ Novo ciclo de trailers."
            );

            usados = [];

            usadosSet.clear();

            localStorage.removeItem(
                "lukafilmes_hero_series_trailers_usados"
            );

            candidatos =
                unicas.slice();

        }


        /*
         * Tenta muitas séries.
         *
         * Quanto maior esse número,
         * maior a chance de encontrar trailer.
         */

        const quantidadeTentativas =
            Math.min(
                candidatos.length,
                80
            );


        for (
            let i = 0;
            i < quantidadeTentativas;
            i++
        ) {

            const serie =
                candidatos[i];

            const id =
                idHeroSerie(serie);

            console.log(
                "[HERO SÉRIES] Trailer:",
                i + 1,
                "/",
                quantidadeTentativas,
                nomeHeroSerie(serie),
                "ID:",
                id
            );


            const trailer =
                await buscarTrailerHeroSerie(
                    serie
                );


            if (
                !trailer ||
                !trailer.key
            ) {

                continue;

            }


            /*
             * Identificador único do trailer.
             *
             * O ID principal é a chave do YouTube.
             */

            const trailerId =
                String(
                    trailer.key
                ).trim();


            if (!trailerId) {
                continue;
            }


            /*
             * Evita repetir exatamente
             * o mesmo vídeo.
             */

            if (
                usadosSet.has(
                    trailerId
                )
            ) {

                continue;

            }


            configurarTextoHeroSerie(
                serie
            );

            configurarBotaoAssistirHeroSerie();

            configurarMinhaListaHeroSerie();


            if (
                colocarTrailerHeroSerie(
                    trailer
                )
            ) {

                /*
                 * Salva o trailer como utilizado.
                 */

                usados.push(
                    trailerId
                );

                /*
                 * Limita o histórico para
                 * não crescer infinitamente.
                 */

                if (
                    usados.length > 1000
                ) {

                    usados =
                        usados.slice(
                            -1000
                        );

                }


                localStorage.setItem(
                    "lukafilmes_hero_series_trailers_usados",
                    JSON.stringify(
                        usados
                    )
                );


                console.log(
                    "[HERO SÉRIES] ✅ TRAILER NOVO:",
                    nomeHeroSerie(serie),
                    trailerId
                );

                return;

            }

        }


        /*
         * Se não conseguiu encontrar um trailer
         * novo nesta rodada, limpa o histórico
         * e tenta novamente.
         */

        console.warn(
            "[HERO SÉRIES] Nenhum trailer novo encontrado. Reiniciando ciclo."
        );


        localStorage.removeItem(
            "lukafilmes_hero_series_trailers_usados"
        );


        /*
         * Escolhe uma série qualquer como fallback.
         */

        const fallback =
            unicas[
                Math.floor(
                    Math.random() *
                    unicas.length
                )
            ];


        if (fallback) {

            serieHeroAtual =
                fallback;

            configurarTextoHeroSerie(
                fallback
            );

            configurarBotaoAssistirHeroSerie();

            configurarMinhaListaHeroSerie();

        }


    } catch (erro) {

        console.error(
            "[HERO SÉRIES] ERRO:",
            erro
        );

    }

}

/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

function iniciarHeroTrailerSeries() {

    obterIframeHeroSerie();

    configurarBotaoAssistirHeroSerie();

    configurarMinhaListaHeroSerie();

    carregarHeroSerieAutomatico();

}


/*
 * Não dependemos mais do evento
 * series-primeiro-lote.
 *
 * Isso elimina o problema de o catálogo
 * carregar antes deste script.
 */

if (
    document.readyState === "loading"
) {

    document.addEventListener(
        "DOMContentLoaded",
        iniciarHeroTrailerSeries,
        {
            once: true
        }
    );

} else {

    iniciarHeroTrailerSeries();

}


/*
 * Mantém compatibilidade caso o catálogo
 * também envie o evento.
 *
 * Não recarrega o trailer se já houver
 * uma série configurada.
 */

window.addEventListener(
    "series-primeiro-lote",
    function(event) {

        if (serieHeroAtual) {
            return;
        }

        const lista =
            event.detail || [];

        if (
            Array.isArray(lista) &&
            lista.length
        ) {

            carregarHeroSerieAutomatico();

        }

    }
);

</script>

