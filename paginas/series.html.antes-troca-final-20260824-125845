<script id="pesquisa-series-autocomplete-final">
(function () {

    const input = document.getElementById("pesquisaSeries");
    const resultados = document.getElementById("listaResultados");
    const blocoResultados = document.getElementById("resultadoPesquisa");

    if (!input || !resultados || !blocoResultados) {
        console.error("[PESQUISA SÉRIES] Elementos não encontrados");
        return;
    }

    let timer = null;
    let controlador = null;

    function escapar(texto) {
        const div = document.createElement("div");
        div.textContent = texto || "";
        return div.innerHTML;
    }

    function obterTitulo(serie) {
        return (
            serie.titulo ||
            serie.name ||
            serie.original_name ||
            "Série"
        );
    }

    function obterImagem(serie) {
        if (serie.capa) {
            return serie.capa;
        }

        if (serie.poster_path) {
            return "https://image.tmdb.org/t/p/w300" +
                   serie.poster_path;
        }

        return "";
    }

    function abrirSerie(serie) {

        try {
            localStorage.setItem(
                "serieSelecionada",
                JSON.stringify(serie)
            );
        } catch (e) {
            console.error("[PESQUISA SÉRIES] Erro localStorage:", e);
        }

        window.location.href = "serie.html";
    }

    function limparResultados() {
        resultados.innerHTML = "";
        blocoResultados.style.display = "none";
    }

    function mostrarResultados(lista) {

        resultados.innerHTML = "";

        if (!Array.isArray(lista) || lista.length === 0) {
            blocoResultados.style.display = "none";
            return;
        }

        blocoResultados.style.display = "block";

        lista.slice(0, 8).forEach(function (serie) {

            const titulo = obterTitulo(serie);

            const ano =
                serie.ano ||
                (
                    serie.first_air_date
                        ? String(serie.first_air_date).substring(0, 4)
                        : ""
                );

            const nota =
                Number(
                    serie.nota ??
                    serie.vote_average ??
                    0
                ).toFixed(1);

            const imagem = obterImagem(serie);

            const item = document.createElement("button");

            item.type = "button";
            item.className = "sugestao-serie";

            item.innerHTML =
                (imagem
                    ? '<img src="' +
                      escapar(imagem) +
                      '" alt="" loading="lazy">'
                    : '<div class="sugestao-serie-sem-imagem"></div>') +

                '<span class="sugestao-serie-info">' +
                    '<strong>' +
                        escapar(titulo) +
                    '</strong>' +

                    '<small>' +
                        (ano ? escapar(String(ano)) : "") +
                        (ano && nota !== "0.0" ? " • " : "") +
                        (nota !== "0.0"
                            ? "⭐ " + escapar(nota)
                            : "") +
                    '</small>' +
                '</span>';

            item.addEventListener("click", function () {
                abrirSerie(serie);
            });

            resultados.appendChild(item);

        });
    }

    async function pesquisar(texto) {

        const termo = texto.trim();

        if (termo.length < 2) {
            limparResultados();
            return;
        }

        if (controlador) {
            controlador.abort();
        }

        controlador = new AbortController();

        try {

            const resposta = await fetch(
                "/api/pesquisar-series?q=" +
                encodeURIComponent(termo),
                {
                    signal: controlador.signal
                }
            );

            if (!resposta.ok) {
                throw new Error(
                    "HTTP " + resposta.status
                );
            }

            const dados = await resposta.json();

            const lista =
                Array.isArray(dados.series)
                    ? dados.series
                    : Array.isArray(dados.resultados)
                        ? dados.resultados
                        : [];

            mostrarResultados(lista);

        } catch (erro) {

            if (erro.name === "AbortError") {
                return;
            }

            console.error(
                "[PESQUISA SÉRIES]",
                erro
            );

            limparResultados();
        }
    }

    input.addEventListener("input", function () {

        clearTimeout(timer);

        const texto = input.value;

        if (texto.trim().length < 2) {
            limparResultados();
            return;
        }

        timer = setTimeout(function () {
            pesquisar(texto);
        }, 250);

    });

    input.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {
            input.value = "";
            limparResultados();
            input.blur();
        }

    });

    document.addEventListener("click", function (event) {

        if (
            !input.contains(event.target) &&
            !resultados.contains(event.target)
        ) {
            limparResultados();
        }

    });

    console.log(
        "[PESQUISA SÉRIES] AUTOCOMPLETE ATIVO"
    );

})();
</script>




