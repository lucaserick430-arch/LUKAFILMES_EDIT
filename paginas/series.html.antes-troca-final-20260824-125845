<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #050505;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
}

.topo-series {
    width: 100%;
    min-height: 100vh;
    padding: 30px 20px 80px;
}

.voltar {
    display: inline-flex;
    align-items: center;
    padding: 11px 18px;
    color: #fff;
    text-decoration: none;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 30px;
    transition: .25s;
}

.voltar:hover {
    background: #e50914;
    transform: translateX(-3px);
}

.titulo-series {
    margin: 35px 0 8px;
    text-align: center;
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 900;
}

.subtitulo-series {
    margin: 0 auto 35px;
    text-align: center;
    color: #aaa;
    font-size: 16px;
}

/* ==========================================
   PESQUISA
   ========================================== */

.pesquisa-series {
    width: 100%;
    max-width: 650px;
    margin: 0 auto 50px;
}

.campo-pesquisa {
    position: relative;
    width: 100%;
}

.campo-pesquisa input {
    width: 100%;
    height: 58px;
    padding: 0 60px 0 22px;

    color: #fff;
    background: rgba(255,255,255,.08);

    border: 1px solid rgba(255,255,255,.15);
    border-radius: 30px;

    outline: none;

    font-size: 16px;

    backdrop-filter: blur(15px);

    transition: .25s;
}

.campo-pesquisa input:focus {
    border-color: #e50914;
    box-shadow: 0 0 25px rgba(229,9,20,.18);
}

.campo-pesquisa button {
    position: absolute;

    right: 7px;
    top: 7px;

    width: 44px;
    height: 44px;

    border: 0;
    border-radius: 50%;

    color: #fff;
    background: #e50914;

    font-size: 20px;

    cursor: pointer;

    transition: .25s;
}

.campo-pesquisa button:hover {
    transform: scale(1.08);
}

.resultado-pesquisa {
    display: none;

    margin-top: 35px;
}

.resultado-pesquisa h2 {
    margin-bottom: 25px;
    font-size: 25px;
}

/* ==========================================
   CATEGORIAS
   ========================================== */

.categoria {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto 55px;
}

.categoria h2 {
    margin: 0 0 22px;
    font-size: 25px;
}

/* ==========================================
   LISTA
   ========================================== */

.lista-series {
    display: grid;

    grid-template-columns:
        repeat(auto-fill, minmax(170px, 1fr));

    gap: 22px;
}

/* ==========================================
   CARD
   ========================================== */

.card-serie {
    overflow: hidden;

    background: #101010;

    border-radius: 13px;

    border: 1px solid rgba(255,255,255,.08);

    cursor: pointer;

    transition:
        transform .3s ease,
        box-shadow .3s ease;

    animation: aparecer .45s ease;
}

.card-serie:hover {
    transform: translateY(-8px) scale(1.02);

    box-shadow:
        0 20px 45px rgba(0,0,0,.7),
        0 0 25px rgba(229,9,20,.12);
}

.card-serie img {
    width: 100%;
    aspect-ratio: 2 / 3;

    display: block;

    object-fit: cover;

    background: #181818;
}

.card-serie-info {
    padding: 12px;
}

.card-serie-info h3 {
    margin: 0 0 7px;

    font-size: 15px;
    line-height: 1.3;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-serie-info p {
    margin: 0;

    color: #f5c518;

    font-size: 13px;
}

/* ==========================================
   CARREGANDO
   ========================================== */

.carregando {
    grid-column: 1 / -1;

    padding: 40px;

    text-align: center;

    color: #999;
}

.sem-resultados {
    padding: 45px 20px;

    text-align: center;

    color: #aaa;

    font-size: 16px;
}

@keyframes aparecer {

    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

/* ==========================================
   CELULAR
   ========================================== */

@media (max-width: 700px) {

    .topo-series {
        padding: 20px 12px 60px;
    }

    .titulo-series {
        margin-top: 28px;
    }

    .lista-series {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 14px;
    }

    .categoria h2 {
        font-size: 21px;
    }

}


/* ==========================================================
   PESQUISA MOBILE — COMPACTA
   ========================================================== */
@media (max-width: 700px) {

    .pesquisa-series {
        width: 100% !important;
        max-width: 320px !important;
        margin: 0 auto 30px !important;
    }

    .campo-pesquisa {
        width: 100% !important;
        max-width: 320px !important;
        margin: 0 auto !important;
        position: relative !important;
    }

    .campo-pesquisa input {
        width: 100% !important;
        max-width: 320px !important;
        height: 46px !important;
        box-sizing: border-box !important;

        padding: 0 55px 0 17px !important;

        border-radius: 25px !important;
        font-size: 14px !important;
    }

    .campo-pesquisa button {
        width: 38px !important;
        height: 38px !important;

        right: 4px !important;
        top: 4px !important;

        border-radius: 50% !important;
        font-size: 17px !important;
    }
}

</style>


