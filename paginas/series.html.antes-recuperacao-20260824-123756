                "transparent 60%" +
                ")," +
                "url('" +
                imagem.replace(/'/g, "\\'") +
                "')";

            hero.style.backgroundSize =
                "cover";

            hero.style.backgroundPosition =
                "center center";

            hero.style.backgroundRepeat =
                "no-repeat";

            hero.style.backgroundColor =
