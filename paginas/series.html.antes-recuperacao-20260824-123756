<script id="hero-series-dinamico">

(function () {

    "use strict";

    async function carregarHeroSerieAutomatico() {

    try {

        console.log("[HERO SÉRIES] Iniciando carregamento da capa...");

        const pagina =
            Math.floor(Math.random() * 50) + 1;

        const resposta =
            await fetch(
                "/api/catalogo-series?pagina=" + pagina,
                {
                    cache: "no-store"
                }
            );

        if (!resposta.ok) {
            throw new Error(
                "HTTP " + resposta.status
            );
        }

        const dados =
            await resposta.json();

        const series =
            Array.isArray(dados.series)
                ? dados.series
                : [];

        if (!series.length) {
            throw new Error(
                "Nenhuma série retornada."
            );
        }

        const serie =
            series[
                Math.floor(
                    Math.random() * series.length
                )
            ];

        const hero =
            document.getElementById("heroSeries");

        const titulo =
            document.getElementById("heroTituloSeries");

        const ano =
            document.getElementById("heroAnoSeries");

        const nota =
            document.getElementById("heroNotaSeries");

        const sinopse =
            document.getElementById("heroSinopseSeries");

        if (!hero) {
            throw new Error(
                "#heroSeries não encontrado."
            );
        }

        /*
         * REMOVE QUALQUER TRAILER
         */
        const iframe =
            document.getElementById("trailerSeries");

        if (iframe) {
            iframe.remove();
        }

        /*
         * IMAGEM PRINCIPAL
         *
         * Prioridade:
         * 1. fundo
         * 2. capa
         */
        const imagem =
            serie.fundo ||
            serie.capa ||
            "";

        if (imagem) {

            hero.style.backgroundImage =
                "linear-gradient(" +
                "90deg," +
                "rgba(0,0,0,.95) 0%," +
                "rgba(0,0,0,.72) 35%," +
                "rgba(0,0,0,.35) 70%," +
