    <script>

        /*
         * Verifica quem está logado.
         *
         * Se for usuário comum:
         *     botão Admin permanece escondido.
         *
         * Se for admin:
         *     botão Admin aparece.
         */

        async function verificarUsuario() {

            try {

                const resposta = await fetch("/api/eu");

                if (!resposta.ok) {

                    window.location.href = "/login";

                    return;
                }

                const dados = await resposta.json();

                if (
                    dados.logado &&
                    dados.usuario &&
                    dados.usuario.tipo === "admin"
                ) {

                    const botaoAdmin =
                        document.getElementById("botaoAdmin");

                    if (botaoAdmin) {

                        botaoAdmin.style.display =
                            "inline-block";

                    }

                }

            } catch (erro) {

                console.error(
                    "[ERRO USUARIO]",
                    erro
                );

            }

        }


        /*
         * Abre o painel administrativo.
         */

        function abrirPainelAdmin() {

            window.location.href =
                "/admin.html";

        }


        /*
         * Sai da conta.
         */

        async function logout() {

            try {

                await fetch(
                    "/logout",
                    {
                        method: "POST"
                    }
                );

            } catch (erro) {

                console.error(
                    "[ERRO LOGOUT]",
                    erro
                );

            }

            window.location.href =
                "/login";

        }


        /*
         * Executa a verificação
         * assim que o site carregar.
         */

        verificarUsuario();

    </script>


