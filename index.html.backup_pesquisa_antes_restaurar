<script>
(function(){

    function colocarPesquisaAbaixoDoMenu(){

        if(window.innerWidth > 700) return;

        const pesquisa =
            document.querySelector(".hero .pesquisa");

        if(!pesquisa) return;

        const elementos =
            Array.from(document.querySelectorAll("a,button"));

        const alvo = elementos.find(function(el){

            const texto =
                (el.textContent || "")
                .replace(/\s+/g," ")
                .trim()
                .toLowerCase();

            return texto === "admin" ||
                   texto === "painel";
        });

        if(!alvo) return;

        const grupo = alvo.parentElement;

        if(!grupo) return;

        grupo.classList.add("acoes-pesquisa-mobile");

        if(pesquisa.parentElement !== grupo){
            grupo.appendChild(pesquisa);
        }

        const input =
            pesquisa.querySelector("#campoBusca");

        if(input){
            input.placeholder = "Pesquisa";
        }
    }

    function iniciar(){

        colocarPesquisaAbaixoDoMenu();

        setTimeout(colocarPesquisaAbaixoDoMenu,300);
        setTimeout(colocarPesquisaAbaixoDoMenu,800);
        setTimeout(colocarPesquisaAbaixoDoMenu,1500);
        setTimeout(colocarPesquisaAbaixoDoMenu,2500);
    }

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            iniciar
        );
    }else{
        iniciar();
    }

    const observador =
        new MutationObserver(function(){
            colocarPesquisaAbaixoDoMenu();
        });

    observador.observe(document.body,{
        childList:true,
        subtree:true
    });

})();
</script>

