        const agora = Date.now();

        if (
            catalogoCache &&
            (agora - catalogoUltimaAtualizacao) < CATALOGO_CACHE_MS
        ) {
            return res.json({
                sucesso: true,
                total: catalogoCache.length,
                filmes: catalogoCache,
                cache: true
            });
