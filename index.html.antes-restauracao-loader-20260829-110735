<script id="lukafilmes-loader-js">
(function(){

    var loaderTimer;

    function mostrarLukaLoader(){
        var overlay=document.getElementById("lukaLoaderOverlay");
        if(!overlay)return;

        clearTimeout(loaderTimer);

        overlay.classList.add("ativo");
        overlay.setAttribute("aria-hidden","false");
        overlay.style.pointerEvents="auto";
    }

    function esconderLukaLoader(){
        var overlay=document.getElementById("lukaLoaderOverlay");
        if(!overlay)return;

        clearTimeout(loaderTimer);

        overlay.classList.remove("ativo");
        overlay.setAttribute("aria-hidden","true");
        overlay.style.pointerEvents="none";
    }

    window.mostrarLukaLoader=mostrarLukaLoader;

    window.LukaLoader={
        show:mostrarLukaLoader,
        hide:esconderLukaLoader
    };

    /*
     * LOADER PREMIUM
     * Mostra durante o carregamento inicial.
     */
    mostrarLukaLoader();

    /*
     * Segurança:
     * mesmo que algum recurso da página demore ou
     * o evento load não seja disparado, o Loader
     * nunca ficará preso na tela.
     */
    loaderTimer=setTimeout(function(){
        esconderLukaLoader();
    },2500);

    window.addEventListener("load",function(){
        setTimeout(function(){
            esconderLukaLoader();
        },500);
    });

    /*
     * Fluxo "Assistir agora".
     */
    document.addEventListener("DOMContentLoaded",function(){

        var botoes=document.querySelectorAll("button,a");

        botoes.forEach(function(botao){

            var texto=(botao.textContent||"").trim().toLowerCase();

            if(texto.includes("assistir agora")){

                botao.addEventListener("click",function(){

                    mostrarLukaLoader();

                    /*
                     * Não impedir a navegação original
                     * do botão/link.
                     */
                    setTimeout(function(){
                        esconderLukaLoader();
                    },2000);

                },true);
            }
        });

    });

})();
</script>

