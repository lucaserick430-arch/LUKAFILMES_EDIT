<script id="lukafilmes-boasvindas-unificado-script">
(function(){

    try{

        const CHAVE = "lukafilmes_boasvindas_sessao";

        if(sessionStorage.getItem(CHAVE)){
            return;
        }

        const mostrar = function(){

            const caixa =
                document.getElementById(
                    "lukafilmes-boasvindas-unificado"
                );

            if(!caixa){
                return;
            }

            sessionStorage.setItem(CHAVE,"1");

            caixa.classList.add("ativo");
            caixa.setAttribute("aria-hidden","false");

            setTimeout(function(){

                caixa.classList.remove("ativo");
                caixa.setAttribute("aria-hidden","true");

            },5500);

        };

        if(document.readyState === "loading"){
            document.addEventListener(
                "DOMContentLoaded",
                mostrar,
                {once:true}
            );
        }else{
            mostrar();
        }

    }catch(e){

        console.warn(
            "LUKAFILMES — boas-vindas:",
            e
        );

    }

})();
</script>


