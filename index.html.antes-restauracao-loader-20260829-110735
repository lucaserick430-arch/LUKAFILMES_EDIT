<script id="lukafilmes-tv-navigation-final">
(function(){

    /*
     * TV real:
     * 1920x1080 / 3840x2160 normalmente entra aqui.
     *
     * Notebook comum fica fora.
     */

    function ehTV(){

        return (
            window.innerWidth >= 1600 &&
            window.innerHeight >= 800
        );

    }

    if(!ehTV()) return;

    document.body.classList.add("lukafilmes-tv-mode");

    const SELECTOR =
        ".section .row .card," +
        ".section .row .filme," +
        ".section .row .serie," +
        ".section .row > a";

    function itensDaLinha(row){

        return Array.from(
            row.querySelectorAll(SELECTOR)
        ).filter(function(el){

            return el.offsetParent !== null;

        });

    }

    function linhas(){

        return Array.from(
            document.querySelectorAll(".section .row")
        ).filter(function(row){

            return itensDaLinha(row).length > 0;

        });

    }

    function preparar(){

        document.querySelectorAll(SELECTOR)
            .forEach(function(item){

                if(!item.hasAttribute("tabindex")){
                    item.setAttribute("tabindex","0");
                }

            });

    }

    function limparFoco(){

        document
            .querySelectorAll(".lukafilmes-tv-focus")
            .forEach(function(item){

                item.classList.remove(
                    "lukafilmes-tv-focus"
                );

            });

    }

    function focar(item){

        if(!item) return;

        limparFoco();

        item.classList.add(
            "lukafilmes-tv-focus"
        );

        item.focus({
            preventScroll:true
        });

        item.scrollIntoView({
            behavior:"smooth",
            block:"nearest",
            inline:"center"
        });

    }

    function abrir(item){

        if(!item) return;

        const link =
            item.matches("a")
                ? item
                : item.querySelector("a");

        if(link){
            link.click();
            return;
        }

        item.click();

    }

    function centroHorizontal(el){

        const r = el.getBoundingClientRect();

        return r.left + (r.width / 2);

    }

    function encontrarVertical(atual, direcao){

        const rowAtual =
            atual.closest(".row");

        if(!rowAtual) return null;

        const todas = linhas();

        const indice =
            todas.indexOf(rowAtual);

        if(indice < 0) return null;

        const alvoIndice =
            indice + direcao;

        if(
            alvoIndice < 0 ||
            alvoIndice >= todas.length
        ){
            return null;
        }

        const alvo =
            todas[alvoIndice];

        const candidatos =
            itensDaLinha(alvo);

        if(!candidatos.length) return null;

        const xAtual =
            centroHorizontal(atual);

        let melhor = candidatos[0];
        let distancia = Infinity;

        candidatos.forEach(function(item){

            const distanciaAtual =
                Math.abs(
                    centroHorizontal(item) -
                    xAtual
                );

            if(distanciaAtual < distancia){

                distancia =
                    distanciaAtual;

                melhor = item;

            }

        });

        return melhor;

    }

    function iniciar(){

        preparar();

        const primeiraLinha =
            linhas()[0];

        if(!primeiraLinha) return;

        const primeiro =
            itensDaLinha(primeiraLinha)[0];

        if(primeiro){

            setTimeout(function(){

                focar(primeiro);

            },600);

        }

    }

    document.addEventListener(
        "keydown",
        function(event){

            if(!document.body.classList.contains(
                "lukafilmes-tv-mode"
            )){
                return;
            }

            const tag =
                document.activeElement &&
                document.activeElement.tagName;

            if(
                tag === "INPUT" ||
                tag === "TEXTAREA" ||
                tag === "SELECT"
            ){
                return;
            }

            const atual =
                document.activeElement &&
                document.activeElement.matches(SELECTOR)
                    ? document.activeElement
                    : document.querySelector(
                        ".lukafilmes-tv-focus"
                    );

            if(!atual) return;

            let proximo = null;

            if(event.key === "ArrowRight"){

                const lista =
                    itensDaLinha(
                        atual.closest(".row")
                    );

                const indice =
                    lista.indexOf(atual);

                if(indice >= 0){
                    proximo =
                        lista[indice + 1] ||
                        lista[indice];
                }

            }

            else if(event.key === "ArrowLeft"){

                const lista =
                    itensDaLinha(
                        atual.closest(".row")
                    );

                const indice =
                    lista.indexOf(atual);

                if(indice > 0){
                    proximo =
                        lista[indice - 1];
                }

            }

            else if(event.key === "ArrowDown"){

                proximo =
                    encontrarVertical(
                        atual,
                        1
                    );

            }

            else if(event.key === "ArrowUp"){

                proximo =
                    encontrarVertical(
                        atual,
                        -1
                    );

            }

            else if(
                event.key === "Enter" ||
                event.key === " "
            ){

                event.preventDefault();

                abrir(atual);

                return;

            }

            else if(event.key === "Escape"){

                limparFoco();

                if(
                    document.activeElement &&
                    typeof document.activeElement.blur ===
                    "function"
                ){
                    document.activeElement.blur();
                }

                return;

            }

            if(proximo && proximo !== atual){

                event.preventDefault();

                focar(proximo);

            }

        },
        true
    );

    /*
     * Cards criados dinamicamente pelo catálogo também
     * recebem navegação.
     */

    const observer =
        new MutationObserver(function(){

            preparar();

        });

    observer.observe(
        document.body,
        {
            childList:true,
            subtree:true
        }
    );

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            iniciar
        );

    }else{

        iniciar();

    }

})();
</script>


