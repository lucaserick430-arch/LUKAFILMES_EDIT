<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050505">
<title>LUKAFILMES — Filmes e Séries</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

html,body{
    background:#050505;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    overflow-x:hidden;
}

body{
    min-height:100vh;
}

/* ================= HEADER ================= */

.header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:72px;
    z-index:1000;
    display:flex;
    align-items:center;
    padding:0 4%;
    transition:.35s;
    background:linear-gradient(
        to bottom,
        rgba(0,0,0,.95),
        rgba(0,0,0,.55),
        transparent
    );
}

.header.scrolled{
    background:rgba(5,5,5,.96);
    box-shadow:0 5px 25px rgba(0,0,0,.45);
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:-1px;
    color:#e50914;
    margin-right:35px;
    white-space:nowrap;
}

.logo span{
    color:#fff;
}

.nav{
    display:flex;
    gap:22px;
    align-items:center;
}

.nav a{
    color:#ddd;
    text-decoration:none;
    font-size:14px;
    font-weight:600;
    transition:.2s;
}

.nav a:hover,
.nav a.active{
    color:#fff;
}

.header-right{
    margin-left:auto;
    display:flex;
    align-items:center;
    gap:18px;
}

.search-btn,
.profile-btn,
.menu-btn{
    border:0;
    background:none;
    color:#fff;
    cursor:pointer;
    font-size:20px;
}

.profile{
    width:32px;
    height:32px;
    border-radius:5px;
    background:linear-gradient(135deg,#e50914,#7b0000);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    font-weight:bold;
}



/* ================= HERO ================= */

.hero{
    height:92vh;
    min-height:570px;
    position:relative;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        radial-gradient(circle at 75% 35%,rgba(229,9,20,.25),transparent 28%),
        linear-gradient(90deg,#050505 0%,rgba(5,5,5,.9) 25%,rgba(5,5,5,.2) 65%,#050505 100%);
}

.hero-bg{
    position:absolute;
    inset:0;
    background-size:cover;
    background-position:center;
    opacity:.62;
    transform:scale(1.03);
}

.hero-overlay{
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,#050505 0%,rgba(5,5,5,.8) 25%,rgba(5,5,5,.2) 65%,#050505 100%),
        linear-gradient(0deg,#050505 0%,transparent 35%,rgba(0,0,0,.15) 100%);
}

.hero-content{
    position:relative;
    z-index:2;
    width:min(650px,90%);
    margin-left:6%;
    padding-top:80px;
}

.hero-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:#ddd;
    font-size:13px;
    font-weight:bold;
    margin-bottom:15px;
}

.hero-badge strong{
    color:#e50914;
}

.hero-title{
    font-size:clamp(42px,6vw,78px);
    line-height:.95;
    font-weight:900;
    letter-spacing:-3px;
    margin-bottom:20px;
    text-shadow:0 5px 25px #000;
}

.hero-description{
    color:#ddd;
    max-width:560px;
    font-size:17px;
    line-height:1.55;
    margin-bottom:25px;
}

.hero-info{
    display:flex;
    gap:14px;
    align-items:center;
    margin-bottom:22px;
    color:#ddd;
    font-size:14px;
}

.hero-info .age{
    border:1px solid #777;
    padding:2px 6px;
}

.hero-buttons{
    display:flex;
    gap:12px;
}

.btn{
    border:0;
    border-radius:5px;
    padding:13px 24px;
    font-size:15px;
    font-weight:800;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:9px;
    transition:.2s;
}

.btn:hover{
    transform:scale(1.04);
}

.btn-watch{
    background:#fff;
    color:#000;
}

.btn-info{
    background:rgba(90,90,90,.75);
    color:#fff;
}

/* ================= CONTENT ================= */

.content{
    position:relative;
    z-index:5;
    margin-top:-70px;
    padding-bottom:60px;
}

.section{
    margin-bottom:32px;
}

.section-title{
    padding:0 4%;
    margin-bottom:13px;
    font-size:21px;
    font-weight:800;
}

.row{
    display:flex;
    touch-action:pan-y;
    user-select:none;
    -webkit-user-select:none;
    gap:9px;
    overflow-x:auto;
    padding:5px 4% 16px;
    scroll-behavior:auto;
    scrollbar-width:none;
}

.row::-webkit-scrollbar{
    display:none;
}

/* ================= CARDS ================= */

.card{
    flex:0 0 170px;
    height:255px;
    border-radius:5px;
    overflow:hidden;
    position:relative;
    cursor:pointer;
    background:#171717;
    transition:.3s;
    box-shadow:0 5px 15px rgba(0,0,0,.35);
}

.card:hover{
    transform:scale(1.07);
    z-index:20;
    box-shadow:0 15px 35px rgba(0,0,0,.7);
}

.card img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.card::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        to top,
        rgba(0,0,0,.9),
        transparent 55%
    );
    opacity:.8;
}

.card-info{
    position:absolute;
    bottom:0;
    left:0;
    right:0;
    z-index:2;
    padding:12px 10px;
}

.card-title{
    font-size:13px;
    font-weight:800;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.card-meta{
    color:#aaa;
    font-size:11px;
    margin-top:4px;
}

.play-small{
    position:absolute;
    top:10px;
    left:10px;
    width:34px;
    height:34px;
    border-radius:50%;
    background:#e50914;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:4;
    font-size:13px;
}

/* ================= TOP 10 ================= */

.top-card{
    flex-basis:190px;
    height:270px;
}

.top-number{
    position:absolute;
    left:-2px;
    bottom:-4px;
    z-index:3;
    font-size:90px;
    line-height:.8;
    font-weight:900;
    color:#050505;
    -webkit-text-stroke:2px #777;
    text-shadow:4px 4px 10px #000;
}

/* ================= LOADING ================= */

.loading{
    color:#999;
    padding:20px 4%;
    font-size:14px;
}

.error{
    color:#aaa;
    padding:20px 4%;
}

/* ================= FOOTER ================= */

footer{
    border-top:1px solid #222;
    padding:40px 5%;
    color:#777;
    font-size:12px;
    text-align:center;
    margin-top:40px;
}

footer strong{
    color:#e50914;
}

/* ================= MOBILE ================= */

.menu-btn{
    display:none;
}

@media(max-width:800px){

    .header{
        height:60px;
        padding:0 18px;
    }

    .logo{
        font-size:20px;
        margin-right:0;
    }

    .nav{
        display:none;
    }

    .menu-btn{
        display:block;
    }

    .header-right{
        gap:12px;
    }

    .hero{
        height:75vh;
        min-height:500px;
        align-items:flex-end;
    }

    .hero-content{
        margin-left:18px;
        margin-bottom:70px;
        padding-top:0;
        width:calc(100% - 36px);
    }

    .hero-title{
        font-size:43px;
        letter-spacing:-2px;
    }

    .hero-description{
        font-size:14px;
        line-height:1.45;
        max-height:84px;
        overflow:hidden;
    }

    .hero-info{
        font-size:12px;
    }

    .btn{
        padding:11px 17px;
        font-size:13px;
    }

    .content{
        margin-top:-45px;
    }

    .section{
        margin-bottom:24px;
    }

    .section-title{
        font-size:18px;
        padding:0 18px;
    }

    .row{
        padding-left:18px;
        padding-right:18px;
        gap:7px;
    }

    .card{
        flex-basis:125px;
        height:187px;
    }

    .top-card{
        flex-basis:145px;
        height:205px;
    }

    .top-number{
        font-size:65px;
    }

    .card-title{
        font-size:11px;
    }

    .card-meta{
        font-size:9px;
    }

    .profile{
        width:28px;
        height:28px;
    }
}

/* ================= SEARCH ================= */

.search-box{
    position:fixed !important;
    top:72px !important;
    left:50% !important;
    right:auto !important;
    transform:translateX(-50%) !important;
    width:min(620px,calc(100% - 40px)) !important;
    box-sizing:border-box;
    background:#0b0b0b;
    border:1px solid rgba(255,255,255,.16);
    border-radius:10px;
    padding:10px;
    z-index:1200;
    display:none;
    box-shadow:0 18px 50px rgba(0,0,0,.75);
}

.search-box.show{
    display:block;
}

.search-box input{
    display:block;
    width:100%;
    height:46px;
    box-sizing:border-box;
    border:0;
    outline:0;
    border-radius:7px;
    background:#181818;
    color:#fff;
    padding:0 15px;
    font-size:16px;
    -webkit-appearance:none;
    appearance:none;
}

.search-box input::placeholder{
    color:#999;
}

/* Pesquisa no celular — estilo Netflix */
@media (max-width:600px){

    .search-box{
        top:58px !important;
        left:0 !important;
        right:0 !important;
        transform:none !important;
        width:100% !important;
        padding:8px 10px 10px !important;
        border:0 !important;
        border-radius:0 !important;
        background:#050505 !important;
        box-shadow:0 12px 30px rgba(0,0,0,.75);
    }

    .search-box input{
        height:44px;
        border-radius:5px;
        background:#222;
        font-size:16px;
        padding:0 14px;
    }
}

.mobile-menu{
    position:fixed;
    top:60px;
    left:0;
    right:0;
    background:rgba(8,8,8,.98);
    z-index:1100;
    padding:20px;
    display:none;
    border-bottom:1px solid #222;
}

.mobile-menu.show{
    display:block;
}

.mobile-menu a{
    display:block;
    color:#fff;
    text-decoration:none;
    padding:13px 5px;
    border-bottom:1px solid #222;
}

/* =========================================================
   TRAILER AUTOMATICO NO HERO
   ========================================================= */

#heroTrailer{
    position:absolute;
    top:50%;
    left:50%;
    width:100vw;
    height:56.25vw;
    min-height:100%;
    min-width:177.78vh;
    transform:translate(-50%,-50%);
    border:0;
    opacity:0;
    pointer-events:none;
    z-index:1;
    transition:opacity .8s ease;
}

#heroTrailer.ativo{
    opacity:1;
}

.hero-bg{
    z-index:0;
    transition:opacity .8s ease;
}

.hero-overlay{
    z-index:2;
}

.hero-content{
    z-index:3;
}


#heroBg{
position:absolute;
inset:0;
overflow:hidden;
z-index:0;
background:none !important;
}
#heroBg iframe{
position:absolute;
top:50%;
left:50%;
width:177.78vh;
height:56.25vw;
min-width:100%;
min-height:100%;
transform:translate(-50%,-50%);
border:0;
pointer-events:none;
z-index:1;
}
.heroConteudo,.hero-content{
position:relative;
z-index:2;
}

</style>

<style id="pc-hero-trailer-fix">
@media (min-width: 769px){
    .hero{
        overflow:hidden;
    }

    #heroTrailer{
        width:120vw;
        height:120vh;
        min-width:120vw;
        min-height:120vh;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
    }
}
</style>

<style id="pc-capas-hd">
@media (min-width:769px){
    .card img{
        image-rendering:auto;
        backface-visibility:hidden;
        -webkit-backface-visibility:hidden;
        transform:translateZ(0);
        -webkit-transform:translateZ(0);
    }
}
</style>

<style id="hero-titulo-responsivo">
/* =========================================================
   LUKAFILMES — HERO
   CORREÇÃO PARA TÍTULOS GRANDES
   ========================================================= */

#heroTitle{
    max-width: min(850px, 75vw);

    font-size: clamp(
        2rem,
        5vw,
        4.8rem
    );

    line-height: 0.98;

    margin-top: 8px;
    margin-bottom: 14px;

    overflow: hidden;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    line-clamp: 2;

    word-break: normal;
    overflow-wrap: break-word;

    text-wrap: balance;
}

/*
 * Mantém a área do Hero organizada mesmo
 * quando o título possui duas linhas.
 */

.hero-content{
    max-width: 900px;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

/*
 * Evita que descrição e título empurrem
 * os botões para cima do selo "Em destaque".
 */

#heroDescription{
    max-width: 700px;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;

    line-clamp: 3;

    overflow: hidden;

    margin-bottom: 18px;
}

/*
 * Área dos botões permanece abaixo do texto.
 */

.hero-buttons,
.hero-actions{
    position: relative;
    z-index: 5;

    flex-shrink: 0;

    margin-top: 8px;
}

/*
 * Telas menores.
 */

@media (max-width: 768px){

    #heroTitle{
        max-width: 92vw;

        font-size: clamp(
            1.8rem,
            9vw,
            3rem
        );

        line-height: 1;

        -webkit-line-clamp: 2;
        line-clamp: 2;

        margin-bottom: 12px;
    }

    .hero-content{
        min-height: 360px;
        max-width: 94vw;
    }

    #heroDescription{
        max-width: 92vw;

        -webkit-line-clamp: 3;
        line-clamp: 3;
    }
}
</style>


<style id="hero-layout-final">
