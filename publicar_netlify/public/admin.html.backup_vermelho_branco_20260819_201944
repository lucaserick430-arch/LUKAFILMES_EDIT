}

.luka-mini-box{
    width:min(390px,94vw);
    max-height:70vh;
    overflow:hidden;
    border:1px solid rgba(168,85,247,.42);
    border-radius:20px;
    background:
        radial-gradient(circle at top right,
            rgba(168,85,247,.18),
            transparent 42%),
