</style>

</head>

<body>

<header>
 <div class="top">
  <div>
   <a href="/" class="logo logo-btn">LUKA <span>FILMES</span></a>
   <div class="sub"><span class="dot"></span>Painel Administrativo</div>
  </div>
  <button class="btn-dark" onclick="carregar()">↻ Atualizar</button>
 </div>
</header>

<main class="container">

 <section class="grid">
  <div class="card">
   <div class="stat-label">TOTAL</div>
   <div id="total" class="stat-value">0</div>
  </div>
  <div class="card">
   <div class="stat-label">ONLINE</div>
   <div id="online" class="stat-value stat-green">0</div>
  </div>
  <div class="card">
   <div class="stat-label">TESTES</div>
   <div id="testes" class="stat-value stat-blue">0</div>
  </div>
  <div class="card">
   <div class="stat-label">REVENDEDORES</div>
   <div id="revendedores" class="stat-value stat-purple">0</div>
  </div>
 </section>

 <div class="actions">
  <button onclick="abrirCriar('usuario')">＋ Criar usuário</button>
  <button class="btn-blue" onclick="abrirCriar('teste')">🧪 Criar teste</button>
  <button class="btn-orange" onclick="abrirCriar('revendedor')">🤝 Criar revendedor</button>
 </div>

 <section class="panel">
  <div class="panel-title">
   <h2>Gerenciamento de acessos</h2>
   <input id="busca" class="search" placeholder="🔎 Pesquisar usuário..." oninput="render()">
  </div>

  <div class="filters">
   <button class="btn-dark" onclick="filtro='todos';render()">Todos</button>
   <button class="btn-blue" onclick="filtro='usuario';render()">Usuários</button>
   <button class="btn-dark" onclick="filtro='teste';render()">Testes</button>
   <button class="btn-orange" onclick="filtro='revendedor';render()">Revendedores</button>
   <button class="btn-green" onclick="filtro='online';render()">Online</button>
  </div>

  <div class="table-wrap">
   <table>
    <thead>
     <tr>
      <th>Usuário</th>
      <th>Tipo</th>
      <th>Status</th>
      <th>Validade</th>
      <th>Conexão</th>
      <th>Ações</th>
     </tr>
    </thead>
    <tbody id="lista"></tbody>
   </table>
  </div>
 </section>

</main>

<div id="modal" class="modal">
 <div class="modal-box">
  <h2 id="modalTitulo">Criar usuário</h2>

  <input type="hidden" id="editId">

  <label>Usuário</label>
  <input id="usuario" autocomplete="off">

  <label>Senha</label>
  <input id="senha" type="password" autocomplete="new-password">

  <label>Tipo</label>
  <select id="tipo">
   <option value="usuario">Usuário</option>
   <option value="teste">Teste</option>
   <option value="revendedor">Revendedor</option>
  </select>

  <label>Dias de acesso</label>
  <input id="dias" type="number" min="1" value="30">

  <label>Limite de conexões (revendedor)</label>
  <input id="limite" type="number" min="1" value="1">

  <div class="modal-actions">
   <button class="btn-dark" onclick="fecharModal()">Cancelar</button>
   <button onclick="salvar()">Salvar</button>
  </div>
 </div>
</div>

<div id="toast" class="toast"></div>

<div id="lukaMiniOverlay" class="luka-mini-overlay" onclick="lukaFecharMini(event)">
    <div class="luka-mini-box" onclick="event.stopPropagation()">

        <div class="luka-mini-topo">

            <div class="luka-mini-titulo">
                <span class="luka-mini-ponto"></span>

                <div>
                    <strong id="lukaMiniTitulo">Usuários</strong>
                    <span id="lukaMiniContador" class="luka-mini-contador">0</span>
                </div>
            </div>

            <button
                class="luka-mini-fechar"
                onclick="lukaFecharMini()"
                aria-label="Fechar"
            >×</button>

        </div>

        <div id="lukaMiniLista" class="luka-mini-lista"></div>

        <div class="luka-mini-rodape">
            LUKA FILMES • Gerenciamento de acessos
        </div>

    </div>
</div>


<script>
window.usuarios=[];
let usuarios=window.usuarios;
let filtro="todos";

function toast(msg){
 const t=document.getElementById("toast");
 t.textContent=msg;
 t.classList.add("show");
 setTimeout(()=>t.classList.remove("show"),2800);
}

async function api(url,options={}){
 const r=await fetch(url,{
  credentials:"same-origin",
  headers:{"Content-Type":"application/json",...(options.headers||{})},
  ...options
 });
 let data={};
 try{data=await r.json()}catch(e){}
 if(!r.ok) throw new Error(data.mensagem||"Erro na operação");
 return data;
}

async function carregar(){
 try{
  const data=await api("/api/admin/usuarios");
  usuarios=Array.isArray(data.usuarios)?data.usuarios:[];
  atualizarResumo();
  render();
 }catch(e){
  toast("❌ "+e.message);
 }
}

function atualizarResumo(){
 document.getElementById("total").textContent=usuarios.length;
 document.getElementById("online").textContent=usuarios.filter(x=>x.online).length;
 document.getElementById("testes").textContent=usuarios.filter(x=>x.tipo==="teste").length;
 document.getElementById("revendedores").textContent=usuarios.filter(x=>x.tipo==="revendedor").length;
}

function render(){
 const busca=(document.getElementById("busca").value||"").toLowerCase();

 let lista=usuarios.filter(u=>{
  if(filtro==="online"&&!u.online)return false;
  if(filtro!=="todos"&&filtro!=="online"&&u.tipo!==filtro)return false;
  return String(u.usuario||"").toLowerCase().includes(busca);
 });

 const tbody=document.getElementById("lista");

 if(!lista.length){
  tbody.innerHTML='<tr><td colspan="6" class="empty">Nenhum usuário encontrado.</td></tr>';
  return;
 }

 tbody.innerHTML=lista.map(u=>{
  const validade=u.validade
   ? new Date(u.validade).toLocaleDateString("pt-BR")
   : "—";

  const tipo=u.tipo||"usuario";
  const online=u.online
   ? '<span class="online">● ONLINE</span>'
   : '<span class="offline">● OFFLINE</span>';

  const status=u.status==="suspenso"
   ? '<span class="status-suspenso">SUSPENSO</span>'
   : '<span class="status-ativo">ATIVO</span>';

  return `
   <tr>
    <td><strong>${esc(u.usuario)}</strong></td>
    <td><span class="badge">${esc(tipo)}</span></td>
    <td>${status}</td>
    <td>${validade}</td>
    <td>${online}</td>
    <td>
     <div class="row-actions">
      <button class="btn-blue" onclick="editar(${u.id})">Editar</button>
      <button class="btn-green" onclick="renovar(${u.id})">Renovar</button>
      <button class="${u.status==='suspenso'?'btn-green':'btn-orange'}" onclick="status(${u.id},'${u.status==='suspenso'?'ativo':'suspenso'}')">
       ${u.status==='suspenso'?'Ativar':'Suspender'}
      </button>
      <button class="btn-red" onclick="excluir(${u.id})">Excluir</button>
     </div>
    </td>
   </tr>
  `;
 }).join("");
}

function esc(v){
 return String(v??"")
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");
}

function abrirCriar(tipo){
 document.getElementById("editId").value="";
 document.getElementById("usuario").value="";
 document.getElementById("senha").value="";
