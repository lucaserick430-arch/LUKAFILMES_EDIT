    border-bottom:1px solid rgba(255,255,255,.07);
}

.luka-mini-titulo{
    display:flex;
    align-items:center;
    gap:10px;
}

.luka-mini-ponto{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#ef4444;
    box-shadow:
        0 0 7px #ef4444,
        0 0 16px rgba(168,85,247,.7);
    animation:lukaMiniPulsar 1.25s ease-in-out infinite;
}

@keyframes lukaMiniPulsar{
    0%,100%{
        opacity:.35;
        transform:scale(.75);
    }
    50%{
        opacity:1;
        transform:scale(1.2);
    }
}

.luka-mini-titulo strong{
    font-size:15px;
    color:#fff;
}

.luka-mini-contador{
    margin-left:5px;
