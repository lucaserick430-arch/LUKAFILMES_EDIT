<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>LUKA FILMES • Administração</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
 --bg:#070a12;
 --card:#0f1420;
 --card2:#151b29;
 --line:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --green:#a855f7;
 --blue:#7c3aed;
 --purple:#9333ea;
 --red:#e11d48;
 --orange:#c026d3;
}
body{
 font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;
 background:radial-gradient(circle at top,#24102b 0,#0a080d 42%,#050507 100%);
 color:var(--text);
 min-height:100vh;
}
header{
 position:sticky;
 top:0;
 z-index:20;
 background:rgba(7,10,18,.86);
 backdrop-filter:blur(18px);
 border-bottom:1px solid var(--line);
 padding:15px;
}
.top{
 max-width:1250px;
 margin:auto;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
}
.logo{margin-bottom:2px;
 font-size:20px;
 font-weight:900;
 letter-spacing:.5px;
}
.logo span{color:#8b5cf6}
@keyframes lukaPulse{
 0%,100%{
   opacity:1;
   transform:scale(1);
   background:#e11d48;
   box-shadow:0 0 7px #e11d48,0 0 14px rgba(225,29,72,.45);
 }
 50%{
   opacity:.25;
   transform:scale(.85);
   background:#9333ea;
   box-shadow:0 0 5px #9333ea;
 }
}
.sub{font-size:11px;color:var(--muted);margin-top:8px;line-height:16px}
@keyframes pulseDot{
  0%,100%{transform:scale(1);opacity:1;box-shadow:0 0 7px #e11d48}
  50%{transform:scale(1.55);opacity:.55;box-shadow:0 0 20px #e11d48}
}
.logo-btn{
  display:inline-block;
  color:white;
  text-decoration:none;
  cursor:pointer;
  transition:.2s;
}
.logo-btn:hover{
  transform:scale(1.03);
  text-shadow:0 0 18px rgba(168,85,247,.7);
}
.dot{
 width:9px;
 height:9px;
 border-radius:50%;
 display:inline-block;
 margin-right:6px;
 background:#e11d48;
 box-shadow:0 0 8px #e11d48;
 animation:lukaPulse 1.6s ease-in-out infinite;
}
 width:9px;height:9px;border-radius:50%;
 background:#e11d48;
 display:inline-block;
 box-shadow:0 0 12px var(--green);
 margin-right:6px;
}
.container{max-width:1250px;margin:auto;padding:18px 14px 40px}
.grid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
}
.card{
 background:linear-gradient(145deg,rgba(21,27,41,.96),rgba(11,15,25,.96));
 border:1px solid var(--line);
 border-radius:18px;
 padding:17px;
 box-shadow:0 15px 45px rgba(0,0,0,.2);
}
.stat-label{font-size:12px;color:var(--muted)}
.stat-value{font-size:29px;font-weight:900;margin-top:7px}
.stat-green{color:#4ade80}
.stat-blue{color:#60a5fa}
.stat-purple{color:#a78bfa}
.stat-orange{color:#fbbf24}

.actions{
 margin-top:15px;
 display:flex;
 gap:9px;
 flex-wrap:wrap;
}
button{
 border:0;
 border-radius:11px;
 padding:11px 14px;
 color:white;
 font-weight:800;
 cursor:pointer;
 background:linear-gradient(135deg,#7e22ce,#e11d48);
}
button:hover{filter:brightness(1.12)}
.btn-blue{background:var(--blue)}
.btn-green{background:#16a34a}
.btn-red{background:var(--red)}
.btn-dark{background:#202938}
.btn-orange{background:#d97706}

.panel{
 margin-top:15px;
 padding:15px;
 background:rgba(15,20,32,.9);
 border:1px solid var(--line);
 border-radius:18px;
}
.panel-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 margin-bottom:14px;
}
.panel-title h2{font-size:17px}
.search{
 width:100%;
 max-width:380px;
 background:#080c15;
 color:white;
 border:1px solid var(--line);
 border-radius:11px;
 padding:11px 13px;
 outline:none;
}
.filters{
 display:flex;
 gap:7px;
 overflow:auto;
 padding-bottom:4px;
 margin-bottom:13px;
}
.filters button{white-space:nowrap}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{
 padding:13px 10px;
 border-bottom:1px solid var(--line);
 text-align:left;
 font-size:13px;
}
th{color:var(--muted);font-size:11px;text-transform:uppercase}
.badge{
 display:inline-flex;
 padding:5px 8px;
 border-radius:8px;
 font-size:10px;
 font-weight:900;
 background:#263044;
}
.online{color:#d946ef;font-weight:900}
.offline{color:#64748b}
.status-ativo{color:#4ade80}
.status-suspenso{color:#f87171}
.row-actions{display:flex;gap:5px;flex-wrap:wrap}
.row-actions button{padding:7px 9px;font-size:10px}

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.72);
 backdrop-filter:blur(8px);
 display:none;
 align-items:center;
 justify-content:center;
 z-index:100;
 padding:15px;
}
.modal.show{display:flex}
.modal-box{
 width:100%;
 max-width:480px;
 background:#101624;
 border:1px solid var(--line);
 border-radius:20px;
 padding:20px;
 box-shadow:0 30px 90px rgba(0,0,0,.5);
}
.modal-box h2{margin-bottom:15px}
label{
 display:block;
 color:var(--muted);
 font-size:12px;
 font-weight:700;
 margin:11px 0 5px;
}
input,select{
 width:100%;
 padding:12px;
 border-radius:11px;
 border:1px solid var(--line);
 background:#080c15;
 color:white;
 outline:none;
}
.modal-actions{
 display:flex;
 gap:8px;
 margin-top:17px;
}
.modal-actions button{flex:1}
.toast{
 position:fixed;
 right:15px;
 bottom:15px;
 z-index:200;
 background:#101827;
 border:1px solid rgba(139,92,246,.45);
 border-radius:13px;
 padding:13px 15px;
 display:none;
 box-shadow:0 15px 40px rgba(0,0,0,.4);
}
.toast.show{display:block}
.empty{
 text-align:center;
 padding:35px 10px;
 color:var(--muted);
}
@media(max-width:850px){
 .grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
 .grid{grid-template-columns:repeat(2,1fr);gap:8px}
 .card{padding:13px;border-radius:15px}
 .stat-value{font-size:23px}
 .top{align-items:flex-start}
 .actions button{flex:1}
 .panel-title{align-items:stretch;flex-direction:column}
}
</style>

<style id="luka-botao-atualizar">
#lukaAtualizarBtn{
    position:relative;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    min-height:44px;
    padding:0 18px;
    border:1px solid rgba(239,68,68,.45);
    border-radius:13px;
    background:linear-gradient(135deg,#7f1d1d,#581c87);
    color:#fff;
    font-weight:700;
    font-size:14px;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(127,29,29,.28);
    transition:transform .18s ease,box-shadow .18s ease,filter .18s ease;
    overflow:hidden;
}

#lukaAtualizarBtn::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        110deg,
        transparent 25%,
        rgba(255,255,255,.16) 50%,
        transparent 75%
    );
    transform:translateX(-120%);
    transition:transform .55s ease;
}

#lukaAtualizarBtn:hover{
    transform:translateY(-2px);
    filter:brightness(1.12);
    box-shadow:0 12px 30px rgba(127,29,29,.4);
}

#lukaAtualizarBtn:hover::before{
    transform:translateX(120%);
}

#lukaAtualizarBtn:active{
    transform:scale(.97);
}

#lukaAtualizarBtn .luka-refresh-icon{
    display:inline-flex;
    font-size:18px;
    line-height:1;
    transition:transform .5s ease;
}

#lukaAtualizarBtn.loading .luka-refresh-icon{
    animation:lukaGirar .8s linear infinite;
}

@keyframes lukaGirar{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
}

#lukaAtualizarBtn .luka-refresh-text{
    position:relative;
    z-index:1;
}
</style>


<style id="luka-cards-filtros">
.stat-card{
    cursor:pointer !important;
    position:relative;
    user-select:none;
    transition:
        transform .20s ease,
        box-shadow .20s ease,
        border-color .20s ease,
        filter .20s ease;
}

.stat-card:hover{
    transform:translateY(-4px);
    filter:brightness(1.08);
}

.stat-card:active{
    transform:scale(.98);
}

.stat-card.luka-card-ativo{
    transform:translateY(-3px);
    border-color:rgba(239,68,68,.75) !important;
    box-shadow:
        0 0 0 1px rgba(217,70,239,.25),
        0 12px 35px rgba(88,28,135,.35);
}

.stat-card.luka-card-ativo::after{
    content:"";
    position:absolute;
    left:18px;
    right:18px;
    bottom:-1px;
    height:3px;
    border-radius:99px;
    background:linear-gradient(90deg,#ef4444,#a855f7,#ef4444);
    box-shadow:0 0 12px rgba(168,85,247,.65);
}

.stat-card .luka-filtro-hint{
    display:block;
    margin-top:5px;
    font-size:10px;
    font-weight:700;
    letter-spacing:.4px;
    opacity:.55;
    text-transform:uppercase;
}

.luka-filtro-titulo{
    display:flex;
    align-items:center;
    gap:8px;
    margin:10px 0 14px;
}

.luka-filtro-titulo .luka-ponto{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#ef4444;
    box-shadow:0 0 10px rgba(239,68,68,.75);
    animation:lukaPulsar 1.5s ease-in-out infinite;
}

@keyframes lukaPulsar{
    0%,100%{
        opacity:.35;
        transform:scale(.8);
    }
    50%{
        opacity:1;
        transform:scale(1.15);
    }
}
</style>


