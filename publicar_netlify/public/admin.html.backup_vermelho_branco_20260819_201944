<script id="luka-filtros-definitivos">
(function(){

    function iniciarFiltros(){

        const configuracao = [
            { id: "total", filtro: "todos" },
            { id: "online", filtro: "online" },
            { id: "testes", filtro: "teste" },
            { id: "revendedores", filtro: "revendedor" }
        ];

        configuracao.forEach(item => {

            const valor = document.getElementById(item.id);

            if (!valor) return;

            /*
             * Procura o bloco visual que contém o número.
             * Não depende de uma classe específica.
             */
            let card = valor.parentElement;

            for(let i = 0; i < 4 && card; i++){

                const texto = (card.textContent || "").toLowerCase();

                if(
                    texto.includes("total") ||
                    texto.includes("online") ||
                    texto.includes("testes") ||
                    texto.includes("revendedores")
                ){
                    break;
                }

                card = card.parentElement;
            }

            if(!card) return;

            card.style.cursor = "pointer";
            card.setAttribute("role","button");
            card.setAttribute("tabindex","0");
            card.dataset.filtroLuka = item.filtro;

            /*
             * Evita registrar o evento duas vezes.
             */
            if(card.dataset.lukaFiltroAtivo === "1") return;

            card.dataset.lukaFiltroAtivo = "1";

            function aplicar(){

                window.filtro = item.filtro;

                /*
                 * Remove destaque dos outros cards.
                 */
                document
                    .querySelectorAll("[data-filtro-luka]")
                    .forEach(c => {
                        c.classList.remove("luka-card-ativo");
                    });

                card.classList.add("luka-card-ativo");

                /*
                 * Usa o render existente do seu painel.
                 */
                if(typeof window.render === "function"){
                    window.render();
                }

                /*
                 * Também tenta renderizar pelo nome global,
                 * caso a função esteja declarada diretamente.
                 */
                try{
                    if(typeof render === "function"){
                        render();
                    }
                }catch(e){}

            }

            card.addEventListener("click", function(e){

                /*
                 * Não interfere em botões internos.
                 */
                if(e.target.closest("button,a,input,select")){
                    return;
                }

                aplicar();

            });

            card.addEventListener("keydown", function(e){

                if(e.key === "Enter" || e.key === " "){
                    e.preventDefault();
                    aplicar();
                }

            });

        });

        /*
         * TOTAL começa selecionado.
         */
        const total = document.querySelector(
            '[data-filtro-luka="todos"]'
        );

        if(total){
            total.classList.add("luka-card-ativo");
        }

    }

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            iniciarFiltros
        );
    }else{
        iniciarFiltros();
    }

})();
</script>


<script id="luka-mini-paineis-js">

(function(){

    function escapar(valor){
        return String(valor ?? "")
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#039;");
    }

    window.lukaAbrirMini = function(tipo){

        const overlay = document.getElementById("lukaMiniOverlay");
        const titulo = document.getElementById("lukaMiniTitulo");
        const contador = document.getElementById("lukaMiniContador");
        const lista = document.getElementById("lukaMiniLista");

        if(!overlay || !lista) return;

        let todos = Array.isArray(window.usuarios)
            ? window.usuarios
            : (typeof usuarios !== "undefined" && Array.isArray(usuarios)
                ? usuarios
                : []);

        let selecionados = [];

        if(tipo === "todos"){
            titulo.textContent = "Todos os usuários";
            selecionados = todos;

        }else if(tipo === "online"){
            titulo.textContent = "Usuários online";
            selecionados = todos.filter(u => !!u.online);

        }else if(tipo === "teste"){
            titulo.textContent = "Testes";
            selecionados = todos.filter(u =>
                String(u.tipo || "").toLowerCase() === "teste"
            );

        }else if(tipo === "revendedor"){
            titulo.textContent = "Revendedores";
            selecionados = todos.filter(u =>
                String(u.tipo || "").toLowerCase() === "revendedor"
            );
        }

        contador.textContent = selecionados.length;

        if(!selecionados.length){

            lista.innerHTML = `
                <div class="luka-mini-vazio">
                    Nenhum acesso encontrado neste grupo.
                </div>
            `;

        }else{

            lista.innerHTML = selecionados.map(u => {

                const nome = escapar(u.usuario || "Sem usuário");

                let tipoTexto =
                    String(u.tipo || "usuario");

                if(tipoTexto === "teste"){
                    tipoTexto = "Teste";
                }else if(tipoTexto === "revendedor"){
                    tipoTexto = "Revendedor";
                }else if(tipoTexto === "admin"){
                    tipoTexto = "Administrador";
                }else{
                    tipoTexto = "Usuário";
                }

                const online = !!u.online;

                return `
                    <div class="luka-mini-item">

                        <div class="luka-mini-esquerda">
                            <div class="luka-mini-nome">
                                ${nome}
                            </div>

                            <div class="luka-mini-tipo">
                                ${escapar(tipoTexto)}
                            </div>
                        </div>

                        <span class="luka-mini-status ${online ? "online" : "offline"}">
                            ${online ? "● ONLINE" : "OFFLINE"}
                        </span>

                    </div>
                `;

            }).join("");

        }

        overlay.classList.add("aberto");
        document.body.style.overflow = "hidden";
    };

    window.lukaFecharMini = function(event){

        if(event && event.target !== event.currentTarget){
            return;
        }

        const overlay =
            document.getElementById("lukaMiniOverlay");

        if(overlay){
            overlay.classList.remove("aberto");
        }

        document.body.style.overflow = "";
    };

    /*
     * Liga os quatro cards aos mini painéis.
     * Usa os IDs reais do seu painel.
     */

    function ligarCards(){

        const mapa = {
            total: "todos",
            online: "online",
            testes: "teste",
            revendedores: "revendedor"
        };

        Object.entries(mapa).forEach(([id,tipo]) => {

            const numero =
                document.getElementById(id);

            if(!numero) return;

            let card = numero.parentElement;

            /*
             * Sobe alguns níveis procurando o bloco visual.
             */
            for(let i = 0; i < 4 && card; i++){

                if(
                    card.children &&
                    card.children.length >= 1
                ){
                    break;
                }

                card = card.parentElement;
            }

            if(!card) return;

            if(card.dataset.lukaMiniLigado === "1"){
                return;
            }

            card.dataset.lukaMiniLigado = "1";
            card.style.cursor = "pointer";

            card.addEventListener("click", function(e){

                if(
                    e.target.closest("button") ||
                    e.target.closest("a") ||
                    e.target.closest("input") ||
                    e.target.closest("select")
                ){
                    return;
                }

                window.lukaAbrirMini(tipo);
            });

        });

    }

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            ligarCards
        );
    }else{
        ligarCards();
    }

    /*
     * Fecha com ESC.
     */
    document.addEventListener("keydown", function(e){

        if(e.key === "Escape"){
            window.lukaFecharMini();
        }

    });

})();

</script>

