<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>LUKA FILMES • Administração</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
 --bg:#070a12;
 --card:#0f1420;
 --card2:#151b29;
 --line:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --green:#a855f7;
 --blue:#7c3aed;
 --purple:#9333ea;
 --red:#e11d48;
 --orange:#c026d3;
}
body{
 font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;
 background:radial-gradient(circle at top,#24102b 0,#0a080d 42%,#050507 100%);
 color:var(--text);
 min-height:100vh;
}
header{
 position:sticky;
 top:0;
 z-index:20;
 background:rgba(7,10,18,.86);
 backdrop-filter:blur(18px);
 border-bottom:1px solid var(--line);
 padding:15px;
}
.top{
 max-width:1250px;
 margin:auto;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
}
.logo{margin-bottom:2px;
 font-size:20px;
 font-weight:900;
 letter-spacing:.5px;
}
.logo span{color:#8b5cf6}
@keyframes lukaPulse{
 0%,100%{
   opacity:1;
   transform:scale(1);
   background:#e11d48;
   box-shadow:0 0 7px #e11d48,0 0 14px rgba(225,29,72,.45);
 }
 50%{
   opacity:.25;
   transform:scale(.85);
   background:#9333ea;
   box-shadow:0 0 5px #9333ea;
 }
}
.sub{font-size:11px;color:var(--muted);margin-top:8px;line-height:16px}
@keyframes pulseDot{
  0%,100%{transform:scale(1);opacity:1;box-shadow:0 0 7px #e11d48}
  50%{transform:scale(1.55);opacity:.55;box-shadow:0 0 20px #e11d48}
}
.logo-btn{
  display:inline-block;
  color:white;
  text-decoration:none;
  cursor:pointer;
  transition:.2s;
}
.logo-btn:hover{
  transform:scale(1.03);
  text-shadow:0 0 18px rgba(168,85,247,.7);
}
.dot{
 width:9px;
 height:9px;
 border-radius:50%;
 display:inline-block;
 margin-right:6px;
 background:#e11d48;
 box-shadow:0 0 8px #e11d48;
 animation:lukaPulse 1.6s ease-in-out infinite;
}
 width:9px;height:9px;border-radius:50%;
 background:#e11d48;
 display:inline-block;
 box-shadow:0 0 12px var(--green);
 margin-right:6px;
}
.container{max-width:1250px;margin:auto;padding:18px 14px 40px}
.grid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
}
.card{
 background:linear-gradient(145deg,rgba(21,27,41,.96),rgba(11,15,25,.96));
 border:1px solid var(--line);
 border-radius:18px;
 padding:17px;
 box-shadow:0 15px 45px rgba(0,0,0,.2);
}
.stat-label{font-size:12px;color:var(--muted)}
.stat-value{font-size:29px;font-weight:900;margin-top:7px}
.stat-green{color:#4ade80}
.stat-blue{color:#60a5fa}
.stat-purple{color:#a78bfa}
.stat-orange{color:#fbbf24}

.actions{
 margin-top:15px;
 display:flex;
 gap:9px;
 flex-wrap:wrap;
}
button{
 border:0;
 border-radius:11px;
 padding:11px 14px;
 color:white;
 font-weight:800;
 cursor:pointer;
 background:linear-gradient(135deg,#7e22ce,#e11d48);
}
button:hover{filter:brightness(1.12)}
.btn-blue{background:var(--blue)}
.btn-green{background:#16a34a}
.btn-red{background:var(--red)}
.btn-dark{background:#202938}
.btn-orange{background:#d97706}

.panel{
 margin-top:15px;
 padding:15px;
 background:rgba(15,20,32,.9);
 border:1px solid var(--line);
 border-radius:18px;
}
.panel-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 margin-bottom:14px;
}
.panel-title h2{font-size:17px}
.search{
 width:100%;
 max-width:380px;
 background:#080c15;
 color:white;
 border:1px solid var(--line);
 border-radius:11px;
 padding:11px 13px;
 outline:none;
}
.filters{
 display:flex;
 gap:7px;
 overflow:auto;
 padding-bottom:4px;
 margin-bottom:13px;
}
.filters button{white-space:nowrap}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{
 padding:13px 10px;
 border-bottom:1px solid var(--line);
 text-align:left;
 font-size:13px;
}
th{color:var(--muted);font-size:11px;text-transform:uppercase}
.badge{
 display:inline-flex;
 padding:5px 8px;
 border-radius:8px;
 font-size:10px;
 font-weight:900;
 background:#263044;
}
.online{color:#d946ef;font-weight:900}
.offline{color:#64748b}
.status-ativo{color:#4ade80}
.status-suspenso{color:#f87171}
.row-actions{display:flex;gap:5px;flex-wrap:wrap}
.row-actions button{padding:7px 9px;font-size:10px}

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.72);
 backdrop-filter:blur(8px);
 display:none;
 align-items:center;
 justify-content:center;
 z-index:100;
 padding:15px;
}
.modal.show{display:flex}
.modal-box{
 width:100%;
 max-width:480px;
 background:#101624;
 border:1px solid var(--line);
 border-radius:20px;
 padding:20px;
 box-shadow:0 30px 90px rgba(0,0,0,.5);
}
.modal-box h2{margin-bottom:15px}
label{
 display:block;
 color:var(--muted);
 font-size:12px;
 font-weight:700;
 margin:11px 0 5px;
}
input,select{
 width:100%;
 padding:12px;
 border-radius:11px;
 border:1px solid var(--line);
 background:#080c15;
 color:white;
 outline:none;
}
.modal-actions{
 display:flex;
 gap:8px;
 margin-top:17px;
}
.modal-actions button{flex:1}
.toast{
 position:fixed;
 right:15px;
 bottom:15px;
 z-index:200;
 background:#101827;
 border:1px solid rgba(139,92,246,.45);
 border-radius:13px;
 padding:13px 15px;
 display:none;
 box-shadow:0 15px 40px rgba(0,0,0,.4);
}
.toast.show{display:block}
.empty{
 text-align:center;
 padding:35px 10px;
 color:var(--muted);
}
@media(max-width:850px){
 .grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
 .grid{grid-template-columns:repeat(2,1fr);gap:8px}
 .card{padding:13px;border-radius:15px}
 .stat-value{font-size:23px}
 .top{align-items:flex-start}
 .actions button{flex:1}
 .panel-title{align-items:stretch;flex-direction:column}
}
</style>

<style id="luka-botao-atualizar">
#lukaAtualizarBtn{
    position:relative;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    min-height:44px;
    padding:0 18px;
    border:1px solid rgba(239,68,68,.45);
    border-radius:13px;
    background:linear-gradient(135deg,#7f1d1d,#581c87);
    color:#fff;
    font-weight:700;
    font-size:14px;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(127,29,29,.28);
    transition:transform .18s ease,box-shadow .18s ease,filter .18s ease;
    overflow:hidden;
}

#lukaAtualizarBtn::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        110deg,
        transparent 25%,
        rgba(255,255,255,.16) 50%,
        transparent 75%
    );
    transform:translateX(-120%);
    transition:transform .55s ease;
}

#lukaAtualizarBtn:hover{
    transform:translateY(-2px);
    filter:brightness(1.12);
    box-shadow:0 12px 30px rgba(127,29,29,.4);
}

#lukaAtualizarBtn:hover::before{
    transform:translateX(120%);
}

#lukaAtualizarBtn:active{
    transform:scale(.97);
}

#lukaAtualizarBtn .luka-refresh-icon{
    display:inline-flex;
    font-size:18px;
    line-height:1;
    transition:transform .5s ease;
}

#lukaAtualizarBtn.loading .luka-refresh-icon{
    animation:lukaGirar .8s linear infinite;
}

@keyframes lukaGirar{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
}

#lukaAtualizarBtn .luka-refresh-text{
    position:relative;
    z-index:1;
}
</style>


<style id="luka-cards-filtros">
.stat-card{
    cursor:pointer !important;
    position:relative;
    user-select:none;
    transition:
        transform .20s ease,
        box-shadow .20s ease,
        border-color .20s ease,
        filter .20s ease;
}

.stat-card:hover{
    transform:translateY(-4px);
    filter:brightness(1.08);
}

.stat-card:active{
    transform:scale(.98);
}

.stat-card.luka-card-ativo{
    transform:translateY(-3px);
    border-color:rgba(239,68,68,.75) !important;
    box-shadow:
        0 0 0 1px rgba(217,70,239,.25),
        0 12px 35px rgba(88,28,135,.35);
}

.stat-card.luka-card-ativo::after{
    content:"";
    position:absolute;
    left:18px;
    right:18px;
    bottom:-1px;
    height:3px;
    border-radius:99px;
    background:linear-gradient(90deg,#ef4444,#a855f7,#ef4444);
    box-shadow:0 0 12px rgba(168,85,247,.65);
}

.stat-card .luka-filtro-hint{
    display:block;
    margin-top:5px;
    font-size:10px;
    font-weight:700;
    letter-spacing:.4px;
    opacity:.55;
    text-transform:uppercase;
}

.luka-filtro-titulo{
    display:flex;
    align-items:center;
    gap:8px;
    margin:10px 0 14px;
}

.luka-filtro-titulo .luka-ponto{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#ef4444;
    box-shadow:0 0 10px rgba(239,68,68,.75);
    animation:lukaPulsar 1.5s ease-in-out infinite;
}

@keyframes lukaPulsar{
    0%,100%{
        opacity:.35;
        transform:scale(.8);
    }
    50%{
        opacity:1;
        transform:scale(1.15);
    }
}
</style>


<style id="luka-mini-paineis">

.luka-mini-overlay{
    position:fixed;
    inset:0;
    z-index:99999;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(0,0,0,.68);
    backdrop-filter:blur(7px);
}

.luka-mini-overlay.aberto{
    display:flex;
    animation:lukaFadeIn .18s ease;
}

@keyframes lukaFadeIn{
    from{opacity:0}
    to{opacity:1}
}

.luka-mini-box{
    width:min(390px,94vw);
    max-height:70vh;
    overflow:hidden;
    border:1px solid rgba(168,85,247,.42);
    border-radius:20px;
    background:
        radial-gradient(circle at top right,
            rgba(168,85,247,.18),
            transparent 42%),
        radial-gradient(circle at bottom left,
            rgba(239,68,68,.13),
            transparent 45%),
        #0b0b12;
    box-shadow:
        0 25px 80px rgba(0,0,0,.7),
        0 0 35px rgba(168,85,247,.16);
    transform:scale(.94);
    animation:lukaMiniEntrada .2s ease forwards;
}

@keyframes lukaMiniEntrada{
    to{transform:scale(1)}
}

.luka-mini-topo{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:17px 18px 14px;
    border-bottom:1px solid rgba(255,255,255,.07);
}

.luka-mini-titulo{
    display:flex;
    align-items:center;
    gap:10px;
}

.luka-mini-ponto{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#ef4444;
    box-shadow:
        0 0 7px #ef4444,
        0 0 16px rgba(168,85,247,.7);
    animation:lukaMiniPulsar 1.25s ease-in-out infinite;
}

@keyframes lukaMiniPulsar{
    0%,100%{
        opacity:.35;
        transform:scale(.75);
    }
    50%{
        opacity:1;
        transform:scale(1.2);
    }
}

.luka-mini-titulo strong{
    font-size:15px;
    color:#fff;
}

.luka-mini-contador{
    margin-left:5px;
    color:#d946ef;
    font-weight:900;
}

.luka-mini-fechar{
    width:32px;
    height:32px;
    border:0;
    border-radius:10px;
    background:rgba(255,255,255,.07);
    color:#fff;
    font-size:18px;
    cursor:pointer;
}

.luka-mini-fechar:hover{
    background:rgba(239,68,68,.25);
}

.luka-mini-lista{
    padding:10px;
    max-height:50vh;
    overflow-y:auto;
}

.luka-mini-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:12px 13px;
    margin-bottom:7px;
    border:1px solid rgba(255,255,255,.06);
    border-radius:13px;
    background:rgba(255,255,255,.035);
}

.luka-mini-item:last-child{
    margin-bottom:0;
}

.luka-mini-esquerda{
    min-width:0;
}

.luka-mini-nome{
    color:#fff;
    font-size:13px;
    font-weight:800;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.luka-mini-tipo{
    margin-top:3px;
    color:#9ca3af;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.luka-mini-status{
    flex:none;
    padding:5px 8px;
    border-radius:999px;
    font-size:9px;
    font-weight:900;
}

.luka-mini-status.online{
    color:#4ade80;
    background:rgba(34,197,94,.1);
    border:1px solid rgba(34,197,94,.25);
}

.luka-mini-status.offline{
    color:#a1a1aa;
    background:rgba(161,161,170,.08);
    border:1px solid rgba(161,161,170,.15);
}

.luka-mini-vazio{
    text-align:center;
    padding:30px 15px;
    color:#71717a;
    font-size:12px;
}

.luka-mini-rodape{
    padding:11px 16px;
    border-top:1px solid rgba(255,255,255,.06);
    color:#71717a;
    font-size:10px;
    text-align:center;
}

</style>


<style id="luka-vermelho-branco">
/* ===== LUKA FILMES — TEMA VERMELHO + BRANCO ===== */

:root{
    --luka-red:#ef1d2f;
    --luka-red-strong:#ff2638;
    --luka-red-dark:#b90f1e;
    --luka-white:#ffffff;
    --luka-white-soft:#f4f4f5;
    --luka-bg:#090909;
}

body{
    background:
        radial-gradient(
            circle at 50% -10%,
            rgba(239,29,47,.18),
            transparent 42%
        ),
        #090909 !important;
    color:var(--luka-white) !important;
}

/* Título da área */

h2,
h3{
    color:#fff !important;
}

section{
    border-color:rgba(239,29,47,.25) !important;
}

/* Gerenciamento */

#lista{
    color:#fff;
}

.table-wrap{
    border:1px solid rgba(239,29,47,.28) !important;
    box-shadow:
        0 10px 35px rgba(0,0,0,.35),
        0 0 25px rgba(239,29,47,.06);
}

/* Cabeçalho da tabela */

table thead th{
    color:#fff !important;
    background:linear-gradient(
        90deg,
        rgba(239,29,47,.20),
        rgba(255,255,255,.035)
    ) !important;
    border-bottom:1px solid rgba(239,29,47,.35) !important;
}

/* Linhas */

table tbody tr{
    transition:
        background .18s ease,
        transform .18s ease;
}

table tbody tr:hover{
    background:rgba(239,29,47,.075) !important;
}

/* Nome do usuário */

table tbody td:first-child{
    color:#fff !important;
    font-weight:800;
}

/* ONLINE */

.online{
    color:#ff3345 !important;
    font-weight:900 !important;
    text-shadow:0 0 10px rgba(255,51,69,.45);
}

/* Botões */

button{
    transition:
        transform .18s ease,
        filter .18s ease,
        box-shadow .18s ease !important;
}

button:hover{
    filter:brightness(1.12);
    transform:translateY(-1px);
}

button:active{
    transform:scale(.97);
}

/* Botão principal */

button:not(.btn-dark):not(.btn-blue):not(.btn-orange):not(.btn-green){
    background:linear-gradient(
        135deg,
        #ff2638,
        #d91024
    ) !important;
    color:#fff !important;
    border:1px solid rgba(255,255,255,.18) !important;
    box-shadow:
        0 6px 20px rgba(239,29,47,.25);
}

/* Filtros */

.filters button{
    border:1px solid rgba(255,255,255,.12) !important;
}

.filters .btn-green,
.filters .btn-orange,
.filters .btn-blue,
.filters .btn-dark{
    color:#fff !important;
}

.filters button:hover{
    border-color:rgba(239,29,47,.65) !important;
}

/* Cards superiores */

.stat-value{
    color:#fff !important;
}

.stat-label{
    color:#d4d4d8 !important;
}

.stat-card{
    border-color:rgba(239,29,47,.22) !important;
}

.stat-card:hover{
    border-color:rgba(239,29,47,.65) !important;
    box-shadow:
        0 12px 35px rgba(239,29,47,.14);
}

.stat-card.luka-card-ativo{
    border-color:#ef1d2f !important;
    box-shadow:
        0 0 0 1px rgba(239,29,47,.25),
        0 12px 35px rgba(239,29,47,.20);
}

.stat-card.luka-card-ativo::after{
    background:linear-gradient(
        90deg,
        #b90f1e,
        #ff2638,
        #ffffff,
        #ff2638,
        #b90f1e
    ) !important;
    box-shadow:
        0 0 12px rgba(239,29,47,.7);
}

/* Mini painéis */

.luka-mini-box{
    border-color:rgba(239,29,47,.48) !important;
    background:
        radial-gradient(
            circle at top right,
            rgba(239,29,47,.18),
            transparent 42%
        ),
        #090909 !important;
}

.luka-mini-ponto{
    background:#ef1d2f !important;
    box-shadow:
        0 0 7px #ef1d2f,
        0 0 16px rgba(239,29,47,.65) !important;
}

.luka-mini-contador{
    color:#ff3345 !important;
}

.luka-mini-item{
    border-color:rgba(255,255,255,.08) !important;
}

.luka-mini-item:hover{
    border-color:rgba(239,29,47,.35) !important;
    background:rgba(239,29,47,.07) !important;
}

/* Modal */

.modal-box{
    border-color:rgba(239,29,47,.38) !important;
    box-shadow:
        0 25px 80px rgba(0,0,0,.75),
        0 0 35px rgba(239,29,47,.12);
}

.modal-box input,
.modal-box select{
    color:#fff !important;
    border-color:rgba(255,255,255,.12) !important;
}

.modal-box input:focus,
.modal-box select:focus{
    border-color:#ef1d2f !important;
    box-shadow:0 0 0 2px rgba(239,29,47,.12) !important;
}

/* Toast */

.toast{
    border-color:rgba(239,29,47,.4) !important;
    color:#fff !important;
}

/* Texto secundário */

label{
    color:#f4f4f5 !important;
}

small,
.muted{
    color:#d4d4d8 !important;
}

/* Barra vermelha decorativa */

.luka-red-line{
    height:3px;
    width:100%;
    border-radius:99px;
    margin:12px 0 20px;
    background:linear-gradient(
        90deg,
        transparent,
        #b90f1e,
        #ff2638,
        #fff,
        #ff2638,
        #b90f1e,
        transparent
    );
    box-shadow:0 0 14px rgba(239,29,47,.45);
}
</style>


<style id="luka-animacao-usuarios">

/* ===== ANIMAÇÃO LEVE DOS USUÁRIOS ===== */

table tbody tr{
    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}

table tbody tr:hover{
    transform:translateX(3px);
    background:rgba(239,29,47,.055) !important;
    box-shadow:
        inset 3px 0 0 #ef1d2f,
        0 4px 18px rgba(239,29,47,.06);
}

table tbody tr:active{
    transform:scale(.995);
}

/* Nome do usuário */

table tbody td:first-child{
    transition:
        color .18s ease,
        text-shadow .18s ease;
}

table tbody tr:hover td:first-child{
    color:#fff !important;
    text-shadow:0 0 10px rgba(239,29,47,.35);
}

/* Bolinha ONLINE pulsando suavemente */

.online{
    display:inline-flex;
    align-items:center;
    gap:5px;
}

.online::first-letter{
    animation:lukaOnlinePulsar 1.5s ease-in-out infinite;
}

@keyframes lukaOnlinePulsar{
    0%,100%{
        opacity:.45;
    }
    50%{
        opacity:1;
    }
}

/* Efeito discreto nos badges */

.badge{
    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

table tbody tr:hover .badge{
    transform:scale(1.04);
    box-shadow:0 0 10px rgba(239,29,47,.12);
}

/* No celular, toque dá um pequeno destaque */

@media (max-width:700px){

    table tbody tr:active{
        transform:translateX(2px) scale(.995);
        background:rgba(239,29,47,.08) !important;
    }

}

</style>


<style id="luka-acoes-usuario-css">

/* =========================================================
   PAINEL DE AÇÕES DO USUÁRIO
   ========================================================= */

.luka-usuario-overlay{
    position:fixed;
    inset:0;
    z-index:100000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:18px;
    background:rgba(0,0,0,.72);
    backdrop-filter:blur(7px);
}

.luka-usuario-overlay.aberto{
    display:flex;
    animation:lukaUsuarioFade .18s ease;
}

@keyframes lukaUsuarioFade{
    from{opacity:0}
    to{opacity:1}
}

.luka-usuario-box{
    width:min(360px,94vw);
    overflow:hidden;
    border:1px solid rgba(239,29,47,.48);
    border-radius:20px;
    background:
        radial-gradient(
            circle at top right,
            rgba(239,29,47,.18),
            transparent 45%
        ),
        #090909;
    box-shadow:
        0 25px 80px rgba(0,0,0,.78),
        0 0 35px rgba(239,29,47,.13);
    transform:translateY(12px) scale(.96);
    animation:lukaUsuarioEntrada .2s ease forwards;
}

@keyframes lukaUsuarioEntrada{
    to{
        transform:translateY(0) scale(1);
    }
}

.luka-usuario-topo{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:17px 18px;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.luka-usuario-identidade{
    display:flex;
    align-items:center;
    gap:11px;
    min-width:0;
}

.luka-avatar{
    width:40px;
    height:40px;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:13px;
    background:linear-gradient(
        135deg,
        #ef1d2f,
        #b90f1e
    );
    color:#fff;
    font-weight:900;
    box-shadow:0 0 18px rgba(239,29,47,.22);
}

.luka-usuario-nome{
    min-width:0;
}

.luka-usuario-nome strong{
    display:block;
    color:#fff;
    font-size:15px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.luka-usuario-tipo{
    margin-top:3px;
    color:#a1a1aa;
    font-size:10px;
    text-transform:uppercase;
}

.luka-usuario-fechar{
    width:32px;
    height:32px;
    flex:none;
    border:0;
    border-radius:10px;
    background:rgba(255,255,255,.07);
    color:#fff;
    font-size:19px;
    cursor:pointer;
}

.luka-usuario-fechar:hover{
    background:rgba(239,29,47,.22);
}

.luka-usuario-status{
    margin:14px 16px 8px;
    padding:9px 11px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:11px;
    background:rgba(255,255,255,.035);
    color:#d4d4d8;
    font-size:11px;
}

.luka-status-online{
    color:#ff3345;
    font-weight:900;
}

.luka-status-offline{
    color:#a1a1aa;
    font-weight:800;
}

.luka-usuario-acoes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
    padding:10px 16px 17px;
}

.luka-acao{
    min-height:48px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:13px;
    background:rgba(255,255,255,.045);
    color:#fff;
    font-weight:800;
    cursor:pointer;
    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease;
}

.luka-acao:hover{
    transform:translateY(-2px);
    border-color:rgba(239,29,47,.48);
    background:rgba(239,29,47,.09);
}

.luka-acao:active{
    transform:scale(.97);
}

.luka-acao.editar{
    border-color:rgba(255,255,255,.16);
}

.luka-acao.suspender{
    color:#ff6673;
}

.luka-acao.renovar{
    color:#fff;
    background:linear-gradient(
        135deg,
        rgba(239,29,47,.9),
        rgba(185,15,30,.9)
    );
    border-color:rgba(255,255,255,.14);
}

.luka-acao.fechar{
    grid-column:1 / -1;
    min-height:42px;
    color:#a1a1aa;
}

/* Editor */

.luka-editor{
    display:none;
    padding:0 16px 17px;
}

.luka-editor.aberto{
    display:block;
}

.luka-editor label{
    display:block;
    margin:9px 0 5px;
    color:#d4d4d8;
    font-size:11px;
    font-weight:700;
}

.luka-editor input{
    width:100%;
    box-sizing:border-box;
    padding:11px 12px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:10px;
    background:#111;
    color:#fff;
    outline:none;
}

.luka-editor input:focus{
    border-color:#ef1d2f;
    box-shadow:0 0 0 2px rgba(239,29,47,.10);
}

.luka-editor-botoes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:12px;
}

.luka-editor-botoes button{
    min-height:42px;
    border:0;
    border-radius:10px;
    cursor:pointer;
    font-weight:800;
}

.luka-editor-cancelar{
    background:#1a1a1a;
    color:#aaa;
}

.luka-editor-salvar{
    background:#ef1d2f;
    color:#fff;
}

</style>


<style id="luka-trailer-bg">
body{background:transparent!important}
#lukaTrailerBg{
position:fixed;
inset:0;
z-index:-3;
overflow:hidden;
background:#000;
pointer-events:none;
}
#lukaTrailerBg iframe{
position:absolute;
top:50%;
left:50%;
width:177.78vh;
height:100vh;
min-width:100vw;
min-height:56.25vw;
transform:translate(-50%,-50%);
border:0;
filter:brightness(.42) saturate(.9);
}
#lukaTrailerOverlay{
position:fixed;
inset:0;
z-index:-2;
pointer-events:none;
background:
linear-gradient(rgba(0,0,0,.82),rgba(0,0,0,.88)),
radial-gradient(circle at top,rgba(180,0,20,.18),transparent 45%);
backdrop-filter:blur(1px);
}
main,header,.container,.content,section{
position:relative;
z-index:1;
}
</style>


<style id="luka-cinema-background">
#lukaCinemaBackground{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    overflow:hidden;
    z-index:0;
    pointer-events:none;
    background:#050505;
}
#lukaCinemaBackground video{
    position:absolute;
    top:50%;
    left:50%;
    width:100%;
    height:100%;
    object-fit:cover;
    transform:translate(-50%,-50%) scale(1.06);
    filter:brightness(.42) saturate(1.08);
    animation:lukaCinemaZoom 18s ease-in-out infinite alternate;
}
#lukaCinemaOverlay{
    position:fixed;
    inset:0;
    z-index:1;
    pointer-events:none;
    background:
        linear-gradient(
            180deg,
            rgba(0,0,0,.72) 0%,
            rgba(0,0,0,.38) 45%,
            rgba(0,0,0,.78) 100%
        ),
        linear-gradient(
            115deg,
            rgba(255,0,0,.12),
            transparent 42%,
            rgba(120,0,255,.12)
        );
}
@keyframes lukaCinemaZoom{
    from{transform:translate(-50%,-50%) scale(1.06)}
    to{transform:translate(-50%,-50%) scale(1.13)}
}
body{
    background:transparent!important;
}
</style>

</head>

<body>

<div id="lukaCinemaBackground">
    <video autoplay muted loop playsinline preload="auto">
        <source src="/assets/painel-bg.mp4" type="video/mp4">
    </video>
</div>
<div id="lukaCinemaOverlay"></div>



<div id="lukaTrailerBg">
<iframe
src="https://www.youtube.com/embed/2woCZg5QdVE?autoplay=1&mute=1&controls=0&loop=1&playlist=2woCZg5QdVE&modestbranding=1&rel=0&playsinline=1"
allow="autoplay; encrypted-media"
allowfullscreen>
</iframe>
</div>
<div id="lukaTrailerOverlay"></div>


<header>
 <div class="top">
  <div>
   <a href="/" class="logo logo-btn">LUKA <span>FILMES</span></a>
   <div class="sub"><span class="dot"></span>Painel Administrativo</div>
  </div>
  <button class="btn-dark" onclick="carregar()">↻ Atualizar</button>
 </div>
</header>

<main class="container">

 <section class="grid">
  <div class="card">
   <div class="stat-label">TOTAL</div>
   <div id="total" class="stat-value">0</div>
  </div>
  <div class="card">
   <div class="stat-label">ONLINE</div>
   <div id="online" class="stat-value stat-green">0</div>
  </div>
  <div class="card">
   <div class="stat-label">TESTES</div>
   <div id="testes" class="stat-value stat-blue">0</div>
  </div>
  <div class="card">
   <div class="stat-label">REVENDEDORES</div>
   <div id="revendedores" class="stat-value stat-purple">0</div>
  </div>
 </section>

 <div class="actions">
  <button onclick="abrirCriar('usuario')">＋ Criar usuário</button>
  <button class="btn-blue" onclick="abrirCriar('teste')">🧪 Criar teste</button>
  <button class="btn-orange" onclick="abrirCriar('revendedor')">🤝 Criar revendedor</button>
 </div>

 <section class="panel">
  <div class="panel-title">
   <h2>Gerenciamento de acessos</h2>
   <input id="busca" class="search" placeholder="🔎 Pesquisar usuário..." oninput="render()">
  </div>

  <div class="filters">
   <button class="btn-dark" onclick="filtro='todos';render()">Todos</button>
   <button class="btn-blue" onclick="filtro='usuario';render()">Usuários</button>
   <button class="btn-dark" onclick="filtro='teste';render()">Testes</button>
   <button class="btn-orange" onclick="filtro='revendedor';render()">Revendedores</button>
   <button class="btn-green" onclick="filtro='online';render()">Online</button>
  </div>

  <div class="table-wrap">
   <table>
    <thead>
     <tr>
      <th>Usuário</th>
      <th>Tipo</th>
      <th>Status</th>
      <th>Validade</th>
      <th>Conexão</th>
      <th>Ações</th>
     </tr>
    </thead>
    <tbody id="lista"></tbody>
   </table>
  </div>
 </section>

</main>

<div id="modal" class="modal">
 <div class="modal-box">
  <h2 id="modalTitulo">Criar usuário</h2>

  <input type="hidden" id="editId">

  <label>Usuário</label>
  <input id="usuario" autocomplete="off">

  <label>Senha</label>
  <input id="senha" type="password" autocomplete="new-password">

  <label>Tipo</label>
  <select id="tipo">
   <option value="usuario">Usuário</option>
   <option value="teste">Teste</option>
   <option value="revendedor">Revendedor</option>
  </select>

  <label>Dias de acesso</label>
  <input id="dias" type="number" min="1" value="30">

  <label>Limite de conexões (revendedor)</label>
  <input id="limite" type="number" min="1" value="1">

  <div class="modal-actions">
   <button class="btn-dark" onclick="fecharModal()">Cancelar</button>
   <button onclick="salvar()">Salvar</button>
  </div>
 </div>
</div>

<div id="toast" class="toast"></div>

<div id="lukaUsuarioOverlay"
     class="luka-usuario-overlay"
     onclick="lukaFecharAcoes(event)">

    <div class="luka-usuario-box"
         onclick="event.stopPropagation()">

        <div class="luka-usuario-topo">

            <div class="luka-usuario-identidade">

                <div id="lukaAvatar"
                     class="luka-avatar">U</div>

                <div class="luka-usuario-nome">
                    <strong id="lukaUsuarioNome">
                        Usuário
                    </strong>

                    <span id="lukaUsuarioTipo"
                          class="luka-usuario-tipo">
                        Usuário
                    </span>
                </div>

            </div>

            <button
                class="luka-usuario-fechar"
                onclick="lukaFecharAcoes()"
            >×</button>

        </div>

        <div id="lukaUsuarioStatus"
             class="luka-usuario-status">
            Status
        </div>

        <div id="lukaUsuarioAcoes"
             class="luka-usuario-acoes">

            <button
                class="luka-acao editar"
                onclick="lukaEditarUsuario()"
            >
                ✏️ Editar
            </button>

            <button
                id="lukaBotaoSuspender"
                class="luka-acao suspender"
                onclick="lukaSuspenderUsuario()"
            >
                ⛔ Suspender
            </button>

            <button
                class="luka-acao renovar"
                onclick="lukaRenovarUsuario()"
            >
                🔄 Renovar
            </button>

            <button
                class="luka-acao fechar"
                onclick="lukaFecharAcoes()"
            >
                Fechar
            </button>

        </div>

        <div id="lukaEditor"
             class="luka-editor">

            <label>Usuário</label>
            <input id="lukaEditarNome"
                   autocomplete="off">

            <label>Nova senha (opcional)</label>
            <input id="lukaEditarSenha"
                   type="password"
                   autocomplete="new-password">

            <div class="luka-editor-botoes">

                <button
                    class="luka-editor-cancelar"
                    onclick="lukaCancelarEdicao()"
                >
                    Cancelar
                </button>

                <button
                    class="luka-editor-salvar"
                    onclick="lukaSalvarEdicao()"
                >
                    Salvar
                </button>

            </div>

        </div>

    </div>
</div>


<div id="lukaMiniOverlay" class="luka-mini-overlay" onclick="lukaFecharMini(event)">
    <div class="luka-mini-box" onclick="event.stopPropagation()">

        <div class="luka-mini-topo">

            <div class="luka-mini-titulo">
                <span class="luka-mini-ponto"></span>

                <div>
                    <strong id="lukaMiniTitulo">Usuários</strong>
                    <span id="lukaMiniContador" class="luka-mini-contador">0</span>
                </div>
            </div>

            <button
                class="luka-mini-fechar"
                onclick="lukaFecharMini()"
                aria-label="Fechar"
            >×</button>

        </div>

        <div id="lukaMiniLista" class="luka-mini-lista"></div>

        <div class="luka-mini-rodape">
            LUKA FILMES • Gerenciamento de acessos
        </div>

    </div>
</div>


<script>
window.usuarios=[];
let usuarios=window.usuarios;
let filtro="todos";

function toast(msg){
 const t=document.getElementById("toast");
 t.textContent=msg;
 t.classList.add("show");
 setTimeout(()=>t.classList.remove("show"),2800);
}

async function api(url,options={}){
 const r=await fetch(url,{
  credentials:"same-origin",
  headers:{"Content-Type":"application/json",...(options.headers||{})},
  ...options
 });
 let data={};
 try{data=await r.json()}catch(e){}
 if(!r.ok) throw new Error(data.mensagem||"Erro na operação");
 return data;
}

async function carregar(){
 try{
  const data=await api("/api/admin/usuarios");
  usuarios=Array.isArray(data.usuarios)?data.usuarios:[];
  atualizarResumo();
  render();
 }catch(e){
  toast("❌ "+e.message);
 }
}

function atualizarResumo(){
 document.getElementById("total").textContent=usuarios.length;
 document.getElementById("online").textContent=usuarios.filter(x=>x.online).length;
 document.getElementById("testes").textContent=usuarios.filter(x=>x.tipo==="teste").length;
 document.getElementById("revendedores").textContent=usuarios.filter(x=>x.tipo==="revendedor").length;
}

function render(){
 const busca=(document.getElementById("busca").value||"").toLowerCase();

 let lista=usuarios.filter(u=>{
  if(filtro==="online"&&!u.online)return false;
  if(filtro!=="todos"&&filtro!=="online"&&u.tipo!==filtro)return false;
  return String(u.usuario||"").toLowerCase().includes(busca);
 });

 const tbody=document.getElementById("lista");

 if(!lista.length){
  tbody.innerHTML='<tr><td colspan="6" class="empty">Nenhum usuário encontrado.</td></tr>';
  return;
 }

 tbody.innerHTML=lista.map(u=>{
  const validade=u.validade
   ? new Date(u.validade).toLocaleDateString("pt-BR")
   : "—";

  const tipo=u.tipo||"usuario";
  const online=u.online
   ? '<span class="online">● ONLINE</span>'
   : '<span class="offline">● OFFLINE</span>';

  const status=u.status==="suspenso"
   ? '<span class="status-suspenso">SUSPENSO</span>'
   : '<span class="status-ativo">ATIVO</span>';

  return `
   <tr>
    <td><strong>${esc(u.usuario)}</strong></td>
    <td><span class="badge">${esc(tipo)}</span></td>
    <td>${status}</td>
    <td>${validade}</td>
    <td>${online}</td>
    <td>
     <div class="row-actions">
      <button class="btn-blue" onclick="editar(${u.id})">Editar</button>
      <button class="btn-green" onclick="renovar(${u.id})">Renovar</button>
      <button class="${u.status==='suspenso'?'btn-green':'btn-orange'}" onclick="status(${u.id},'${u.status==='suspenso'?'ativo':'suspenso'}')">
       ${u.status==='suspenso'?'Ativar':'Suspender'}
      </button>
      <button class="btn-red" onclick="excluir(${u.id})">Excluir</button>
     </div>
    </td>
   </tr>
  `;
 }).join("");
}

function esc(v){
 return String(v??"")
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");
}

function abrirCriar(tipo){
 document.getElementById("editId").value="";
 document.getElementById("usuario").value="";
 document.getElementById("senha").value="";
 document.getElementById("tipo").value=tipo;
 document.getElementById("dias").value=tipo==="teste"?1:30;
 document.getElementById("limite").value=5;
 document.getElementById("modalTitulo").textContent=
  tipo==="revendedor"?"Criar revendedor":
  tipo==="teste"?"Criar teste":"Criar usuário";
 document.getElementById("modal").classList.add("show");
}

function fecharModal(){
 document.getElementById("modal").classList.remove("show");
}

function editar(id){
 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!u)return;

 document.getElementById("editId").value=u.id;
 document.getElementById("usuario").value=u.usuario||"";
 document.getElementById("senha").value="";
 document.getElementById("tipo").value=u.tipo||"usuario";
 document.getElementById("dias").value=30;
 document.getElementById("modalTitulo").textContent="Editar usuário";
 document.getElementById("modal").classList.add("show");
}

async function salvar(){
 const id=document.getElementById("editId").value;
 const usuario=document.getElementById("usuario").value.trim();
 const senha=document.getElementById("senha").value;
 const tipo=document.getElementById("tipo").value;
 const dias=Number(document.getElementById("dias").value);
 const limite=Number(document.getElementById("limite").value);

 if(!usuario)return toast("Informe o usuário.");

 try{
  if(id){
   const data=await api("/api/admin/usuarios/editar",{
    method:"POST",
    body:JSON.stringify({id:Number(id),usuario,senha,tipo:tipo==="teste"?"usuario":tipo})
   });
   toast("✅ "+(data.mensagem||"Usuário atualizado."));
  }else if(tipo==="revendedor"){
   const data=await api("/api/admin/revendedores",{
    method:"POST",
    body:JSON.stringify({
     usuario,
     senha,
     dias,
     limite_conexoes:limite
    })
   });
   toast("✅ "+(data.mensagem||"Revendedor criado."));
  }else{
   const data=await api("/api/admin/usuarios",{
    method:"POST",
    body:JSON.stringify({
     usuario,
     senha,
     tipo,
     dias
    })
   });
   toast("✅ "+(data.mensagem||"Usuário criado."));
  }

  fecharModal();
  await carregar();

 }catch(e){
  toast("❌ "+e.message);
 }
}

async function status(id,status){
 try{
  const data=await api("/api/admin/usuarios/status",{
   method:"POST",
   body:JSON.stringify({id:Number(id),status})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

async function renovar(id){
 const dias=prompt("Quantos dias deseja adicionar?", "30");
 if(dias===null)return;

 const n=Number(dias);
 if(!Number.isInteger(n)||n<1){
  toast("Quantidade de dias inválida.");
  return;
 }

 try{
  const data=await api("/api/admin/usuarios/renovar",{
   method:"POST",
   body:JSON.stringify({id:Number(id),dias:n})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

async function excluir(id){
 const u=usuarios.find(x=>Number(x.id)===Number(id));
 if(!confirm("Excluir o usuário "+(u?.usuario||"")+"?"))return;

 try{
  const data=await api("/api/admin/usuarios/excluir",{
   method:"POST",
   body:JSON.stringify({id:Number(id)})
  });
  toast("✅ "+data.mensagem);
  await carregar();
 }catch(e){toast("❌ "+e.message)}
}

setInterval(async()=>{
 try{
  await api("/api/admin/presenca",{
   method:"POST",
   body:"{}"
  });
  await carregar();
 }catch(e){}
},30000);

carregar();
</script>


<script id="luka-botao-atualizar-js">
document.addEventListener("DOMContentLoaded", () => {
    const botoes = [...document.querySelectorAll("button, a")];

    const botao = botoes.find(el =>
        (el.textContent || "").trim().toLowerCase().includes("atualizar")
    );

    if (!botao) {
        console.log("[LUKA] Botão Atualizar não encontrado.");
        return;
    }

    botao.id = "lukaAtualizarBtn";

    const texto = (botao.textContent || "").trim();

    botao.innerHTML = `
        <span class="luka-refresh-icon">↻</span>
        <span class="luka-refresh-text">${texto || "Atualizar"}</span>
    `;

    botao.addEventListener("click", () => {
        botao.classList.add("loading");

        setTimeout(() => {
            botao.classList.remove("loading");
        }, 900);
    });
});
</script>





<script id="luka-filtros-definitivos">
(function(){

    function iniciarFiltros(){

        const configuracao = [
            { id: "total", filtro: "todos" },
            { id: "online", filtro: "online" },
            { id: "testes", filtro: "teste" },
            { id: "revendedores", filtro: "revendedor" }
        ];

        configuracao.forEach(item => {

            const valor = document.getElementById(item.id);

            if (!valor) return;

            /*
             * Procura o bloco visual que contém o número.
             * Não depende de uma classe específica.
             */
            let card = valor.parentElement;

            for(let i = 0; i < 4 && card; i++){

                const texto = (card.textContent || "").toLowerCase();

                if(
                    texto.includes("total") ||
                    texto.includes("online") ||
                    texto.includes("testes") ||
                    texto.includes("revendedores")
                ){
                    break;
                }

                card = card.parentElement;
            }

            if(!card) return;

            card.style.cursor = "pointer";
            card.setAttribute("role","button");
            card.setAttribute("tabindex","0");
            card.dataset.filtroLuka = item.filtro;

            /*
             * Evita registrar o evento duas vezes.
             */
            if(card.dataset.lukaFiltroAtivo === "1") return;

            card.dataset.lukaFiltroAtivo = "1";

            function aplicar(){

                window.filtro = item.filtro;

                /*
                 * Remove destaque dos outros cards.
                 */
                document
                    .querySelectorAll("[data-filtro-luka]")
                    .forEach(c => {
                        c.classList.remove("luka-card-ativo");
                    });

                card.classList.add("luka-card-ativo");

                /*
                 * Usa o render existente do seu painel.
                 */
                if(typeof window.render === "function"){
                    window.render();
                }

                /*
                 * Também tenta renderizar pelo nome global,
                 * caso a função esteja declarada diretamente.
                 */
                try{
                    if(typeof render === "function"){
                        render();
                    }
                }catch(e){}

            }

            card.addEventListener("click", function(e){

                /*
                 * Não interfere em botões internos.
                 */
                if(e.target.closest("button,a,input,select")){
                    return;
                }

                aplicar();

            });

            card.addEventListener("keydown", function(e){

                if(e.key === "Enter" || e.key === " "){
                    e.preventDefault();
                    aplicar();
                }

            });

        });

        /*
         * TOTAL começa selecionado.
         */
        const total = document.querySelector(
            '[data-filtro-luka="todos"]'
        );

        if(total){
            total.classList.add("luka-card-ativo");
        }

    }

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            iniciarFiltros
        );
    }else{
        iniciarFiltros();
    }

})();
</script>


<script id="luka-mini-paineis-js">

(function(){

    function escapar(valor){
        return String(valor ?? "")
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#039;");
    }

    window.lukaAbrirMini = function(tipo){

        const overlay = document.getElementById("lukaMiniOverlay");
        const titulo = document.getElementById("lukaMiniTitulo");
        const contador = document.getElementById("lukaMiniContador");
        const lista = document.getElementById("lukaMiniLista");

        if(!overlay || !lista) return;

        let todos = Array.isArray(window.usuarios)
            ? window.usuarios
            : (typeof usuarios !== "undefined" && Array.isArray(usuarios)
                ? usuarios
                : []);

        let selecionados = [];

        if(tipo === "todos"){
            titulo.textContent = "Todos os usuários";
            selecionados = todos;

        }else if(tipo === "online"){
            titulo.textContent = "Usuários online";
            selecionados = todos.filter(u => !!u.online);

        }else if(tipo === "teste"){
            titulo.textContent = "Testes";
            selecionados = todos.filter(u =>
                String(u.tipo || "").toLowerCase() === "teste"
            );

        }else if(tipo === "revendedor"){
            titulo.textContent = "Revendedores";
            selecionados = todos.filter(u =>
                String(u.tipo || "").toLowerCase() === "revendedor"
            );
        }

        contador.textContent = selecionados.length;

        if(!selecionados.length){

            lista.innerHTML = `
                <div class="luka-mini-vazio">
                    Nenhum acesso encontrado neste grupo.
                </div>
            `;

        }else{

            lista.innerHTML = selecionados.map(u => {

                const nome = escapar(u.usuario || "Sem usuário");

                let tipoTexto =
                    String(u.tipo || "usuario");

                if(tipoTexto === "teste"){
                    tipoTexto = "Teste";
                }else if(tipoTexto === "revendedor"){
                    tipoTexto = "Revendedor";
                }else if(tipoTexto === "admin"){
                    tipoTexto = "Administrador";
                }else{
                    tipoTexto = "Usuário";
                }

                const online = !!u.online;

                return `
                    <div class="luka-mini-item">

                        <div class="luka-mini-esquerda">
                            <div class="luka-mini-nome">
                                ${nome}
                            </div>

                            <div class="luka-mini-tipo">
                                ${escapar(tipoTexto)}
                            </div>
                        </div>

                        <span class="luka-mini-status ${online ? "online" : "offline"}">
                            ${online ? "● ONLINE" : "OFFLINE"}
                        </span>

                    </div>
                `;

            }).join("");

        }

        overlay.classList.add("aberto");
        document.body.style.overflow = "hidden";
    };

    window.lukaFecharMini = function(event){

        if(event && event.target !== event.currentTarget){
            return;
        }

        const overlay =
            document.getElementById("lukaMiniOverlay");

        if(overlay){
            overlay.classList.remove("aberto");
        }

        document.body.style.overflow = "";
    };

    /*
     * Liga os quatro cards aos mini painéis.
     * Usa os IDs reais do seu painel.
     */

    function ligarCards(){

        const mapa = {
            total: "todos",
            online: "online",
            testes: "teste",
            revendedores: "revendedor"
        };

        Object.entries(mapa).forEach(([id,tipo]) => {

            const numero =
                document.getElementById(id);

            if(!numero) return;

            let card = numero.parentElement;

            /*
             * Sobe alguns níveis procurando o bloco visual.
             */
            for(let i = 0; i < 4 && card; i++){

                if(
                    card.children &&
                    card.children.length >= 1
                ){
                    break;
                }

                card = card.parentElement;
            }

            if(!card) return;

            if(card.dataset.lukaMiniLigado === "1"){
                return;
            }

            card.dataset.lukaMiniLigado = "1";
            card.style.cursor = "pointer";

            card.addEventListener("click", function(e){

                if(
                    e.target.closest("button") ||
                    e.target.closest("a") ||
                    e.target.closest("input") ||
                    e.target.closest("select")
                ){
                    return;
                }

                window.lukaAbrirMini(tipo);
            });

        });

    }

    if(document.readyState === "loading"){
        document.addEventListener(
            "DOMContentLoaded",
            ligarCards
        );
    }else{
        ligarCards();
    }

    /*
     * Fecha com ESC.
     */
    document.addEventListener("keydown", function(e){

        if(e.key === "Escape"){
            window.lukaFecharMini();
        }

    });

})();

</script>


<script id="luka-acoes-usuario-js">

(function(){

    let usuarioSelecionado = null;

    function pegarUsuarios(){

        if(
            typeof usuarios !== "undefined" &&
            Array.isArray(usuarios)
        ){
            return usuarios;
        }

        if(
            Array.isArray(window.usuarios)
        ){
            return window.usuarios;
        }

        return [];
    }

    function escapar(v){

        return String(v ?? "")
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#039;");

    }

    function tipoBonito(tipo){

        if(tipo === "revendedor")
            return "Revendedor";

        if(tipo === "teste")
            return "Teste";

        if(tipo === "admin")
            return "Administrador";

        return "Usuário";
    }

    window.lukaAbrirAcoes = function(usuario){

        usuarioSelecionado = usuario;

        const overlay =
            document.getElementById("lukaUsuarioOverlay");

        if(!overlay) return;

        const nome =
            usuario.usuario || "Usuário";

        document.getElementById(
            "lukaUsuarioNome"
        ).textContent = nome;

        document.getElementById(
            "lukaAvatar"
        ).textContent =
            nome.charAt(0).toUpperCase();

        document.getElementById(
            "lukaUsuarioTipo"
        ).textContent =
            tipoBonito(usuario.tipo);

        const status =
            document.getElementById(
                "lukaUsuarioStatus"
            );

        if(usuario.online){

            status.innerHTML =
                '<span class="luka-status-online">● ONLINE</span> • Acesso ativo';

        }else{

            status.innerHTML =
                '<span class="luka-status-offline">● OFFLINE</span> • Sem conexão recente';

        }

        document.getElementById(
            "lukaBotaoSuspender"
        ).textContent =
            usuario.status === "suspenso"
                ? "✅ Ativar"
                : "⛔ Suspender";

        document.getElementById(
            "lukaEditor"
        ).classList.remove("aberto");

        document.getElementById(
            "lukaUsuarioAcoes"
        ).style.display = "grid";

        overlay.classList.add("aberto");

        document.body.style.overflow = "hidden";
    };

    window.lukaFecharAcoes = function(event){

        if(
            event &&
            event.target !== event.currentTarget
        ){
            return;
        }

        const overlay =
            document.getElementById(
                "lukaUsuarioOverlay"
            );

        if(overlay)
            overlay.classList.remove("aberto");

        document.body.style.overflow = "";

        usuarioSelecionado = null;
    };

    window.lukaEditarUsuario = function(){

        if(!usuarioSelecionado) return;

        document.getElementById(
            "lukaEditarNome"
        ).value =
            usuarioSelecionado.usuario || "";

        document.getElementById(
            "lukaEditarSenha"
        ).value = "";

        document.getElementById(
            "lukaUsuarioAcoes"
        ).style.display = "none";

        document.getElementById(
            "lukaEditor"
        ).classList.add("aberto");
    };

    window.lukaCancelarEdicao = function(){

        document.getElementById(
            "lukaEditor"
        ).classList.remove("aberto");

        document.getElementById(
            "lukaUsuarioAcoes"
        ).style.display = "grid";
    };

    window.lukaSalvarEdicao = async function(){

        if(!usuarioSelecionado) return;

        const nome =
            document.getElementById(
                "lukaEditarNome"
            ).value.trim();

        const senha =
            document.getElementById(
                "lukaEditarSenha"
            ).value;

        if(!nome){
            alert("Informe o nome do usuário.");
            return;
        }

        try{

            const resposta = await fetch(
                "/api/admin/usuarios/editar",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    credentials:"same-origin",
                    body:JSON.stringify({
                        id:Number(usuarioSelecionado.id),
                        usuario:nome,
                        senha:senha,
                        tipo:usuarioSelecionado.tipo === "admin"
                            ? "admin"
                            : "usuario"
                    })
                }
            );

            const data =
                await resposta.json();

            if(!resposta.ok || !data.sucesso){

                alert(
                    data.mensagem ||
                    "Não foi possível editar o usuário."
                );

                return;
            }

            alert("✅ Usuário atualizado.");

            lukaFecharAcoes();

            if(typeof render === "function"){
                await render();
            }

        }catch(e){

            alert(
                "Erro ao atualizar o usuário."
            );

        }

    };

    window.lukaSuspenderUsuario = async function(){

        if(!usuarioSelecionado) return;

        const suspenso =
            usuarioSelecionado.status === "suspenso";

        const novoStatus =
            suspenso ? "ativo" : "suspenso";

        const confirmacao = confirm(
            suspenso
                ? "Deseja ativar este usuário?"
                : "Deseja suspender este usuário?"
        );

        if(!confirmacao) return;

        try{

            const resposta = await fetch(
                "/api/admin/usuarios/status",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    credentials:"same-origin",
                    body:JSON.stringify({
                        id:Number(usuarioSelecionado.id),
                        status:novoStatus
                    })
                }
            );

            const data =
                await resposta.json();

            if(!resposta.ok || !data.sucesso){

                alert(
                    data.mensagem ||
                    "Não foi possível alterar o status."
                );

                return;
            }

            alert(
                novoStatus === "ativo"
                    ? "✅ Usuário ativado."
                    : "⛔ Usuário suspenso."
            );

            lukaFecharAcoes();

            if(typeof render === "function"){
                await render();
            }

        }catch(e){

            alert(
                "Erro ao alterar o status."
            );

        }

    };

    window.lukaRenovarUsuario = async function(){

        if(!usuarioSelecionado) return;

        const dias =
            prompt(
                "Quantos dias deseja renovar?",
                "30"
            );

        if(dias === null) return;

        const quantidade =
            Number(dias);

        if(
            !Number.isInteger(quantidade) ||
            quantidade < 1
        ){

            alert(
                "Informe uma quantidade válida de dias."
            );

            return;
        }

        try{

            const resposta = await fetch(
                "/api/admin/usuarios/renovar",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    credentials:"same-origin",
                    body:JSON.stringify({
                        id:Number(usuarioSelecionado.id),
                        dias:quantidade
                    })
                }
            );

            const data =
                await resposta.json();

            if(!resposta.ok || !data.sucesso){

                alert(
                    data.mensagem ||
                    "Não foi possível renovar."
                );

                return;
            }

            alert(
                "🔄 Usuário renovado por " +
                quantidade +
                " dias."
            );

            lukaFecharAcoes();

            if(typeof render === "function"){
                await render();
            }

        }catch(e){

            alert(
                "Erro ao renovar o usuário."
            );

        }

    };

    /*
     * Clique em qualquer linha da lista.
     */
    function ligarLinhas(){

        const lista =
            document.getElementById("lista");

        if(!lista) return;

        if(lista.dataset.lukaAcoesLigadas === "1")
            return;

        lista.dataset.lukaAcoesLigadas = "1";

        lista.addEventListener("click",function(event){

            /*
             * Se clicou em uma ação existente,
             * deixa a ação original funcionar.
             */
            if(
                event.target.closest("button") ||
                event.target.closest("a") ||
                event.target.closest("input") ||
                event.target.closest("select")
            ){
                return;
            }

            const linha =
                event.target.closest("tr");

            if(!linha) return;

            const primeiraCelula =
                linha.querySelector("td");

            if(!primeiraCelula) return;

            const nome =
                primeiraCelula.textContent.trim();

            if(!nome) return;

            const listaUsuarios =
                pegarUsuarios();

            const usuario =
                listaUsuarios.find(
                    u =>
                        String(
                            u.usuario || ""
                        ).trim().toLowerCase()
                        === nome.toLowerCase()
                );

            if(usuario){
                lukaAbrirAcoes(usuario);
            }

        });

    }

    function iniciar(){

        ligarLinhas();

        /*
         * O render recria as linhas, mas o listener
         * fica no tbody, portanto continua funcionando.
         */
    }

    if(document.readyState === "loading"){

        document.addEventListener(
            "DOMContentLoaded",
            iniciar
        );

    }else{

        iniciar();

    }

})();

</script>

</body>
</html>
