<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>LUKA FILMES • Administração</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
 --bg:#070a12;
 --card:#0f1420;
 --card2:#151b29;
 --line:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --green:#a855f7;
 --blue:#7c3aed;
 --purple:#9333ea;
 --red:#e11d48;
 --orange:#c026d3;
}
body{
 font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;
 background:radial-gradient(circle at top,#24102b 0,#0a080d 42%,#050507 100%);
 color:var(--text);
 min-height:100vh;
}
header{
 position:sticky;
 top:0;
 z-index:20;
 background:rgba(7,10,18,.86);
 backdrop-filter:blur(18px);
 border-bottom:1px solid var(--line);
 padding:15px;
}
.top{
 max-width:1250px;
 margin:auto;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
}
.logo{margin-bottom:2px;
 font-size:20px;
 font-weight:900;
 letter-spacing:.5px;
}
.logo span{color:#8b5cf6}
@keyframes lukaPulse{
 0%,100%{
   opacity:1;
   transform:scale(1);
   background:#e11d48;
   box-shadow:0 0 7px #e11d48,0 0 14px rgba(225,29,72,.45);
 }
 50%{
   opacity:.25;
   transform:scale(.85);
   background:#9333ea;
   box-shadow:0 0 5px #9333ea;
 }
}
.sub{font-size:11px;color:var(--muted);margin-top:8px;line-height:16px}
@keyframes pulseDot{
  0%,100%{transform:scale(1);opacity:1;box-shadow:0 0 7px #e11d48}
  50%{transform:scale(1.55);opacity:.55;box-shadow:0 0 20px #e11d48}
}
.logo-btn{
  display:inline-block;
  color:white;
  text-decoration:none;
  cursor:pointer;
  transition:.2s;
}
.logo-btn:hover{
  transform:scale(1.03);
  text-shadow:0 0 18px rgba(168,85,247,.7);
}
.dot{
 width:9px;
 height:9px;
 border-radius:50%;
 display:inline-block;
 margin-right:6px;
 background:#e11d48;
 box-shadow:0 0 8px #e11d48;
 animation:lukaPulse 1.6s ease-in-out infinite;
}
 width:9px;height:9px;border-radius:50%;
 background:#e11d48;
 display:inline-block;
 box-shadow:0 0 12px var(--green);
 margin-right:6px;
}
.container{max-width:1250px;margin:auto;padding:18px 14px 40px}
.grid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
}
.card{
 background:linear-gradient(145deg,rgba(21,27,41,.96),rgba(11,15,25,.96));
 border:1px solid var(--line);
 border-radius:18px;
 padding:17px;
 box-shadow:0 15px 45px rgba(0,0,0,.2);
}
.stat-label{font-size:12px;color:var(--muted)}
.stat-value{font-size:29px;font-weight:900;margin-top:7px}
.stat-green{color:#4ade80}
.stat-blue{color:#60a5fa}
.stat-purple{color:#a78bfa}
.stat-orange{color:#fbbf24}

.actions{
 margin-top:15px;
 display:flex;
 gap:9px;
 flex-wrap:wrap;
}
button{
 border:0;
 border-radius:11px;
 padding:11px 14px;
 color:white;
 font-weight:800;
 cursor:pointer;
 background:linear-gradient(135deg,#7e22ce,#e11d48);
}
button:hover{filter:brightness(1.12)}
.btn-blue{background:var(--blue)}
.btn-green{background:#16a34a}
.btn-red{background:var(--red)}
.btn-dark{background:#202938}
.btn-orange{background:#d97706}

.panel{
 margin-top:15px;
 padding:15px;
 background:rgba(15,20,32,.9);
 border:1px solid var(--line);
 border-radius:18px;
}
.panel-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 margin-bottom:14px;
}
.panel-title h2{font-size:17px}
.search{
 width:100%;
 max-width:380px;
 background:#080c15;
 color:white;
 border:1px solid var(--line);
 border-radius:11px;
 padding:11px 13px;
 outline:none;
}
.filters{
 display:flex;
 gap:7px;
 overflow:auto;
 padding-bottom:4px;
 margin-bottom:13px;
}
.filters button{white-space:nowrap}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th,td{
 padding:13px 10px;
 border-bottom:1px solid var(--line);
 text-align:left;
 font-size:13px;
}
th{color:var(--muted);font-size:11px;text-transform:uppercase}
.badge{
 display:inline-flex;
 padding:5px 8px;
 border-radius:8px;
 font-size:10px;
 font-weight:900;
 background:#263044;
}
.online{color:#d946ef;font-weight:900}
.offline{color:#64748b}
.status-ativo{color:#4ade80}
.status-suspenso{color:#f87171}
.row-actions{display:flex;gap:5px;flex-wrap:wrap}
.row-actions button{padding:7px 9px;font-size:10px}

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.72);
 backdrop-filter:blur(8px);
 display:none;
 align-items:center;
 justify-content:center;
 z-index:100;
 padding:15px;
}
.modal.show{display:flex}
.modal-box{
 width:100%;
 max-width:480px;
 background:#101624;
 border:1px solid var(--line);
 border-radius:20px;
 padding:20px;
 box-shadow:0 30px 90px rgba(0,0,0,.5);
}
.modal-box h2{margin-bottom:15px}
label{
 display:block;
 color:var(--muted);
 font-size:12px;
 font-weight:700;
 margin:11px 0 5px;
}
input,select{
 width:100%;
 padding:12px;
 border-radius:11px;
 border:1px solid var(--line);
 background:#080c15;
 color:white;
 outline:none;
}
.modal-actions{
 display:flex;
 gap:8px;
 margin-top:17px;
}
.modal-actions button{flex:1}
.toast{
 position:fixed;
 right:15px;
 bottom:15px;
 z-index:200;
 background:#101827;
 border:1px solid rgba(139,92,246,.45);
 border-radius:13px;
 padding:13px 15px;
 display:none;
 box-shadow:0 15px 40px rgba(0,0,0,.4);
}
.toast.show{display:block}
.empty{
 text-align:center;
 padding:35px 10px;
 color:var(--muted);
}
@media(max-width:850px){
 .grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
 .grid{grid-template-columns:repeat(2,1fr);gap:8px}
 .card{padding:13px;border-radius:15px}
 .stat-value{font-size:23px}
 .top{align-items:flex-start}
 .actions button{flex:1}
 .panel-title{align-items:stretch;flex-direction:column}
}
</style>










<style id="luka-vermelho-branco">
/* ===== LUKA FILMES — TEMA VERMELHO + BRANCO ===== */

:root{
    --luka-red:#ef1d2f;
    --luka-red-strong:#ff2638;
    --luka-red-dark:#b90f1e;
    --luka-white:#ffffff;
    --luka-white-soft:#f4f4f5;
    --luka-bg:#090909;
}

body{
    background:
        radial-gradient(
            circle at 50% -10%,
            rgba(239,29,47,.18),
            transparent 42%
        ),
        #090909 !important;
    color:var(--luka-white) !important;
}

/* Título da área */

h2,
h3{
    color:#fff !important;
}

section{
    border-color:rgba(239,29,47,.25) !important;
}

/* Gerenciamento */

#lista{
    color:#fff;
}

.table-wrap{
    border:1px solid rgba(239,29,47,.28) !important;
    box-shadow:
        0 10px 35px rgba(0,0,0,.35),
        0 0 25px rgba(239,29,47,.06);
}

/* Cabeçalho da tabela */

table thead th{
    color:#fff !important;
    background:linear-gradient(
        90deg,
        rgba(239,29,47,.20),
        rgba(255,255,255,.035)
    ) !important;
    border-bottom:1px solid rgba(239,29,47,.35) !important;
}

/* Linhas */

table tbody tr{
    transition:
        background .18s ease,
        transform .18s ease;
}

table tbody tr:hover{
    background:rgba(239,29,47,.075) !important;
}

/* Nome do usuário */

table tbody td:first-child{
    color:#fff !important;
    font-weight:800;
}

/* ONLINE */

.online{
    color:#ff3345 !important;
    font-weight:900 !important;
    text-shadow:0 0 10px rgba(255,51,69,.45);
}

/* Botões */

button{
    transition:
        transform .18s ease,
        filter .18s ease,
        box-shadow .18s ease !important;
}

button:hover{
    filter:brightness(1.12);
    transform:translateY(-1px);
}

button:active{
    transform:scale(.97);
}

/* Botão principal */

button:not(.btn-dark):not(.btn-blue):not(.btn-orange):not(.btn-green){
    background:linear-gradient(
        135deg,
        #ff2638,
        #d91024
    ) !important;
    color:#fff !important;
    border:1px solid rgba(255,255,255,.18) !important;
    box-shadow:
        0 6px 20px rgba(239,29,47,.25);
}

/* Filtros */

.filters button{
    border:1px solid rgba(255,255,255,.12) !important;
}

.filters .btn-green,
.filters .btn-orange,
.filters .btn-blue,
.filters .btn-dark{
    color:#fff !important;
}

.filters button:hover{
    border-color:rgba(239,29,47,.65) !important;
}

/* Cards superiores */

.stat-value{
    color:#fff !important;
}

.stat-label{
    color:#d4d4d8 !important;
}

.stat-card{
    border-color:rgba(239,29,47,.22) !important;
}

.stat-card:hover{
    border-color:rgba(239,29,47,.65) !important;
    box-shadow:
        0 12px 35px rgba(239,29,47,.14);
}

.stat-card.luka-card-ativo{
    border-color:#ef1d2f !important;
    box-shadow:
        0 0 0 1px rgba(239,29,47,.25),
        0 12px 35px rgba(239,29,47,.20);
}

.stat-card.luka-card-ativo::after{
    background:linear-gradient(
        90deg,
        #b90f1e,
        #ff2638,
        #ffffff,
        #ff2638,
        #b90f1e
    ) !important;
    box-shadow:
        0 0 12px rgba(239,29,47,.7);
}

/* Mini painéis */

.luka-mini-box{
    border-color:rgba(239,29,47,.48) !important;
    background:
        radial-gradient(
            circle at top right,
            rgba(239,29,47,.18),
            transparent 42%
        ),
        #090909 !important;
}

.luka-mini-ponto{
    background:#ef1d2f !important;
    box-shadow:
        0 0 7px #ef1d2f,
        0 0 16px rgba(239,29,47,.65) !important;
}

.luka-mini-contador{
    color:#ff3345 !important;
}

.luka-mini-item{
    border-color:rgba(255,255,255,.08) !important;
}

.luka-mini-item:hover{
    border-color:rgba(239,29,47,.35) !important;
    background:rgba(239,29,47,.07) !important;
}

/* Modal */

.modal-box{
    border-color:rgba(239,29,47,.38) !important;
    box-shadow:
        0 25px 80px rgba(0,0,0,.75),
        0 0 35px rgba(239,29,47,.12);
}

.modal-box input,
.modal-box select{
    color:#fff !important;
    border-color:rgba(255,255,255,.12) !important;
}

.modal-box input:focus,
.modal-box select:focus{
    border-color:#ef1d2f !important;
    box-shadow:0 0 0 2px rgba(239,29,47,.12) !important;
}

/* Toast */

.toast{
    border-color:rgba(239,29,47,.4) !important;
    color:#fff !important;
}

/* Texto secundário */

label{
    color:#f4f4f5 !important;
}

small,
.muted{
    color:#d4d4d8 !important;
}

/* Barra vermelha decorativa */

.luka-red-line{
    height:3px;
    width:100%;
    border-radius:99px;
    margin:12px 0 20px;
    background:linear-gradient(
        90deg,
        transparent,
        #b90f1e,
        #ff2638,
        #fff,
        #ff2638,
        #b90f1e,
        transparent
    );
    box-shadow:0 0 14px rgba(239,29,47,.45);
}
</style>


<style id="luka-animacao-usuarios">

/* ===== ANIMAÇÃO LEVE DOS USUÁRIOS ===== */

table tbody tr{
    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}

table tbody tr:hover{
    transform:translateX(3px);
    background:rgba(239,29,47,.055) !important;
    box-shadow:
        inset 3px 0 0 #ef1d2f,
        0 4px 18px rgba(239,29,47,.06);
}

table tbody tr:active{
    transform:scale(.995);
}

/* Nome do usuário */

table tbody td:first-child{
    transition:
        color .18s ease,
        text-shadow .18s ease;
}

table tbody tr:hover td:first-child{
    color:#fff !important;
    text-shadow:0 0 10px rgba(239,29,47,.35);
}

/* Bolinha ONLINE pulsando suavemente */

.online{
    display:inline-flex;
    align-items:center;
    gap:5px;
}

.online::first-letter{
    animation:lukaOnlinePulsar 1.5s ease-in-out infinite;
}

@keyframes lukaOnlinePulsar{
    0%,100%{
        opacity:.45;
    }
    50%{
        opacity:1;
    }
}

/* Efeito discreto nos badges */

.badge{
    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

table tbody tr:hover .badge{
    transform:scale(1.04);
    box-shadow:0 0 10px rgba(239,29,47,.12);
}

/* No celular, toque dá um pequeno destaque */

@media (max-width:700px){

    table tbody tr:active{
        transform:translateX(2px) scale(.995);
        background:rgba(239,29,47,.08) !important;
    }

}

</style>


<style id="luka-acoes-usuario-css">

/* =========================================================
   PAINEL DE AÇÕES DO USUÁRIO
   ========================================================= */

.luka-usuario-overlay{
    position:fixed;
    inset:0;
    z-index:100000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:18px;
    background:rgba(0,0,0,.72);
    backdrop-filter:blur(7px);
}

.luka-usuario-overlay.aberto{
    display:flex;
    animation:lukaUsuarioFade .18s ease;
}

@keyframes lukaUsuarioFade{
    from{opacity:0}
    to{opacity:1}
}

.luka-usuario-box{
    width:min(360px,94vw);
    overflow:hidden;
    border:1px solid rgba(239,29,47,.48);
    border-radius:20px;
    background:
        radial-gradient(
            circle at top right,
            rgba(239,29,47,.18),
            transparent 45%
        ),
        #090909;
    box-shadow:
        0 25px 80px rgba(0,0,0,.78),
        0 0 35px rgba(239,29,47,.13);
    transform:translateY(12px) scale(.96);
    animation:lukaUsuarioEntrada .2s ease forwards;
}

@keyframes lukaUsuarioEntrada{
    to{
        transform:translateY(0) scale(1);
    }
}

.luka-usuario-topo{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:17px 18px;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.luka-usuario-identidade{
    display:flex;
    align-items:center;
    gap:11px;
    min-width:0;
}

.luka-avatar{
    width:40px;
    height:40px;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:13px;
    background:linear-gradient(
        135deg,
        #ef1d2f,
        #b90f1e
    );
    color:#fff;
    font-weight:900;
    box-shadow:0 0 18px rgba(239,29,47,.22);
}

.luka-usuario-nome{
    min-width:0;
}

.luka-usuario-nome strong{
    display:block;
    color:#fff;
    font-size:15px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.luka-usuario-tipo{
    margin-top:3px;
    color:#a1a1aa;
    font-size:10px;
    text-transform:uppercase;
}

.luka-usuario-fechar{
    width:32px;
    height:32px;
    flex:none;
    border:0;
    border-radius:10px;
    background:rgba(255,255,255,.07);
    color:#fff;
    font-size:19px;
    cursor:pointer;
}

.luka-usuario-fechar:hover{
    background:rgba(239,29,47,.22);
}

.luka-usuario-status{
    margin:14px 16px 8px;
    padding:9px 11px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:11px;
    background:rgba(255,255,255,.035);
    color:#d4d4d8;
    font-size:11px;
}

.luka-status-online{
    color:#ff3345;
    font-weight:900;
}

.luka-status-offline{
    color:#a1a1aa;
    font-weight:800;
}

.luka-usuario-acoes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
    padding:10px 16px 17px;
}

.luka-acao{
    min-height:48px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:13px;
    background:rgba(255,255,255,.045);
    color:#fff;
    font-weight:800;
    cursor:pointer;
    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease;
}

.luka-acao:hover{
    transform:translateY(-2px);
    border-color:rgba(239,29,47,.48);
    background:rgba(239,29,47,.09);
}

.luka-acao:active{
    transform:scale(.97);
}

.luka-acao.editar{
    border-color:rgba(255,255,255,.16);
}

.luka-acao.suspender{
    color:#ff6673;
}

.luka-acao.renovar{
    color:#fff;
    background:linear-gradient(
        135deg,
        rgba(239,29,47,.9),
        rgba(185,15,30,.9)
    );
    border-color:rgba(255,255,255,.14);
}

.luka-acao.fechar{
    grid-column:1 / -1;
    min-height:42px;
    color:#a1a1aa;
}

/* Editor */

.luka-editor{
    display:none;
    padding:0 16px 17px;
}

.luka-editor.aberto{
    display:block;
}

.luka-editor label{
    display:block;
    margin:9px 0 5px;
    color:#d4d4d8;
    font-size:11px;
    font-weight:700;
}

.luka-editor input{
    width:100%;
    box-sizing:border-box;
    padding:11px 12px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:10px;
    background:#111;
    color:#fff;
    outline:none;
}

.luka-editor input:focus{
    border-color:#ef1d2f;
    box-shadow:0 0 0 2px rgba(239,29,47,.10);
}

.luka-editor-botoes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:12px;
}

.luka-editor-botoes button{
    min-height:42px;
    border:0;
    border-radius:10px;
    cursor:pointer;
    font-weight:800;
}

.luka-editor-cancelar{
    background:#1a1a1a;
    color:#aaa;
}

.luka-editor-salvar{
    background:#ef1d2f;
    color:#fff;
}

</style>








