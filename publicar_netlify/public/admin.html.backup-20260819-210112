}

.btn-red,
button[type="submit"]{
  background:linear-gradient(
    135deg,
    var(--red),
    #c91832
  )!important;
}

.btn-blue{
  background:linear-gradient(
    135deg,
    #ef233c,
    #d71936
  )!important;
}

.btn-orange{
  background:linear-gradient(
